<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Dashboard Arsip | Axa System</title>

    <link rel="icon" type="image/png" href="/axalogo.png">
    <link rel="apple-touch-icon" href="/axalogo.png">

    <script src="https://cdn.tailwindcss.com"></script>
    <script src="https://unpkg.com/@phosphor-icons/web"></script>
    <script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>
    <link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;700;900&display=swap" rel="stylesheet">
    <style>
        body { font-family: 'Space Grotesk', sans-serif; background-color: #030712; color: #fff; }
        .glass-panel { background: rgba(15, 23, 42, 0.4); backdrop-filter: blur(24px); border: 1px solid rgba(0, 229, 255, 0.2); box-shadow: inset 0 0 20px rgba(0, 229, 255, 0.05); }
        .brutal-card { background: #0b0f19; border: 2px solid #00E5FF; box-shadow: 6px 6px 0px rgba(0, 229, 255, 0.8); transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1); }
        .brutal-card:hover { transform: translate(-3px, -3px); box-shadow: 9px 9px 0px #FF10F0; border-color: #FF10F0; }
        .dropzone { border: 2px dashed #00E5FF; transition: all 0.3s ease; background: rgba(0, 229, 255, 0.05); }
        .dropzone.dragover { background: rgba(0, 229, 255, 0.2); border-color: #FF10F0; transform: scale(1.02); }
        .dropzone.has-file { border: 2px solid #00E5FF; background: rgba(16, 185, 129, 0.1); }
        .custom-scrollbar::-webkit-scrollbar { width: 6px; }
        .custom-scrollbar::-webkit-scrollbar-track { background: #030712; }
        .custom-scrollbar::-webkit-scrollbar-thumb { background: #00E5FF; border-radius: 10px; }

        /* Animasi Modal Edit */
        .modal-enter { animation: modalFadeIn 0.3s cubic-bezier(0.4, 0, 0.2, 1) forwards; }
        @keyframes modalFadeIn { from { opacity: 0; transform: scale(0.95) translateY(10px); } to { opacity: 1; transform: scale(1) translateY(0); } }
        
        /* Modifikasi Input Datalist Arrow */
        input::-webkit-calendar-picker-indicator { cursor: pointer; opacity: 0.6; transition: 0.2s; }
        input::-webkit-calendar-picker-indicator:hover { opacity: 1; }
    </style>
</head>
<body class="p-4 md:p-10 relative custom-scrollbar h-screen overflow-y-auto">

    <nav class="glass-panel rounded-2xl p-4 md:p-6 mb-8 flex flex-col md:flex-row justify-between items-center gap-4 z-10 relative">
        <div class="flex items-center gap-3">
            <i class="ph-fill ph-database text-4xl text-transparent bg-clip-text bg-gradient-to-r from-cyan-400 to-pink-500"></i>
            <div>
                <h1 class="text-xl md:text-2xl font-black tracking-tight uppercase">Knowledge Base <span class="text-cyan-400">Core</span></h1>
                <p class="text-[10px] text-gray-400 font-mono tracking-widest">Master Storage Manager (Full CRUD)</p>
            </div>
        </div>
        <div class="flex gap-3 w-full md:w-auto">
            <a href="/arsip" target="_blank" class="flex-1 md:flex-none text-center px-5 py-2.5 border-2 border-cyan-400 text-cyan-400 hover:bg-cyan-400 hover:text-black rounded-xl text-sm font-bold transition-all shadow-[0_0_15px_rgba(0,229,255,0.3)]"><i class="ph-bold ph-eye"></i> View Live</a>
            <button onclick="logout()" class="flex-1 md:flex-none text-center px-5 py-2.5 bg-red-500/10 border-2 border-red-500 text-red-500 hover:bg-red-500 hover:text-white rounded-xl text-sm font-bold transition-all"><i class="ph-bold ph-power"></i> Logout</button>
        </div>
    </nav>

    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 relative z-10">
        <!-- Form Add (Kiri) -->
        <div class="lg:col-span-4 glass-panel p-6 md:p-8 rounded-2xl h-fit border-t-4 border-t-cyan-400">
            <h2 class="text-xl font-black mb-6 flex items-center gap-2 text-cyan-400 uppercase tracking-wide"><i class="ph-bold ph-cloud-arrow-up text-2xl"></i> Ingest Materi Baru</h2>
            <form id="formArsip" class="space-y-5">

                <div>
                    <label class="text-[10px] text-gray-400 font-mono mb-2 block uppercase font-bold tracking-widest">Upload File PDF (Maks Bebas)</label>
                    <div id="dropzoneContainer" class="dropzone rounded-xl p-6 text-center cursor-pointer flex flex-col items-center justify-center relative overflow-hidden h-32 group" onclick="document.getElementById('fileInput').click()">
                        <input type="file" id="fileInput" accept=".pdf" class="hidden">
                        <i id="dropIcon" class="ph-bold ph-file-pdf text-4xl text-cyan-400 mb-2 group-hover:scale-110 transition-transform"></i>
                        <p id="dropText" class="text-xs font-bold text-gray-300">Drag & Drop PDF di sini<br><span class="text-[10px] text-green-400 font-mono font-normal">Mendukung file besar langsung via Storage</span></p>
                    </div>
                </div>

                <div>
                    <label class="text-[10px] text-gray-400 font-mono mb-1 block uppercase font-bold tracking-widest">Judul Dokumen</label>
                    <input type="text" id="title" required class="w-full bg-[#0b0f19] border-2 border-gray-800 rounded-xl px-4 py-3 focus:outline-none focus:border-cyan-400 text-sm font-bold shadow-inner transition-colors placeholder-gray-600" placeholder="Contoh: Laporan Kasus Fissure Tongue...">
                </div>

                <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                    <!-- KATEGORI DEPT/BAGIAN: INPUT + DROPDOWN (DATALIST) -->
                    <div>
                        <label class="text-[10px] text-gray-400 font-mono mb-1 block uppercase font-bold tracking-widest">Kategori Dept/Bagian</label>
                        <input list="categoryList" id="category" required class="w-full bg-[#0b0f19] border-2 border-gray-800 rounded-xl px-4 py-3 focus:outline-none focus:border-cyan-400 text-sm font-bold shadow-inner transition-colors placeholder-gray-600" placeholder="Ketik atau pilih...">
                        <!-- Datalist ini akan diisi secara dinamis oleh JavaScript -->
                        <datalist id="categoryList">
                            <option value="Preklinik">
                            <option value="Profesi Dokter Muda">
                            <option value="Jurnal & Riset">
                            <option value="Kedokteran Gigi Umum">
                        </datalist>
                    </div>
                    <div>
                        <label class="text-[10px] text-gray-400 font-mono mb-1 block uppercase font-bold tracking-widest">Hak Akses URL</label>
                        <select id="accessType" class="w-full bg-[#0b0f19] border-2 border-gray-800 rounded-xl px-4 py-3 focus:outline-none focus:border-cyan-400 text-sm font-bold shadow-inner cursor-pointer text-cyan-400 h-[48px]">
                            <option value="Restricted" selected>Restricted (Blur)</option>
                            <option value="Open Access">Open Access (Free)</option>
                        </select>
                    </div>
                </div>

                <div>
                    <label class="text-[10px] text-gray-400 font-mono mb-1 block uppercase font-bold tracking-widest">Deskripsi / Abstrak Singkat</label>
                    <textarea id="desc" rows="4" required class="w-full bg-[#0b0f19] border-2 border-gray-800 rounded-xl px-4 py-3 focus:outline-none focus:border-cyan-400 text-sm resize-none shadow-inner" placeholder="Tuliskan rangkuman atau abstrak materi..."></textarea>
                </div>

                <button type="submit" id="btnSubmit" class="w-full bg-gradient-to-r from-cyan-500 to-blue-500 text-black font-black py-4 rounded-xl hover:brightness-110 shadow-[0_10px_20px_rgba(0,229,255,0.3)] transition-all uppercase tracking-widest flex items-center justify-center gap-2 active:scale-95">
                    <i class="ph-bold ph-database"></i> Push to Storage
                </button>
            </form>
        </div>

        <!-- List Data (Kanan) -->
        <div class="lg:col-span-8 flex flex-col h-[80vh]">
            <div class="flex items-center justify-between mb-4">
                <div class="flex items-center gap-2">
                    <div class="h-2 w-2 rounded-full bg-green-400 animate-pulse"></div>
                    <h3 class="text-sm font-mono text-gray-400 uppercase tracking-widest">System Live Records</h3>
                </div>
                <button onclick="fetchArsip()" class="text-cyan-400 hover:text-white text-sm flex items-center gap-1 font-mono"><i class="ph-bold ph-arrows-clockwise"></i> Refresh</button>
            </div>
            <div class="flex-grow overflow-y-auto pr-2 custom-scrollbar space-y-4" id="arsipList">
                <div class="glass-panel p-10 text-center rounded-2xl flex flex-col items-center justify-center h-full">
                    <i class="ph-bold ph-spinner-gap animate-spin text-5xl text-cyan-400 mb-4 drop-shadow-[0_0_15px_rgba(0,229,255,0.8)]"></i>
                    <p class="text-gray-400 font-mono uppercase tracking-widest">Querying Database...</p>
                </div>
            </div>
        </div>
    </div>

    <!-- MODAL EDIT DATA (FULL CRUD) -->
    <div id="editModal" class="fixed inset-0 z-50 hidden bg-[#030712]/90 backdrop-blur-md flex items-center justify-center p-4 overflow-y-auto">
        <div class="glass-panel w-full max-w-2xl p-6 md:p-8 rounded-3xl border-t-4 border-t-pink-500 modal-enter shadow-[0_0_50px_rgba(255,16,240,0.15)] relative my-8">
            <button onclick="tutupEdit()" class="absolute top-5 right-5 text-gray-400 hover:text-white"><i class="ph-bold ph-x text-2xl"></i></button>

            <h2 class="text-2xl font-black mb-6 flex items-center gap-2 text-pink-500 uppercase tracking-wide"><i class="ph-bold ph-pencil-simple"></i> Edit Metadata Arsip</h2>

            <form id="formEdit" class="space-y-4">
                <input type="hidden" id="editId">

                <div>
                    <label class="text-[10px] text-gray-400 font-mono mb-1 block uppercase font-bold tracking-widest">Judul Dokumen</label>
                    <input type="text" id="editTitle" required class="w-full bg-[#0b0f19] border-2 border-gray-800 rounded-xl px-4 py-3 focus:outline-none focus:border-pink-500 text-sm font-bold shadow-inner transition-colors">
                </div>

                <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                    <!-- KATEGORI DEPT/BAGIAN: INPUT + DROPDOWN (DATALIST) -->
                    <div>
                        <label class="text-[10px] text-gray-400 font-mono mb-1 block uppercase font-bold tracking-widest">Kategori Dept/Bagian</label>
                        <input list="categoryList" id="editCategory" required class="w-full bg-[#0b0f19] border-2 border-gray-800 rounded-xl px-4 py-3 focus:outline-none focus:border-pink-500 text-sm font-bold shadow-inner transition-colors placeholder-gray-600" placeholder="Ketik atau pilih...">
                    </div>
                    <div>
                        <label class="text-[10px] text-gray-400 font-mono mb-1 block uppercase font-bold tracking-widest">Hak Akses URL</label>
                        <select id="editAccessType" class="w-full bg-[#0b0f19] border-2 border-gray-800 rounded-xl px-4 py-3 focus:outline-none focus:border-pink-500 text-sm font-bold text-pink-400 h-[48px]">
                            <option value="Restricted">Restricted (Blur)</option>
                            <option value="Open Access">Open Access (Free)</option>
                        </select>
                    </div>
                </div>

                <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                    <div>
                        <label class="text-[10px] text-gray-400 font-mono mb-1 block uppercase font-bold tracking-widest">URL Slug (Custom Link SEO)</label>
                        <input type="text" id="editSlug" required class="w-full bg-[#0b0f19] border-2 border-gray-800 rounded-xl px-4 py-3 focus:outline-none focus:border-pink-500 text-sm font-bold font-mono text-cyan-200">
                        <p class="text-[9px] text-gray-500 mt-1 font-mono">Format: huruf-kecil-dan-tanda-hubung-saja</p>
                    </div>
                    <div>
                        <label class="text-[10px] text-gray-400 font-mono mb-1 block uppercase font-bold tracking-widest">Tanggal Upload (Format DD-MM-YYYY)</label>
                        <input type="text" id="editDate" required placeholder="Contoh: 17-08-2026" class="w-full bg-[#0b0f19] border-2 border-gray-800 rounded-xl px-4 py-3 focus:outline-none focus:border-pink-500 text-sm font-bold font-mono text-green-300 h-[48px]">
                    </div>
                </div>

                <div>
                    <label class="text-[10px] text-gray-400 font-mono mb-1 block uppercase font-bold tracking-widest">Deskripsi / Abstrak Singkat</label>
                    <textarea id="editDesc" rows="4" required class="w-full bg-[#0b0f19] border-2 border-gray-800 rounded-xl px-4 py-3 focus:outline-none focus:border-pink-500 text-sm resize-none shadow-inner"></textarea>
                </div>

                <button type="submit" id="btnEditSubmit" class="w-full bg-gradient-to-r from-pink-500 to-purple-500 text-white font-black py-4 rounded-xl hover:brightness-110 shadow-[0_10px_20px_rgba(255,16,240,0.3)] transition-all uppercase tracking-widest mt-2 active:scale-95">
                    Simpan Perubahan
                </button>
            </form>
        </div>
    </div>

    <script>
        const token = localStorage.getItem('axa_arsip_token');
        if (!token) { try { window.location.href = '/admin/login'; } catch (e) {} }

        // Menerima nilai yang disuntikkan oleh server.js Vercel Backend
        const SUPABASE_URL = "<%= typeof supabaseUrl !== 'undefined' ? supabaseUrl : '' %>"; 
        const SUPABASE_ANON_KEY = "<%= typeof supabaseAnonKey !== 'undefined' ? supabaseAnonKey : '' %>"; 

        let supabaseClient = null;
        let globalArsipData = []; // Simpan data untuk Modal Edit

        if (SUPABASE_URL && SUPABASE_URL.startsWith('http') && SUPABASE_ANON_KEY) {
            try {
                supabaseClient = window.supabase.createClient(SUPABASE_URL, SUPABASE_ANON_KEY);
            } catch (e) {
                console.warn("Peringatan: Gagal Inisiasi Supabase SDK.");
            }
        }

        let selectedFile = null;

        // DRAG AND DROP HANDLER
        const dropzone = document.getElementById('dropzoneContainer');
        const fileInput = document.getElementById('fileInput');
        const dropText = document.getElementById('dropText');
        const dropIcon = document.getElementById('dropIcon');

        ['dragenter', 'dragover', 'dragleave', 'drop'].forEach(eventName => {
            dropzone.addEventListener(eventName, e => { e.preventDefault(); e.stopPropagation(); }, false);
        });
        dropzone.addEventListener('dragover', () => dropzone.classList.add('dragover'));
        dropzone.addEventListener('dragleave', () => dropzone.classList.remove('dragover'));
        dropzone.addEventListener('drop', e => { dropzone.classList.remove('dragover'); handleFiles(e.dataTransfer.files); });
        fileInput.addEventListener('change', e => { handleFiles(e.target.files); });

        function handleFiles(files) {
            if (files.length === 0) return;
            const file = files[0];
            if (file.type !== "application/pdf") return alert("Hanya file PDF yang diizinkan!");

            selectedFile = file;
            dropText.innerHTML = `<span class="text-green-400 font-black">${file.name}</span><br><span class="text-gray-400">${(file.size/1024/1024).toFixed(2)} MB Ready (Unlimited Storage)</span>`;
            dropIcon.className = "ph-fill ph-check-circle text-4xl text-green-400 mb-2";
            dropzone.classList.add('has-file');
        }

        // ==========================================
        // 1. READ & POPULATE: Ambil Data Supabase & Update Kategori
        // ==========================================
        async function fetchArsip() {
            const listEl = document.getElementById('arsipList');
            try {
                const res = await fetch('/api/arsip', { headers: { 'Authorization': token } });
                if (!res.ok) {
                    const errRes = await res.json();
                    throw new Error(errRes.message || "Gagal mengambil data dari server.");
                }

                const { data } = await res.json();
                globalArsipData = data; 

                // UPDATE KATEGORI DATALIST SECARA DINAMIS
                populateCategoryDatalist(data);

                if(data.length === 0) { 
                    listEl.innerHTML = '<div class="glass-panel p-8 text-center rounded-2xl text-gray-400 font-mono">Database kosong.</div>'; 
                    return; 
                }

                // Helper format date untuk tampilan list di admin dashboard
                const formatDateStr = (dateStr) => {
                    if(dateStr && dateStr.match(/^\d{4}-\d{2}-\d{2}$/)) {
                        const parts = dateStr.split('-'); return `${parts[2]}-${parts[1]}-${parts[0]}`;
                    }
                    return dateStr;
                };

                listEl.innerHTML = data.map(item => {
                    const displayDate = formatDateStr(item.date);
                    const accessColor = item.access_type === 'Open Access' ? 'text-green-400 border-green-400/30 bg-green-500/10' : 'text-red-400 border-red-400/30 bg-red-500/10';
                    return `
                    <div class="brutal-card rounded-2xl p-5 flex flex-col md:flex-row justify-between items-start md:items-center gap-4 relative overflow-hidden group">
                        <div class="absolute right-0 top-0 h-full w-32 bg-gradient-to-l from-cyan-500/10 to-transparent pointer-events-none"></div>
                        <div class="min-w-0 w-full z-10">
                            <div class="flex gap-2 mb-2 flex-wrap">
                                <span class="text-[9px] bg-cyan-500/20 border border-cyan-400/30 text-cyan-400 px-2.5 py-1 rounded font-mono uppercase tracking-widest font-bold">${item.category}</span>
                                <span class="text-[9px] ${accessColor} border px-2.5 py-1 rounded font-mono uppercase tracking-widest font-bold">${item.access_type || 'Restricted'}</span>
                            </div>
                            <h3 class="text-lg md:text-xl font-black mt-2.5 break-words w-full drop-shadow-sm text-white leading-tight">${item.title}</h3>
                            <p class="text-gray-400 text-[10px] md:text-xs break-words font-mono mt-1.5 w-full flex flex-wrap gap-2 items-center">
                                <span><i class="ph-bold ph-link text-cyan-400"></i> /${item.slug}</span> 
                                <span class="hidden sm:inline">|</span> 
                                <span><i class="ph-bold ph-calendar text-pink-400"></i> ${displayDate}</span>
                            </p>
                        </div>
                        <div class="flex gap-2 z-10 shrink-0 w-full md:w-auto mt-2 md:mt-0">
                            <button onclick="bukaEdit('${item.id}')" class="flex-1 md:flex-none text-center bg-gray-800 text-white p-3 rounded-xl hover:bg-pink-500 hover:text-white transition-colors border border-gray-700 hover:border-pink-500" title="Edit Metadata Terlengkap"><i class="ph-bold ph-pencil-simple text-lg"></i></button>
                            <a href="/arsip/${item.slug}" target="_blank" class="flex-1 md:flex-none text-center bg-gray-800 text-white p-3 rounded-xl hover:bg-cyan-500 hover:text-black transition-colors border border-gray-700 hover:border-cyan-400" title="View Article Page"><i class="ph-bold ph-arrow-square-out text-lg"></i></a>
                            <button onclick="hapus('${item.id}')" class="flex-1 md:flex-none text-center bg-red-500/10 text-red-500 p-3 rounded-xl hover:bg-red-500 hover:text-white transition-colors shadow-[0_0_10px_rgba(239,68,68,0.2)] border border-red-500/30 hover:border-red-500" title="Hapus Permanen"><i class="ph-bold ph-trash text-lg"></i></button>
                        </div>
                    </div>
                `}).join('');
            } catch (error) {
                listEl.innerHTML = `<div class="glass-panel p-8 text-center rounded-2xl text-red-400 font-mono border-red-500/50"><i class="ph-fill ph-warning-circle text-4xl mb-3"></i><br>${error.message}</div>`;
            }
        }

        // FUNGSI HELPER: Populate Datalist Kategori
        function populateCategoryDatalist(data) {
            const defaultCats = ["Preklinik", "Profesi Dokter Muda", "Jurnal & Riset", "Kedokteran Gigi Umum", "Kegiatan Sosial", "Event"];
            const dbCats = data.map(item => item.category).filter(Boolean);
            
            // Gabungkan default dengan yang ada di database, lalu hilangkan duplikat
            const uniqueCategories = [...new Set([...defaultCats, ...dbCats])];
            
            const datalistHTML = uniqueCategories.map(cat => `<option value="${cat}">`).join('');
            document.getElementById('categoryList').innerHTML = datalistHTML;
        }

        // ==========================================
        // 2. CREATE: Direct Upload Storage + Insert Postgres
        // ==========================================
        document.getElementById('formArsip').addEventListener('submit', async (e) => {
            e.preventDefault();
            if(!selectedFile) return alert("Harap pilih file PDF terlebih dahulu!");

            const btn = document.getElementById('btnSubmit');
            const ogText = btn.innerHTML;

            if (!supabaseClient) {
                alert("SISTEM TERKUNCI: Environment Variables (SUPABASE_URL & ANON_KEY) tidak ditemukan dari backend Vercel. Pastikan Vercel Anda sudah dikonfigurasi.");
                return;
            }

            btn.innerHTML = '<i class="ph-bold ph-spinner-gap animate-spin text-xl"></i> UPLOADING DIRECT TO STORAGE...';
            btn.disabled = true;

            try {
                const uniqueId = Date.now().toString();
                const cleanFileName = selectedFile.name.replace(/[^a-zA-Z0-9.-]/g, '_');
                const filePath = `${uniqueId}_${cleanFileName}`;

                // Upload langsung dari browser ke Supabase Storage (Unlimited Limit Vercel)
                const { error: storageError } = await supabaseClient.storage
                    .from('arsip_files')
                    .upload(filePath, selectedFile, { cacheControl: '3600', upsert: false });

                if (storageError) throw new Error("Upload Storage Gagal (Cek Kebijakan RLS Storage Anda): " + storageError.message);

                // Kirim metadata ke Backend API Vercel
                const payload = {
                    id: uniqueId,
                    title: document.getElementById('title').value,
                    category: document.getElementById('category').value, // Ambil input bebas/dropdown
                    desc: document.getElementById('desc').value,
                    accessType: document.getElementById('accessType').value,
                    fileName: selectedFile.name,
                    filePath: filePath
                };

                const res = await fetch('/api/arsip', { 
                    method: 'POST', 
                    headers: { 'Content-Type': 'application/json', 'Authorization': token }, 
                    body: JSON.stringify(payload) 
                });

                if (!res.ok) {
                    const errRes = await res.json();
                    throw new Error("Database Gagal: " + errRes.message);
                }

                document.getElementById('formArsip').reset();
                selectedFile = null;
                dropzone.classList.remove('has-file');
                dropIcon.className = "ph-fill ph-file-pdf text-4xl text-cyan-400 mb-2 group-hover:scale-110 transition-transform";
                dropText.innerHTML = `Drag & Drop PDF di sini<br><span class="text-[10px] text-green-400 font-mono font-normal">Mendukung file besar langsung via Storage</span>`;
                fetchArsip(); 
            } catch (err) { 
                alert(err.message); 
            } finally { 
                btn.innerHTML = ogText; 
                btn.disabled = false; 
            }
        });

        // ==========================================
        // 3. UPDATE: Edit Metadata Lengkap (CRUD)
        // ==========================================
        function bukaEdit(id) {
            const item = globalArsipData.find(x => x.id === id);
            if(!item) return;

            document.getElementById('editId').value = item.id;
            document.getElementById('editTitle').value = item.title;
            document.getElementById('editCategory').value = item.category;
            document.getElementById('editDesc').value = item.desc;
            document.getElementById('editAccessType').value = item.access_type || 'Restricted';

            // Tambahan Fitur Lengkap Sesuai Permintaan
            document.getElementById('editSlug').value = item.slug;

            // Pastikan format date di modal edit sudah format DD-MM-YYYY
            let editDisplayDate = item.date;
            if(editDisplayDate && editDisplayDate.match(/^\d{4}-\d{2}-\d{2}$/)) {
                const parts = editDisplayDate.split('-'); editDisplayDate = `${parts[2]}-${parts[1]}-${parts[0]}`;
            }
            document.getElementById('editDate').value = editDisplayDate;

            document.getElementById('editModal').classList.remove('hidden');
        }

        function tutupEdit() {
            document.getElementById('editModal').classList.add('hidden');
            document.getElementById('formEdit').reset();
        }

        document.getElementById('formEdit').addEventListener('submit', async (e) => {
            e.preventDefault();
            const btn = document.getElementById('btnEditSubmit');
            const ogText = btn.innerHTML;
            btn.innerHTML = '<i class="ph-bold ph-spinner-gap animate-spin text-xl"></i> MENYIMPAN...';
            btn.disabled = true;

            const docId = document.getElementById('editId').value;

            // Memaksa format Slug hanya lowercase dan tanda hubung
            let safeSlug = document.getElementById('editSlug').value.trim().toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/(^-|-$)+/g, '');

            const payload = {
                title: document.getElementById('editTitle').value,
                category: document.getElementById('editCategory').value,
                desc: document.getElementById('editDesc').value,
                accessType: document.getElementById('editAccessType').value,
                slug: safeSlug,
                date: document.getElementById('editDate').value.trim()
            };

            try {
                const res = await fetch(`/api/arsip/${docId}`, {
                    method: 'PUT',
                    headers: { 'Content-Type': 'application/json', 'Authorization': token },
                    body: JSON.stringify(payload)
                });

                if(!res.ok) {
                    const errData = await res.json();
                    throw new Error(errData.message || "Gagal mengupdate data.");
                }

                tutupEdit();
                fetchArsip(); 
            } catch (err) {
                alert(err.message);
            } finally {
                btn.innerHTML = ogText;
                btn.disabled = false;
            }
        });

        // ==========================================
        // 4. DELETE: Hapus Data Permanen
        // ==========================================
        async function hapus(id) {
            if(!confirm('Hapus permanen dokumen & file PDF ini dari Storage dan Database?')) return;
            try {
                const res = await fetch('/api/arsip/'+id, { method: 'DELETE', headers: { 'Authorization': token } });
                if(!res.ok) {
                    const errRes = await res.json();
                    throw new Error(errRes.message);
                }
                fetchArsip(); 
            } catch (e) { alert(e.message); }
        }

        function logout() {
            localStorage.removeItem('axa_arsip_token');
            window.location.href = '/admin/login';
        }

        fetchArsip();
    </script>
</body>
</html>
