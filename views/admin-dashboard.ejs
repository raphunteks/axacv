<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Dashboard Arsip | Axa System</title>

    <link rel="icon" type="image/png" href="/axalogo.png">
    <link rel="apple-touch-icon" href="/axalogo.png">

    <script src="https://cdn.tailwindcss.com"></script>
    <script src="https://unpkg.com/@phosphor-icons/web"></script>
    <script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>
    <link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;700;900&display=swap" rel="stylesheet">
    <style>
        body { font-family: 'Space Grotesk', sans-serif; background-color: #030712; color: #fff; }
        .glass-panel { background: rgba(15, 23, 42, 0.4); backdrop-filter: blur(24px); border: 1px solid rgba(0, 229, 255, 0.2); box-shadow: inset 0 0 20px rgba(0, 229, 255, 0.05); }
        .brutal-card { background: #0b0f19; border: 2px solid #00E5FF; box-shadow: 6px 6px 0px rgba(0, 229, 255, 0.8); transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1); }
        .brutal-card:hover { transform: translate(-3px, -3px); box-shadow: 9px 9px 0px #FF10F0; border-color: #FF10F0; }
        .dropzone { border: 2px dashed #00E5FF; transition: all 0.3s ease; background: rgba(0, 229, 255, 0.05); }
        .dropzone.dragover { background: rgba(0, 229, 255, 0.2); border-color: #FF10F0; transform: scale(1.02); }
        .dropzone.has-file { border: 2px solid #00E5FF; background: rgba(16, 185, 129, 0.1); }
        .custom-scrollbar::-webkit-scrollbar { width: 6px; height: 6px; }
        .custom-scrollbar::-webkit-scrollbar-track { background: #030712; }
        .custom-scrollbar::-webkit-scrollbar-thumb { background: #00E5FF; border-radius: 10px; }

        /* Animasi Modal Edit */
        .modal-enter { animation: modalFadeIn 0.3s cubic-bezier(0.4, 0, 0.2, 1) forwards; }
        @keyframes modalFadeIn { from { opacity: 0; transform: scale(0.95) translateY(10px); } to { opacity: 1; transform: scale(1) translateY(0); } }
        
        /* Modifikasi Input Datalist Arrow */
        input::-webkit-calendar-picker-indicator { cursor: pointer; opacity: 0.6; transition: 0.2s; }
        input::-webkit-calendar-picker-indicator:hover { opacity: 1; }
    </style>
</head>
<body class="p-4 md:p-10 relative custom-scrollbar h-screen overflow-y-auto">

    <nav class="glass-panel rounded-2xl p-4 md:p-6 mb-6 flex flex-col md:flex-row justify-between items-center gap-4 z-10 relative">
        <div class="flex items-center gap-3">
            <i class="ph-fill ph-database text-4xl text-transparent bg-clip-text bg-gradient-to-r from-cyan-400 to-pink-500"></i>
            <div>
                <h1 class="text-xl md:text-2xl font-black tracking-tight uppercase">Knowledge Base <span class="text-cyan-400">Core</span></h1>
                <p class="text-[10px] text-gray-400 font-mono tracking-widest">Master Storage Manager (Full CRUD)</p>
            </div>
        </div>
        <div class="flex gap-3 w-full md:w-auto">
            <a href="/arsip" target="_blank" class="flex-1 md:flex-none text-center px-5 py-2.5 border-2 border-cyan-400 text-cyan-400 hover:bg-cyan-400 hover:text-black rounded-xl text-sm font-bold transition-all shadow-[0_0_15px_rgba(0,229,255,0.3)]"><i class="ph-bold ph-eye"></i> View Live</a>
            <button onclick="logout()" class="flex-1 md:flex-none text-center px-5 py-2.5 bg-red-500/10 border-2 border-red-500 text-red-500 hover:bg-red-500 hover:text-white rounded-xl text-sm font-bold transition-all active:scale-95"><i class="ph-bold ph-power"></i> Logout</button>
        </div>
    </nav>

    <!-- TABS NAVIGASI UTAMA -->
    <div class="flex gap-2 md:gap-6 border-b border-gray-800 mb-8 overflow-x-auto custom-scrollbar z-10 relative">
        <button onclick="switchTab('arsip')" id="tab-arsip" class="tab-btn px-4 py-3 border-b-2 border-cyan-400 text-cyan-400 font-bold whitespace-nowrap transition-colors uppercase tracking-widest text-xs md:text-sm">Manajemen Arsip</button>
        <button onclick="switchTab('form')" id="tab-form" class="tab-btn px-4 py-3 border-b-2 border-transparent text-gray-500 hover:text-gray-300 font-bold whitespace-nowrap transition-colors uppercase tracking-widest text-xs md:text-sm">Manajemen Form Download</button>
        <button onclick="switchTab('users')" id="tab-users" class="tab-btn px-4 py-3 border-b-2 border-transparent text-gray-500 hover:text-gray-300 font-bold whitespace-nowrap transition-colors uppercase tracking-widest text-xs md:text-sm">List Nama Download</button>
    </div>

    <!-- VIEW 1: MANAJEMEN ARSIP -->
    <div id="view-arsip" class="grid grid-cols-1 lg:grid-cols-12 gap-8 relative z-10">
        <!-- Form Add (Kiri) -->
        <div class="lg:col-span-4 glass-panel p-6 md:p-8 rounded-2xl h-fit border-t-4 border-t-cyan-400">
            <h2 class="text-xl font-black mb-6 flex items-center gap-2 text-cyan-400 uppercase tracking-wide"><i class="ph-bold ph-cloud-arrow-up text-2xl"></i> Ingest Materi Baru</h2>
            <form id="formArsip" class="space-y-5">

                <div>
                    <label class="text-[10px] text-gray-400 font-mono mb-2 block uppercase font-bold tracking-widest">Upload File PDF (Maks Bebas)</label>
                    <div id="dropzoneContainer" class="dropzone rounded-xl p-6 text-center cursor-pointer flex flex-col items-center justify-center relative overflow-hidden h-32 group" onclick="document.getElementById('fileInput').click()">
                        <input type="file" id="fileInput" accept=".pdf" class="hidden">
                        <i id="dropIcon" class="ph-bold ph-file-pdf text-4xl text-cyan-400 mb-2 group-hover:scale-110 transition-transform"></i>
                        <p id="dropText" class="text-xs font-bold text-gray-300">Drag & Drop PDF di sini<br><span class="text-[10px] text-green-400 font-mono font-normal">Mendukung file besar langsung via Storage</span></p>
                    </div>
                </div>

                <div>
                    <label class="text-[10px] text-gray-400 font-mono mb-1 block uppercase font-bold tracking-widest">Judul Dokumen</label>
                    <input type="text" id="title" required class="w-full bg-[#0b0f19] border-2 border-gray-800 rounded-xl px-4 py-3 focus:outline-none focus:border-cyan-400 text-sm font-bold shadow-inner transition-colors placeholder-gray-600" placeholder="Contoh: Laporan Kasus Fissure Tongue...">
                </div>

                <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                    <!-- KATEGORI DEPT/BAGIAN: INPUT + DROPDOWN (DATALIST) -->
                    <div>
                        <label class="text-[10px] text-gray-400 font-mono mb-1 block uppercase font-bold tracking-widest">Kategori Dept/Bagian</label>
                        <input list="categoryList" id="category" required class="w-full bg-[#0b0f19] border-2 border-gray-800 rounded-xl px-4 py-3 focus:outline-none focus:border-cyan-400 text-sm font-bold shadow-inner transition-colors placeholder-gray-600" placeholder="Ketik atau pilih...">
                        <datalist id="categoryList">
                            <option value="Preklinik">
                            <option value="Profesi Dokter Muda">
                            <option value="Jurnal & Riset">
                            <option value="Kedokteran Gigi Umum">
                        </datalist>
                    </div>
                    <div>
                        <label class="text-[10px] text-gray-400 font-mono mb-1 block uppercase font-bold tracking-widest">Hak Akses URL</label>
                        <select id="accessType" class="w-full bg-[#0b0f19] border-2 border-gray-800 rounded-xl px-4 py-3 focus:outline-none focus:border-cyan-400 text-sm font-bold shadow-inner cursor-pointer text-cyan-400 h-[48px]">
                            <option value="Restricted" selected>Restricted (Blur)</option>
                            <option value="Open Access">Open Access (Free)</option>
                        </select>
                    </div>
                </div>

                <div>
                    <label class="text-[10px] text-gray-400 font-mono mb-1 block uppercase font-bold tracking-widest">Deskripsi / Abstrak Singkat</label>
                    <textarea id="desc" rows="4" required class="w-full bg-[#0b0f19] border-2 border-gray-800 rounded-xl px-4 py-3 focus:outline-none focus:border-cyan-400 text-sm resize-none shadow-inner" placeholder="Tuliskan rangkuman atau abstrak materi..."></textarea>
                </div>

                <button type="submit" id="btnSubmit" class="w-full bg-gradient-to-r from-cyan-500 to-blue-500 text-black font-black py-4 rounded-xl hover:brightness-110 shadow-[0_10px_20px_rgba(0,229,255,0.3)] transition-all uppercase tracking-widest flex items-center justify-center gap-2 active:scale-95">
                    <i class="ph-bold ph-database"></i> Push to Storage
                </button>
            </form>
        </div>

        <!-- List Data (Kanan) -->
        <div class="lg:col-span-8 flex flex-col h-[80vh]">
            <div class="flex items-center justify-between mb-4">
                <div class="flex items-center gap-2">
                    <div class="h-2 w-2 rounded-full bg-green-400 animate-pulse"></div>
                    <h3 class="text-sm font-mono text-gray-400 uppercase tracking-widest">System Live Records</h3>
                </div>
                <button onclick="fetchArsip()" class="text-cyan-400 hover:text-white text-sm flex items-center gap-1 font-mono"><i class="ph-bold ph-arrows-clockwise"></i> Refresh</button>
            </div>
            <div class="flex-grow overflow-y-auto pr-2 custom-scrollbar space-y-4" id="arsipList">
                <div class="glass-panel p-10 text-center rounded-2xl flex flex-col items-center justify-center h-full">
                    <i class="ph-bold ph-spinner-gap animate-spin text-5xl text-cyan-400 mb-4 drop-shadow-[0_0_15px_rgba(0,229,255,0.8)]"></i>
                    <p class="text-gray-400 font-mono uppercase tracking-widest">Querying Database...</p>
                </div>
            </div>
        </div>
    </div>

    <!-- VIEW 2: MANAJEMEN FORM DOWNLOAD (DYNAMIC BUILDER) -->
    <div id="view-form" class="hidden relative z-10 w-full max-w-4xl mx-auto">
        <div class="glass-panel p-6 md:p-8 rounded-3xl border-t-4 border-t-purple-500">
            <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center mb-8 gap-4 border-b border-gray-800 pb-6">
                <div>
                    <h2 class="text-2xl font-black text-purple-400 flex items-center gap-2"><i class="ph-bold ph-toggle-right"></i> Pengaturan Wajib Form</h2>
                    <p class="text-gray-400 text-sm mt-1 max-w-xl">Konfigurasi field yang harus dilengkapi user saat mengakses PDF berstatus Restricted.</p>
                </div>
                <!-- Toggle Master -->
                <div class="flex items-center gap-3 bg-[#0b0f19] px-4 py-3 rounded-2xl border border-gray-800">
                    <span id="formStatusText" class="text-xs font-bold font-mono text-gray-400">NONAKTIF</span>
                    <label class="relative inline-flex items-center cursor-pointer">
                        <input type="checkbox" id="toggleRequireForm" class="sr-only peer" onchange="toggleRequireFormStatus()">
                        <div class="w-12 h-6 bg-gray-700 peer-focus:outline-none rounded-full peer peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:border-gray-300 after:border after:rounded-full after:h-5 after:w-5 after:transition-all peer-checked:bg-purple-500 shadow-inner"></div>
                    </label>
                </div>
            </div>
            
            <!-- Dynamic Field Builder -->
            <div class="bg-[#0b0f19] border-2 border-gray-800 rounded-2xl p-6 mb-8">
                <h4 class="font-black text-white text-lg mb-4 flex items-center gap-2"><i class="ph-bold ph-list-dashes text-purple-400"></i> Struktur Form Aktif</h4>
                
                <div id="dynamicFieldsList" class="space-y-3 mb-6">
                    <!-- Fields injected by JS -->
                </div>
                
                <div class="flex flex-col sm:flex-row gap-3 pt-4 border-t border-gray-800/50">
                    <input type="text" id="newFieldLabel" placeholder="Contoh: Nomor Induk Mahasiswa (NIM)" class="flex-grow bg-[#030712] border border-gray-700 rounded-xl px-4 py-3 focus:outline-none focus:border-purple-400 text-sm font-bold shadow-inner text-white placeholder-gray-600 transition-colors">
                    <button type="button" onclick="addField()" class="bg-purple-500/20 text-purple-400 border border-purple-500 hover:bg-purple-500 hover:text-white px-6 py-3 rounded-xl font-bold transition-all text-sm whitespace-nowrap shadow-[0_0_10px_rgba(168,85,247,0.1)] active:scale-95">
                        <i class="ph-bold ph-plus"></i> Tambah Field
                    </button>
                </div>
                <p class="text-[10px] text-gray-500 font-mono mt-3">* ID Field akan dibuat secara otomatis berdasarkan Label. Tambahkan field baru sesuka hati.</p>
            </div>

            <button onclick="saveFormSettings()" id="btnSaveSettings" class="w-full bg-gradient-to-r from-purple-500 to-pink-500 text-white font-black py-4 rounded-xl hover:brightness-110 shadow-[0_10px_20px_rgba(168,85,247,0.3)] transition-all uppercase tracking-widest active:scale-95 flex items-center justify-center gap-2">
                <i class="ph-bold ph-floppy-disk text-xl"></i> Simpan Konfigurasi Form
            </button>
        </div>
    </div>

    <!-- VIEW 3: LIST NAMA DOWNLOAD (USERS & RIWAYAT) -->
    <div id="view-users" class="hidden relative z-10 w-full">
        <div class="glass-panel p-6 md:p-8 rounded-3xl border-t-4 border-t-green-400">
            <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center mb-6 gap-4">
                <div>
                    <h2 class="text-2xl font-black text-green-400 flex items-center gap-2"><i class="ph-bold ph-users"></i> Daftar Pengunduh Terverifikasi</h2>
                    <p class="text-gray-400 text-xs mt-1 font-mono">Daftar pengguna yang telah melakukan login Google dan riwayat dokumen yang diunduh.</p>
                </div>
                <button onclick="fetchUsers()" class="text-green-400 border border-green-400 hover:bg-green-400 hover:text-black px-4 py-2 rounded-lg text-sm flex items-center gap-2 font-bold transition-all shrink-0 active:scale-95"><i class="ph-bold ph-arrows-clockwise"></i> Refresh Tabel</button>
            </div>
            
            <div class="overflow-x-auto rounded-xl border border-gray-800 custom-scrollbar shadow-inner bg-[#0b0f19]">
                <table class="w-full text-left text-sm text-gray-300 whitespace-nowrap">
                    <thead id="userTableHead" class="text-[10px] uppercase bg-[#030712] text-cyan-500 font-black tracking-widest border-b border-gray-800">
                        <!-- Dynamic Headers Diinjeksi via JS -->
                    </thead>
                    <tbody id="usersList" class="divide-y divide-gray-800/50">
                        <tr><td colspan="10" class="px-6 py-10 text-center"><i class="ph-bold ph-spinner-gap animate-spin text-3xl text-green-400"></i></td></tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- MODAL EDIT DATA ARSIP (FULL CRUD) -->
    <div id="editModal" class="fixed inset-0 z-50 hidden bg-[#030712]/90 backdrop-blur-md flex items-center justify-center p-4 overflow-y-auto">
        <div class="glass-panel w-full max-w-2xl p-6 md:p-8 rounded-3xl border-t-4 border-t-pink-500 modal-enter shadow-[0_0_50px_rgba(255,16,240,0.15)] relative my-8">
            <button onclick="tutupEdit()" class="absolute top-5 right-5 text-gray-400 hover:text-white"><i class="ph-bold ph-x text-2xl"></i></button>

            <h2 class="text-2xl font-black mb-6 flex items-center gap-2 text-pink-500 uppercase tracking-wide"><i class="ph-bold ph-pencil-simple"></i> Edit Metadata Arsip</h2>

            <form id="formEdit" class="space-y-4">
                <input type="hidden" id="editId">
                <div>
                    <label class="text-[10px] text-gray-400 font-mono mb-1 block uppercase font-bold tracking-widest">Judul Dokumen</label>
                    <input type="text" id="editTitle" required class="w-full bg-[#0b0f19] border-2 border-gray-800 rounded-xl px-4 py-3 focus:outline-none focus:border-pink-500 text-sm font-bold shadow-inner transition-colors">
                </div>
                <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                    <div>
                        <label class="text-[10px] text-gray-400 font-mono mb-1 block uppercase font-bold tracking-widest">Kategori Dept/Bagian</label>
                        <input list="categoryList" id="editCategory" required class="w-full bg-[#0b0f19] border-2 border-gray-800 rounded-xl px-4 py-3 focus:outline-none focus:border-pink-500 text-sm font-bold shadow-inner transition-colors">
                    </div>
                    <div>
                        <label class="text-[10px] text-gray-400 font-mono mb-1 block uppercase font-bold tracking-widest">Hak Akses URL</label>
                        <select id="editAccessType" class="w-full bg-[#0b0f19] border-2 border-gray-800 rounded-xl px-4 py-3 focus:outline-none focus:border-pink-500 text-sm font-bold text-pink-400 h-[48px]">
                            <option value="Restricted">Restricted (Blur)</option>
                            <option value="Open Access">Open Access (Free)</option>
                        </select>
                    </div>
                </div>
                <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                    <div>
                        <label class="text-[10px] text-gray-400 font-mono mb-1 block uppercase font-bold tracking-widest">URL Slug (Custom Link SEO)</label>
                        <input type="text" id="editSlug" required class="w-full bg-[#0b0f19] border-2 border-gray-800 rounded-xl px-4 py-3 focus:outline-none focus:border-pink-500 text-sm font-bold font-mono text-cyan-200">
                    </div>
                    <div>
                        <label class="text-[10px] text-gray-400 font-mono mb-1 block uppercase font-bold tracking-widest">Tanggal Upload</label>
                        <input type="text" id="editDate" required class="w-full bg-[#0b0f19] border-2 border-gray-800 rounded-xl px-4 py-3 focus:outline-none focus:border-pink-500 text-sm font-bold font-mono text-green-300 h-[48px]">
                    </div>
                </div>
                <div>
                    <label class="text-[10px] text-gray-400 font-mono mb-1 block uppercase font-bold tracking-widest">Deskripsi / Abstrak Singkat</label>
                    <textarea id="editDesc" rows="4" required class="w-full bg-[#0b0f19] border-2 border-gray-800 rounded-xl px-4 py-3 focus:outline-none focus:border-pink-500 text-sm resize-none shadow-inner"></textarea>
                </div>
                <button type="submit" id="btnEditSubmit" class="w-full bg-gradient-to-r from-pink-500 to-purple-500 text-white font-black py-4 rounded-xl hover:brightness-110 shadow-[0_10px_20px_rgba(255,16,240,0.3)] transition-all uppercase tracking-widest mt-2 active:scale-95">Simpan Perubahan</button>
            </form>
        </div>
    </div>

    <script>
        const token = localStorage.getItem('axa_arsip_token');
        if (!token) { try { window.location.href = '/admin/login'; } catch (e) {} }

        const SUPABASE_URL = "<%= typeof supabaseUrl !== 'undefined' ? supabaseUrl : '' %>"; 
        const SUPABASE_ANON_KEY = "<%= typeof supabaseAnonKey !== 'undefined' ? supabaseAnonKey : '' %>"; 

        let supabaseClient = null;
        let globalArsipData = []; 
        
        // VARIABEL GLOBAL PENGATURAN FORM DINAMIS
        let globalFormSettings = { requireForm: true, fields: [] };

        if (SUPABASE_URL && SUPABASE_ANON_KEY) {
            try { supabaseClient = window.supabase.createClient(SUPABASE_URL, SUPABASE_ANON_KEY); } catch (e) { }
        }

        // --- SISTEM TABS NAVIGATION ---
        function switchTab(tabId) {
            ['arsip', 'form', 'users'].forEach(id => {
                document.getElementById(`view-${id}`).classList.add('hidden');
                const btn = document.getElementById(`tab-${id}`);
                btn.classList.remove('border-cyan-400', 'text-cyan-400');
                btn.classList.add('border-transparent', 'text-gray-500');
            });

            document.getElementById(`tab-${tabId}`).classList.remove('border-transparent', 'text-gray-500');
            document.getElementById(`tab-${tabId}`).classList.add('border-cyan-400', 'text-cyan-400');
            
            document.getElementById(`view-${tabId}`).classList.remove('hidden');

            if(tabId === 'users') fetchUsers();
            if(tabId === 'form') fetchFormSetting();
        }

        // ==========================================
        // FITUR BARU: MANAJEMEN FORM & TABLE USER
        // ==========================================

        async function fetchFormSetting() {
            try {
                const res = await fetch('/api/settings/form', { headers: { 'Authorization': token } });
                const data = await res.json();
                
                // Menangani Object JSON bertingkat dari server
                if (data.requireForm && typeof data.requireForm === 'object') {
                    globalFormSettings = data.requireForm;
                } else {
                    // Fallback Default jika belum ada setting di database
                    globalFormSettings = {
                        requireForm: data.requireForm !== undefined ? data.requireForm : true,
                        fields: [
                            { id: 'nama_lengkap', label: 'Nama Lengkap (Sesuai KTP/Gelar)' },
                            { id: 'institusi_asal', label: 'Asal Universitas / Instansi' }
                        ]
                    };
                }
                renderFormSettingsUI();
                renderUserTableHeader();
            } catch(e) { console.error("Gagal load Form Settings", e); }
        }

        function toggleRequireFormStatus() {
            globalFormSettings.requireForm = document.getElementById('toggleRequireForm').checked;
            renderFormSettingsUI();
        }

        function renderFormSettingsUI() {
            document.getElementById('toggleRequireForm').checked = globalFormSettings.requireForm;
            document.getElementById('formStatusText').innerHTML = globalFormSettings.requireForm ? "AKTIF" : "NONAKTIF";
            document.getElementById('formStatusText').className = globalFormSettings.requireForm ? "text-xs font-bold font-mono text-green-400" : "text-xs font-bold font-mono text-gray-500";
            
            const listEl = document.getElementById('dynamicFieldsList');
            if (globalFormSettings.fields.length === 0) {
                listEl.innerHTML = '<div class="text-center text-gray-500 font-mono text-sm py-5 border border-dashed border-gray-700 rounded-xl">Belum ada field formulir.</div>';
            } else {
                listEl.innerHTML = globalFormSettings.fields.map((f, i) => `
                    <div class="flex justify-between items-center bg-[#030712] border border-gray-800 px-5 py-3.5 rounded-xl hover:border-purple-500/50 transition-colors group">
                        <div>
                            <span class="text-sm font-bold text-white block">${f.label}</span>
                            <span class="text-[9px] text-gray-500 font-mono uppercase">ID: ${f.id}</span>
                        </div>
                        <button type="button" onclick="removeField(${i})" class="text-red-500/50 hover:text-red-400 bg-red-500/10 p-2.5 rounded-lg transition-all opacity-50 group-hover:opacity-100" title="Hapus Field"><i class="ph-bold ph-trash text-lg"></i></button>
                    </div>
                `).join('');
            }
        }

        function addField() {
            const input = document.getElementById('newFieldLabel');
            const label = input.value.trim();
            if(!label) return;
            
            // Auto generate ID (lowercase, alphanumeric underscore only)
            const id = label.toLowerCase().replace(/[^a-z0-9]+/g, '_').replace(/^_|_$/g, '');
            
            globalFormSettings.fields.push({ id, label });
            input.value = '';
            renderFormSettingsUI();
            renderUserTableHeader();
        }

        function removeField(index) {
            globalFormSettings.fields.splice(index, 1);
            renderFormSettingsUI();
            renderUserTableHeader();
        }

        async function saveFormSettings() {
            const btn = document.getElementById('btnSaveSettings');
            const ori = btn.innerHTML;
            btn.innerHTML = '<i class="ph-bold ph-spinner-gap animate-spin text-xl"></i> MENYIMPAN KONFIGURASI...';
            btn.disabled = true;

            try {
                const res = await fetch('/api/settings/form', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json', 'Authorization': token },
                    body: JSON.stringify({ requireForm: globalFormSettings })
                });
                if(!res.ok) throw new Error("Gagal terhubung ke API Settings.");
                alert('Konfigurasi Dynamic Form berhasil disimpan ke Cloud Storage!');
                fetchUsers(); 
            } catch (err) {
                alert("Gagal update konfigurasi: " + err.message);
            } finally {
                btn.innerHTML = ori;
                btn.disabled = false;
            }
        }

        // MENGGAMBAR HEADER TABEL SECARA DINAMIS
        function renderUserTableHeader() {
            let th = `<th class="px-6 py-4">Tgl Registrasi</th><th class="px-6 py-4 border-r border-gray-800">Email Akun Google</th>`;
            
            // Kolom Dinamis berdasarkan Setting Form
            globalFormSettings.fields.forEach(f => {
                th += `<th class="px-6 py-4 text-white">${f.label}</th>`;
            });

            // Tambahan Kolom Baru: Riwayat Download
            th += `<th class="px-6 py-4 text-cyan-400 border-l border-gray-800">Riwayat Download PDF</th>`;
            
            document.getElementById('userTableHead').innerHTML = `<tr>${th}</tr>`;
        }

        async function fetchUsers() {
            // Pastikan struktur form udah dimuat
            if(!globalFormSettings.fields || globalFormSettings.fields.length === 0) await fetchFormSetting();

            const listEl = document.getElementById('usersList');
            const colSpan = 3 + globalFormSettings.fields.length;
            listEl.innerHTML = `<tr><td colspan="${colSpan}" class="px-6 py-12 text-center"><i class="ph-bold ph-spinner-gap animate-spin text-3xl text-green-400"></i></td></tr>`;
            
            try {
                const res = await fetch('/api/users', { headers: { 'Authorization': token } });
                const dataRaw = await res.json();
                if(!res.ok) throw new Error(dataRaw.message);
                
                const users = dataRaw.data;
                if(users.length === 0) {
                    listEl.innerHTML = `<tr><td colspan="${colSpan}" class="px-6 py-12 text-center text-gray-500 font-mono border-2 border-dashed border-gray-800 m-4 rounded-xl">Belum ada user yang terdaftar.</td></tr>`;
                    return;
                }

                listEl.innerHTML = users.map(u => {
                    let row = `<td class="px-6 py-4 font-mono text-xs text-gray-500">${u.created_at}</td>`;
                    row += `<td class="px-6 py-4 text-cyan-400 font-bold border-r border-gray-800/50">${u.email}</td>`;
                    
                    // Loop isian user menyesuaikan field dinamis
                    globalFormSettings.fields.forEach(f => {
                        const val = (u.raw_metadata && u.raw_metadata[f.id]) || (f.id === 'nama_lengkap' ? u.name : null) || (f.id === 'institusi_asal' ? u.institution : null) || '-';
                        row += `<td class="px-6 py-4 text-gray-300 font-medium">${val}</td>`;
                    });

                    // Render Riwayat Download (String yang sudah di-format dari server)
                    const downloads = u.downloaded_files && u.downloaded_files.length > 0 
                        ? u.downloaded_files.map(fileStr => `<span class="bg-cyan-500/10 text-cyan-400 text-[10px] px-2.5 py-1.5 rounded-lg border border-cyan-500/30 whitespace-nowrap mb-1 mr-1 block w-max font-medium shadow-sm"><i class="ph-fill ph-file-pdf"></i> ${fileStr}</span>`).join('') 
                        : '<span class="text-gray-600 italic text-xs font-mono">Belum pernah mengunduh arsip</span>';

                    row += `<td class="px-6 py-4 border-l border-gray-800/50"><div class="flex flex-col gap-1 w-max">${downloads}</div></td>`;

                    return `<tr class="hover:bg-green-500/5 transition-colors group">${row}</tr>`;
                }).join('');
            } catch (err) {
                listEl.innerHTML = `<tr><td colspan="${colSpan}" class="px-6 py-10 text-center text-red-400 font-mono"><i class="ph-fill ph-warning-circle text-2xl mb-2"></i><br>${err.message}</td></tr>`;
            }
        }

        // ==========================================
        // UPLOAD & CRUD ARSIP LOGIC (EXISTING)
        // ==========================================

        let selectedFile = null;
        const dropzone = document.getElementById('dropzoneContainer');
        const fileInput = document.getElementById('fileInput');
        const dropText = document.getElementById('dropText');
        const dropIcon = document.getElementById('dropIcon');

        ['dragenter', 'dragover', 'dragleave', 'drop'].forEach(eventName => {
            dropzone.addEventListener(eventName, e => { e.preventDefault(); e.stopPropagation(); }, false);
        });
        dropzone.addEventListener('dragover', () => dropzone.classList.add('dragover'));
        dropzone.addEventListener('dragleave', () => dropzone.classList.remove('dragover'));
        dropzone.addEventListener('drop', e => { dropzone.classList.remove('dragover'); handleFiles(e.dataTransfer.files); });
        fileInput.addEventListener('change', e => { handleFiles(e.target.files); });

        function handleFiles(files) {
            if (files.length === 0) return;
            const file = files[0];
            if (file.type !== "application/pdf") return alert("Hanya file PDF yang diizinkan!");

            selectedFile = file;
            dropText.innerHTML = `<span class="text-green-400 font-black">${file.name}</span><br><span class="text-gray-400">${(file.size/1024/1024).toFixed(2)} MB Ready (Unlimited Storage)</span>`;
            dropIcon.className = "ph-fill ph-check-circle text-4xl text-green-400 mb-2";
            dropzone.classList.add('has-file');
        }

        async function fetchArsip() {
            const listEl = document.getElementById('arsipList');
            try {
                const res = await fetch('/api/arsip', { headers: { 'Authorization': token } });
                if (!res.ok) {
                    const errRes = await res.json();
                    throw new Error(errRes.message || "Gagal mengambil data dari server.");
                }

                const { data } = await res.json();
                globalArsipData = data; 

                populateCategoryDatalist(data);

                if(data.length === 0) { 
                    listEl.innerHTML = '<div class="glass-panel p-8 text-center rounded-2xl text-gray-400 font-mono">Database kosong.</div>'; 
                    return; 
                }

                const formatDateStr = (dateStr) => {
                    if(dateStr && dateStr.match(/^\d{4}-\d{2}-\d{2}$/)) {
                        const parts = dateStr.split('-'); return `${parts[2]}-${parts[1]}-${parts[0]}`;
                    }
                    return dateStr;
                };

                listEl.innerHTML = data.map(item => {
                    const displayDate = formatDateStr(item.date);
                    const accessColor = item.access_type === 'Open Access' ? 'text-green-400 border-green-400/30 bg-green-500/10' : 'text-red-400 border-red-400/30 bg-red-500/10';
                    return `
                    <div class="brutal-card rounded-2xl p-5 flex flex-col md:flex-row justify-between items-start md:items-center gap-4 relative overflow-hidden group">
                        <div class="absolute right-0 top-0 h-full w-32 bg-gradient-to-l from-cyan-500/10 to-transparent pointer-events-none"></div>
                        <div class="min-w-0 w-full z-10">
                            <div class="flex gap-2 mb-2 flex-wrap">
                                <span class="text-[9px] bg-cyan-500/20 border border-cyan-400/30 text-cyan-400 px-2.5 py-1 rounded font-mono uppercase tracking-widest font-bold">${item.category}</span>
                                <span class="text-[9px] ${accessColor} border px-2.5 py-1 rounded font-mono uppercase tracking-widest font-bold">${item.access_type || 'Restricted'}</span>
                            </div>
                            <h3 class="text-lg md:text-xl font-black mt-2.5 break-words w-full drop-shadow-sm text-white leading-tight">${item.title}</h3>
                            <p class="text-gray-400 text-[10px] md:text-xs break-words font-mono mt-1.5 w-full flex flex-wrap gap-2 items-center">
                                <span><i class="ph-bold ph-link text-cyan-400"></i> /${item.slug}</span> 
                                <span class="hidden sm:inline">|</span> 
                                <span><i class="ph-bold ph-calendar text-pink-400"></i> ${displayDate}</span>
                            </p>
                        </div>
                        <div class="flex gap-2 z-10 shrink-0 w-full md:w-auto mt-2 md:mt-0">
                            <button onclick="bukaEdit('${item.id}')" class="flex-1 md:flex-none text-center bg-gray-800 text-white p-3 rounded-xl hover:bg-pink-500 hover:text-white transition-colors border border-gray-700 hover:border-pink-500" title="Edit Metadata Terlengkap"><i class="ph-bold ph-pencil-simple text-lg"></i></button>
                            <a href="/arsip/${item.slug}" target="_blank" class="flex-1 md:flex-none text-center bg-gray-800 text-white p-3 rounded-xl hover:bg-cyan-500 hover:text-black transition-colors border border-gray-700 hover:border-cyan-400" title="View Article Page"><i class="ph-bold ph-arrow-square-out text-lg"></i></a>
                            <button onclick="hapus('${item.id}')" class="flex-1 md:flex-none text-center bg-red-500/10 text-red-500 p-3 rounded-xl hover:bg-red-500 hover:text-white transition-colors shadow-[0_0_10px_rgba(239,68,68,0.2)] border border-red-500/30 hover:border-red-500" title="Hapus Permanen"><i class="ph-bold ph-trash text-lg"></i></button>
                        </div>
                    </div>
                `}).join('');
            } catch (error) {
                listEl.innerHTML = `<div class="glass-panel p-8 text-center rounded-2xl text-red-400 font-mono border-red-500/50"><i class="ph-fill ph-warning-circle text-4xl mb-3"></i><br>${error.message}</div>`;
            }
        }

        function populateCategoryDatalist(data) {
            const defaultCats = ["Preklinik", "Profesi Dokter Muda", "Jurnal & Riset", "Kedokteran Gigi Umum"];
            const dbCats = data.map(item => item.category).filter(Boolean);
            const uniqueCategories = [...new Set([...defaultCats, ...dbCats])];
            document.getElementById('categoryList').innerHTML = uniqueCategories.map(cat => `<option value="${cat}">`).join('');
        }

        document.getElementById('formArsip').addEventListener('submit', async (e) => {
            e.preventDefault();
            if(!selectedFile) return alert("Harap pilih file PDF terlebih dahulu!");

            const btn = document.getElementById('btnSubmit');
            const ogText = btn.innerHTML;

            if (!supabaseClient) {
                alert("SISTEM TERKUNCI: Environment Variables (SUPABASE_URL & ANON_KEY) tidak ditemukan.");
                return;
            }

            btn.innerHTML = '<i class="ph-bold ph-spinner-gap animate-spin text-xl"></i> UPLOADING DIRECT TO STORAGE...';
            btn.disabled = true;

            try {
                const uniqueId = Date.now().toString();
                const cleanFileName = selectedFile.name.replace(/[^a-zA-Z0-9.-]/g, '_');
                const filePath = `${uniqueId}_${cleanFileName}`;

                const { error: storageError } = await supabaseClient.storage.from('arsip_files').upload(filePath, selectedFile, { cacheControl: '3600', upsert: false });
                if (storageError) throw new Error("Upload Storage Gagal: " + storageError.message);

                const payload = {
                    id: uniqueId, title: document.getElementById('title').value, category: document.getElementById('category').value,
                    desc: document.getElementById('desc').value, accessType: document.getElementById('accessType').value,
                    fileName: selectedFile.name, filePath: filePath
                };

                const res = await fetch('/api/arsip', { 
                    method: 'POST', headers: { 'Content-Type': 'application/json', 'Authorization': token }, body: JSON.stringify(payload) 
                });
                if (!res.ok) throw new Error("Database Gagal");

                document.getElementById('formArsip').reset();
                selectedFile = null;
                dropzone.classList.remove('has-file');
                dropIcon.className = "ph-fill ph-file-pdf text-4xl text-cyan-400 mb-2 group-hover:scale-110 transition-transform";
                dropText.innerHTML = `Drag & Drop PDF di sini<br><span class="text-[10px] text-green-400 font-mono font-normal">Mendukung file besar langsung via Storage</span>`;
                fetchArsip(); 
            } catch (err) { alert(err.message); } finally { btn.innerHTML = ogText; btn.disabled = false; }
        });

        function bukaEdit(id) {
            const item = globalArsipData.find(x => x.id === id);
            if(!item) return;

            document.getElementById('editId').value = item.id;
            document.getElementById('editTitle').value = item.title;
            document.getElementById('editCategory').value = item.category;
            document.getElementById('editDesc').value = item.desc;
            document.getElementById('editAccessType').value = item.access_type || 'Restricted';
            document.getElementById('editSlug').value = item.slug;

            let editDisplayDate = item.date;
            if(editDisplayDate && editDisplayDate.match(/^\d{4}-\d{2}-\d{2}$/)) {
                const parts = editDisplayDate.split('-'); editDisplayDate = `${parts[2]}-${parts[1]}-${parts[0]}`;
            }
            document.getElementById('editDate').value = editDisplayDate;
            document.getElementById('editModal').classList.remove('hidden');
        }

        function tutupEdit() {
            document.getElementById('editModal').classList.add('hidden');
            document.getElementById('formEdit').reset();
        }

        document.getElementById('formEdit').addEventListener('submit', async (e) => {
            e.preventDefault();
            const btn = document.getElementById('btnEditSubmit');
            const ogText = btn.innerHTML;
            btn.innerHTML = '<i class="ph-bold ph-spinner-gap animate-spin text-xl"></i> MENYIMPAN...'; btn.disabled = true;

            const docId = document.getElementById('editId').value;
            let safeSlug = document.getElementById('editSlug').value.trim().toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/(^-|-$)+/g, '');

            const payload = {
                title: document.getElementById('editTitle').value, category: document.getElementById('editCategory').value,
                desc: document.getElementById('editDesc').value, accessType: document.getElementById('editAccessType').value,
                slug: safeSlug, date: document.getElementById('editDate').value.trim()
            };

            try {
                const res = await fetch(`/api/arsip/${docId}`, {
                    method: 'PUT', headers: { 'Content-Type': 'application/json', 'Authorization': token }, body: JSON.stringify(payload)
                });
                if(!res.ok) throw new Error("Gagal mengupdate data.");
                tutupEdit(); fetchArsip(); 
            } catch (err) { alert(err.message); } finally { btn.innerHTML = ogText; btn.disabled = false; }
        });

        async function hapus(id) {
            if(!confirm('Hapus permanen dokumen & file PDF ini dari Storage dan Database?')) return;
            try {
                const res = await fetch('/api/arsip/'+id, { method: 'DELETE', headers: { 'Authorization': token } });
                if(!res.ok) throw new Error("Gagal hapus");
                fetchArsip(); 
            } catch (e) { alert(e.message); }
        }

        // ==========================================
        // LOGOUT LOGIC (CLEAR TOKEN & SUPABASE SESSION)
        // ==========================================
        async function logout() {
            try {
                // Logout dari Session Google/Supabase jika ada (Supaya tidak tumpang tindih)
                if (supabaseClient) await supabaseClient.auth.signOut();
            } catch(e) { console.warn("Supabase signout issue:", e); }
            
            // Hapus Token Admin lokal
            localStorage.removeItem('axa_arsip_token');
            window.location.href = '/admin/login';
        }

        fetchArsip();
        fetchFormSetting(); 
    </script>
</body>
</html>
