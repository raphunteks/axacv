<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Dashboard Arsip | Axa System</title>

    <link rel="icon" type="image/png" href="/axalogo.png">
    <link rel="apple-touch-icon" href="/axalogo.png">

    <script src="https://cdn.tailwindcss.com"></script>
    <script src="https://unpkg.com/@phosphor-icons/web"></script>
    <script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;700;900&family=Space+Grotesk:wght@700;900&display=swap" rel="stylesheet">
    <style>
        /* NEUBRUTALISM FOUNDATION */
        body { 
            font-family: 'Plus Jakarta Sans', sans-serif; 
            background-color: #f4f4f0; /* Off-white playful background */
            color: #000;
            background-image: radial-gradient(#000 1px, transparent 1px);
            background-size: 24px 24px;
        }
        
        .font-display { font-family: 'Space Grotesk', sans-serif; }

        /* CORE COMPONENTS */
        .brutal-border { border: 4px solid #000; }
        .brutal-shadow { box-shadow: 6px 6px 0px #000; transition: all 0.2s ease-in-out; }
        .brutal-shadow-lg { box-shadow: 10px 10px 0px #000; transition: all 0.2s ease-in-out; }
        
        /* PANEL & CARDS */
        .brutal-panel { background: #fff; border: 4px solid #000; box-shadow: 8px 8px 0px #000; border-radius: 0.5rem; }
        .brutal-card { background: #fff; border: 4px solid #000; box-shadow: 6px 6px 0px #000; transition: all 0.15s ease-in-out; border-radius: 0.5rem; }
        .brutal-card:hover { transform: translate(-2px, -2px); box-shadow: 8px 8px 0px #000; }
        
        /* BUTTONS */
        .brutal-btn {
            border: 4px solid #000;
            box-shadow: 4px 4px 0px #000;
            transition: all 0.15s ease-in-out;
            font-family: 'Space Grotesk', sans-serif;
            text-transform: uppercase;
            font-weight: 900;
            border-radius: 0.5rem;
        }
        .brutal-btn:hover { transform: translate(-2px, -2px); box-shadow: 6px 6px 0px #000; }
        .brutal-btn:active { transform: translate(4px, 4px); box-shadow: 0px 0px 0px #000; }

        .brutal-btn-small { border: 3px solid #000; box-shadow: 3px 3px 0px #000; border-radius: 0.5rem; font-weight: 900; }
        .brutal-btn-small:hover { transform: translate(-1px, -1px); box-shadow: 4px 4px 0px #000; }
        .brutal-btn-small:active { transform: translate(2px, 2px); box-shadow: 1px 1px 0px #000; }

        /* INPUTS */
        .brutal-input {
            background: #fff;
            border: 3px solid #000;
            box-shadow: 4px 4px 0px #000;
            transition: all 0.2s;
            border-radius: 0.5rem;
            color: #000;
        }
        .brutal-input:focus {
            transform: translate(-2px, -2px);
            box-shadow: 6px 6px 0px #000;
            outline: none;
            background-color: #E0E7FF;
        }
        .brutal-input::placeholder { color: #6b7280; font-weight: 700; }

        /* DROPZONE */
        .dropzone { border: 4px dashed #000; transition: all 0.3s ease; background: #fff; border-radius: 0.5rem; }
        .dropzone.dragover { background: #fef08a; border-color: #000; border-style: solid; transform: scale(1.02); }
        .dropzone.has-file { border: 4px solid #000; background: #bbf7d0; box-shadow: inset 4px 4px 0px rgba(0,0,0,0.1); }

        /* SCROLLBAR */
        .custom-scrollbar::-webkit-scrollbar { width: 8px; height: 8px; }
        .custom-scrollbar::-webkit-scrollbar-track { background: #fff; border-left: 2px solid #000; }
        .custom-scrollbar::-webkit-scrollbar-thumb { background: #000; border: 2px solid #fff; }

        /* Animasi Modal Edit */
        .modal-enter { animation: modalFadeIn 0.3s cubic-bezier(0.175, 0.885, 0.32, 1.275) forwards; }
        @keyframes modalFadeIn { 0% { opacity: 0; transform: scale(0.95) translateY(20px); } 100% { opacity: 1; transform: scale(1) translateY(0); } }
        
        input::-webkit-calendar-picker-indicator { cursor: pointer; opacity: 1; filter: invert(1); }

        /* TAB ACTIVE STATE */
        .tab-btn { border: 3px solid transparent; border-bottom: 4px solid #000; }
        .tab-btn.active { background: #fff; border: 4px solid #000; border-bottom-color: #fff; transform: translateY(4px); border-radius: 0.5rem 0.5rem 0 0; }
    </style>
</head>
<body class="p-4 md:p-8 relative custom-scrollbar h-screen overflow-y-auto">

    <nav class="bg-[#FDE047] brutal-panel p-4 md:p-6 mb-8 flex flex-col md:flex-row justify-between items-center gap-4 z-10 relative">
        <div class="flex items-center gap-4">
            <div class="bg-white p-2 brutal-border shadow-[4px_4px_0px_#000]">
                <i class="ph-bold ph-database text-4xl text-black"></i>
            </div>
            <div>
                <h1 class="text-2xl md:text-3xl font-black font-display tracking-tight uppercase text-black drop-shadow-[2px_2px_0px_#fff]">Knowledge Base <span class="text-red-500 underline decoration-4 underline-offset-4">Core</span></h1>
                <p class="text-xs text-black font-bold tracking-widest mt-1 bg-white inline-block px-2 border-2 border-black">MASTER STORAGE MANAGER (FULL CRUD)</p>
            </div>
        </div>
        <div class="flex gap-3 w-full md:w-auto">
            <a href="/arsip" target="_blank" class="flex-1 md:flex-none text-center bg-[#22D3EE] text-black px-6 py-3 brutal-btn text-sm flex items-center justify-center gap-2"><i class="ph-bold ph-eye text-lg"></i> View Live</a>
            <button onclick="logout()" class="flex-1 md:flex-none text-center bg-[#FF90E8] text-black px-6 py-3 brutal-btn text-sm flex items-center justify-center gap-2"><i class="ph-bold ph-power text-lg"></i> Logout</button>
        </div>
    </nav>

    <!-- TABS NAVIGASI UTAMA -->
    <div class="flex gap-2 border-b-4 border-black mb-8 overflow-x-auto custom-scrollbar z-10 relative px-2 pt-2">
        <button onclick="switchTab('arsip')" id="tab-arsip" class="tab-btn px-5 py-3 text-black font-black whitespace-nowrap transition-colors uppercase tracking-widest text-xs md:text-sm active">Manajemen Arsip</button>
        <button onclick="switchTab('form')" id="tab-form" class="tab-btn px-5 py-3 text-gray-600 font-bold whitespace-nowrap transition-colors uppercase tracking-widest text-xs md:text-sm hover:text-black">Manajemen Form Download</button>
        <button onclick="switchTab('users')" id="tab-users" class="tab-btn px-5 py-3 text-gray-600 font-bold whitespace-nowrap transition-colors uppercase tracking-widest text-xs md:text-sm hover:text-black">List Nama Download</button>
    </div>

    <!-- VIEW 1: MANAJEMEN ARSIP -->
    <div id="view-arsip" class="grid grid-cols-1 lg:grid-cols-12 gap-8 relative z-10">
        <!-- Form Add (Kiri) -->
        <div class="lg:col-span-4 bg-[#A3E635] brutal-panel p-6 md:p-8 h-fit">
            <h2 class="text-2xl font-black font-display mb-6 flex items-center gap-2 text-black uppercase tracking-wide border-b-4 border-black pb-3"><i class="ph-bold ph-cloud-arrow-up text-3xl"></i> Ingest Materi Baru</h2>
            <form id="formArsip" class="space-y-5">

                <div>
                    <label class="text-xs text-black font-black mb-2 block uppercase tracking-widest bg-white px-2 py-1 brutal-border w-max">Upload PDF</label>
                    <div id="dropzoneContainer" class="dropzone p-6 text-center cursor-pointer flex flex-col items-center justify-center relative overflow-hidden h-32 group" onclick="document.getElementById('fileInput').click()">
                        <input type="file" id="fileInput" accept=".pdf" class="hidden">
                        <i id="dropIcon" class="ph-bold ph-file-pdf text-4xl text-black mb-2 group-hover:scale-110 transition-transform group-hover:text-red-500"></i>
                        <p id="dropText" class="text-xs font-black text-black">DRAG & DROP PDF DI SINI<br><span class="text-[10px] font-bold mt-1 inline-block">Mendukung file besar langsung via Storage</span></p>
                    </div>
                </div>

                <div>
                    <label class="text-xs text-black font-black mb-1 block uppercase tracking-widest">Judul Dokumen</label>
                    <input type="text" id="title" required class="w-full brutal-input px-4 py-3 text-sm font-bold" placeholder="Contoh: Laporan Kasus Fissure Tongue...">
                </div>

                <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                    <div>
                        <label class="text-xs text-black font-black mb-1 block uppercase tracking-widest">Dept/Bagian</label>
                        <input list="categoryList" id="category" required class="w-full brutal-input px-4 py-3 text-sm font-bold" placeholder="Ketik atau pilih...">
                        <datalist id="categoryList">
                            <option value="Preklinik">
                            <option value="Profesi Dokter Muda">
                            <option value="Jurnal & Riset">
                            <option value="Kedokteran Gigi Umum">
                        </datalist>
                    </div>
                    <div>
                        <label class="text-xs text-black font-black mb-1 block uppercase tracking-widest">Hak Akses URL</label>
                        <select id="accessType" class="w-full brutal-input px-4 py-3 text-sm font-bold cursor-pointer bg-white h-[48px] uppercase">
                            <option value="Restricted" selected>Restricted (Blur)</option>
                            <option value="Open Access">Open Access (Free)</option>
                        </select>
                    </div>
                </div>

                <div>
                    <label class="text-xs text-black font-black mb-1 block uppercase tracking-widest">Deskripsi Singkat</label>
                    <textarea id="desc" rows="4" required class="w-full brutal-input px-4 py-3 text-sm font-bold resize-none" placeholder="Tuliskan rangkuman atau abstrak materi..."></textarea>
                </div>

                <button type="submit" id="btnSubmit" class="w-full bg-[#FF90E8] text-black py-4 brutal-btn mt-4 flex items-center justify-center gap-2 text-lg">
                    <i class="ph-bold ph-database text-xl"></i> PUSH TO STORAGE
                </button>
            </form>
        </div>

        <!-- List Data (Kanan) -->
        <div class="lg:col-span-8 flex flex-col h-[80vh]">
            <div class="flex items-center justify-between mb-4 bg-white brutal-border p-3 shadow-[4px_4px_0px_#000]">
                <div class="flex items-center gap-2">
                    <div class="h-3 w-3 border-2 border-black rounded-full bg-green-400 animate-pulse"></div>
                    <h3 class="text-sm font-black text-black uppercase tracking-widest">System Live Records</h3>
                </div>
                <button onclick="fetchArsip()" class="bg-[#22D3EE] text-black brutal-btn-small px-4 py-2 text-xs flex items-center gap-2 uppercase tracking-widest"><i class="ph-bold ph-arrows-clockwise text-sm"></i> Refresh</button>
            </div>
            <div class="flex-grow overflow-y-auto pr-2 custom-scrollbar space-y-4 pb-10" id="arsipList">
                <div class="brutal-panel p-10 text-center flex flex-col items-center justify-center h-full">
                    <i class="ph-bold ph-spinner-gap animate-spin text-5xl text-black mb-4"></i>
                    <p class="text-black font-black uppercase tracking-widest">Querying Database...</p>
                </div>
            </div>
        </div>
    </div>

    <!-- VIEW 2: MANAJEMEN FORM DOWNLOAD (DYNAMIC BUILDER) -->
    <div id="view-form" class="hidden relative z-10 w-full max-w-4xl mx-auto">
        <div class="bg-[#FF90E8] brutal-panel p-6 md:p-10">
            <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center mb-8 gap-4 border-b-4 border-black pb-6">
                <div>
                    <h2 class="text-3xl font-black font-display text-black flex items-center gap-2 uppercase"><i class="ph-bold ph-toggle-right"></i> Wajib Form Settings</h2>
                    <p class="text-black font-bold text-sm mt-2 max-w-xl bg-white px-2 py-1 brutal-border shadow-[2px_2px_0px_#000] inline-block">Konfigurasi field yg wajib diisi user sebelum download PDF (Restricted).</p>
                </div>
                <div class="flex items-center gap-4 bg-white px-5 py-4 brutal-border shadow-[4px_4px_0px_#000]">
                    <span id="formStatusText" class="text-sm font-black font-mono text-gray-500 uppercase">NONAKTIF</span>
                    <label class="relative inline-flex items-center cursor-pointer">
                        <input type="checkbox" id="toggleRequireForm" class="sr-only peer" onchange="toggleRequireFormStatus()">
                        <div class="w-14 h-7 bg-gray-300 peer-focus:outline-none brutal-border peer peer-checked:after:translate-x-full after:content-[''] after:absolute after:top-[4px] after:left-[4px] after:bg-black after:border-2 after:border-black after:h-4 after:w-4 after:transition-all peer-checked:bg-[#A3E635]"></div>
                    </label>
                </div>
            </div>
            
            <div class="bg-white brutal-border shadow-[6px_6px_0px_#000] p-6 mb-8">
                <h4 class="font-black font-display uppercase text-black text-xl mb-6 flex items-center gap-2 border-b-2 border-black pb-2"><i class="ph-bold ph-list-dashes text-red-500"></i> Struktur Form Aktif</h4>
                <div id="dynamicFieldsList" class="space-y-4 mb-8"></div>
                
                <div class="flex flex-col sm:flex-row gap-3 pt-6 border-t-2 border-black border-dashed">
                    <input type="text" id="newFieldLabel" placeholder="Contoh: Nomor Induk Mahasiswa (NIM)" class="flex-grow brutal-input px-4 py-4 text-sm font-bold placeholder-gray-500">
                    <button type="button" onclick="addField()" class="bg-[#22D3EE] text-black brutal-btn px-8 py-4 text-sm flex items-center justify-center gap-2">
                        <i class="ph-bold ph-plus text-lg"></i> Tambah Field
                    </button>
                </div>
                <p class="text-[11px] text-black font-bold mt-3 bg-[#FDE047] inline-block px-2 border-2 border-black">* ID Field dibuat otomatis berdasarkan Label. Silakan tambah sesuka hati.</p>
            </div>

            <button onclick="saveFormSettings()" id="btnSaveSettings" class="w-full bg-[#A3E635] text-black py-5 brutal-btn text-lg flex items-center justify-center gap-2">
                <i class="ph-bold ph-floppy-disk text-2xl"></i> SIMPAN KONFIGURASI FORM
            </button>
        </div>
    </div>

    <!-- VIEW 3: LIST NAMA DOWNLOAD (USERS & RIWAYAT) -->
    <div id="view-users" class="hidden relative z-10 w-full">
        <div class="bg-white brutal-panel p-6 md:p-8">
            <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center mb-8 gap-4 border-b-4 border-black pb-6">
                <div>
                    <h2 class="text-3xl font-black font-display text-black flex items-center gap-2 uppercase"><i class="ph-bold ph-users text-[#22D3EE]"></i> Pengunduh Terverifikasi</h2>
                    <p class="text-black font-bold text-sm mt-2 bg-[#FDE047] px-2 py-1 brutal-border shadow-[2px_2px_0px_#000] inline-block">Daftar pengguna login Google & riwayat dokumen yang diunduh.</p>
                </div>
                <button onclick="fetchUsers()" class="bg-[#22D3EE] text-black brutal-btn px-6 py-3 text-sm flex items-center gap-2 shrink-0"><i class="ph-bold ph-arrows-clockwise text-lg"></i> Refresh Tabel</button>
            </div>
            
            <div class="overflow-x-auto brutal-border shadow-[6px_6px_0px_#000] custom-scrollbar bg-white">
                <table class="w-full text-left text-sm text-black whitespace-nowrap">
                    <thead id="userTableHead" class="text-xs uppercase bg-[#A3E635] text-black font-black tracking-widest border-b-4 border-black">
                        <!-- Dynamic Headers Diinjeksi via JS -->
                    </thead>
                    <tbody id="usersList" class="divide-y-2 divide-black bg-white">
                        <tr><td colspan="10" class="px-6 py-12 text-center"><i class="ph-bold ph-spinner-gap animate-spin text-4xl text-black"></i></td></tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- MODAL EDIT DATA ARSIP (FULL CRUD) -->
    <div id="editModal" class="fixed inset-0 z-[9999] hidden bg-black/60 backdrop-blur-sm flex items-center justify-center p-4 overflow-y-auto">
        <div class="bg-[#22D3EE] brutal-panel w-full max-w-2xl p-6 md:p-10 modal-enter relative my-8">
            <button onclick="tutupEdit()" class="absolute top-4 right-4 bg-white brutal-border p-2 hover:bg-red-500 hover:text-white transition-colors shadow-[2px_2px_0px_#000] active:translate-y-1 active:shadow-none"><i class="ph-bold ph-x text-xl"></i></button>

            <h2 class="text-3xl font-black font-display mb-6 flex items-center gap-2 text-black uppercase border-b-4 border-black pb-4"><i class="ph-bold ph-pencil-simple text-red-500"></i> Edit Metadata Arsip</h2>

            <form id="formEdit" class="space-y-5">
                <input type="hidden" id="editId">
                <div>
                    <label class="text-xs text-black font-black mb-1 block uppercase tracking-widest">Judul Dokumen</label>
                    <input type="text" id="editTitle" required class="w-full brutal-input px-4 py-3 text-sm font-bold">
                </div>
                <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                    <div>
                        <label class="text-xs text-black font-black mb-1 block uppercase tracking-widest">Kategori Dept/Bagian</label>
                        <input list="categoryList" id="editCategory" required class="w-full brutal-input px-4 py-3 text-sm font-bold">
                    </div>
                    <div>
                        <label class="text-xs text-black font-black mb-1 block uppercase tracking-widest">Hak Akses URL</label>
                        <select id="editAccessType" class="w-full brutal-input px-4 py-3 text-sm font-bold cursor-pointer h-[48px] uppercase">
                            <option value="Restricted">Restricted (Blur)</option>
                            <option value="Open Access">Open Access (Free)</option>
                        </select>
                    </div>
                </div>
                <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                    <div>
                        <label class="text-xs text-black font-black mb-1 block uppercase tracking-widest">URL Slug (SEO)</label>
                        <input type="text" id="editSlug" required class="w-full brutal-input px-4 py-3 text-sm font-bold text-blue-700 bg-blue-50">
                    </div>
                    <div>
                        <label class="text-xs text-black font-black mb-1 block uppercase tracking-widest">Tanggal Upload</label>
                        <input type="text" id="editDate" required class="w-full brutal-input px-4 py-3 text-sm font-bold h-[48px]">
                    </div>
                </div>
                <div>
                    <label class="text-xs text-black font-black mb-1 block uppercase tracking-widest">Deskripsi / Abstrak Singkat</label>
                    <textarea id="editDesc" rows="4" required class="w-full brutal-input px-4 py-3 text-sm font-bold resize-none"></textarea>
                </div>
                <button type="submit" id="btnEditSubmit" class="w-full bg-[#FF90E8] text-black py-4 brutal-btn mt-6 flex items-center justify-center gap-2 text-lg">
                    <i class="ph-bold ph-floppy-disk text-xl"></i> SIMPAN PERUBAHAN
                </button>
            </form>
        </div>
    </div>

    <script>
        const token = localStorage.getItem('axa_arsip_token');
        if (!token) { try { window.location.href = '/admin/login'; } catch (e) {} }

        const SUPABASE_URL = "<%= typeof supabaseUrl !== 'undefined' ? supabaseUrl : '' %>"; 
        const SUPABASE_ANON_KEY = "<%= typeof supabaseAnonKey !== 'undefined' ? supabaseAnonKey : '' %>"; 

        let supabaseClient = null;
        let globalArsipData = []; 
        let globalFormSettings = { requireForm: true, fields: [] };

        if (SUPABASE_URL && SUPABASE_ANON_KEY) {
            try { supabaseClient = window.supabase.createClient(SUPABASE_URL, SUPABASE_ANON_KEY); } catch (e) { }
        }

        // --- SISTEM TABS NAVIGATION NEUBRUTALISM ---
        function switchTab(tabId) {
            ['arsip', 'form', 'users'].forEach(id => {
                document.getElementById(`view-${id}`).classList.add('hidden');
                const btn = document.getElementById(`tab-${id}`);
                
                // Reset styling ke non-active
                btn.classList.remove('active', 'text-black', 'font-black');
                btn.classList.add('text-gray-600', 'font-bold');
            });

            const activeBtn = document.getElementById(`tab-${tabId}`);
            activeBtn.classList.remove('text-gray-600', 'font-bold');
            activeBtn.classList.add('active', 'text-black', 'font-black');
            
            document.getElementById(`view-${tabId}`).classList.remove('hidden');

            if(tabId === 'users') fetchUsers();
            if(tabId === 'form') fetchFormSetting();
        }

        // ==========================================
        // FITUR BARU: MANAJEMEN FORM & TABLE USER
        // ==========================================

        async function fetchFormSetting() {
            try {
                const res = await fetch('/api/settings/form', { headers: { 'Authorization': token } });
                const data = await res.json();
                
                if (data.requireForm && typeof data.requireForm === 'object') {
                    globalFormSettings = data.requireForm;
                } else {
                    globalFormSettings = {
                        requireForm: data.requireForm !== undefined ? data.requireForm : true,
                        fields: [
                            { id: 'nama_lengkap', label: 'Nama Lengkap (Sesuai KTP/Gelar)' },
                            { id: 'institusi_asal', label: 'Asal Universitas / Instansi' }
                        ]
                    };
                }
                renderFormSettingsUI();
                renderUserTableHeader();
            } catch(e) { console.error("Gagal load Form Settings", e); }
        }

        function toggleRequireFormStatus() {
            globalFormSettings.requireForm = document.getElementById('toggleRequireForm').checked;
            renderFormSettingsUI();
        }

        function renderFormSettingsUI() {
            const isReq = globalFormSettings.requireForm;
            document.getElementById('toggleRequireForm').checked = isReq;
            
            const statusText = document.getElementById('formStatusText');
            statusText.innerHTML = isReq ? "AKTIF" : "NONAKTIF";
            statusText.className = isReq ? "text-sm font-black font-mono text-green-600 uppercase" : "text-sm font-black font-mono text-red-500 uppercase";
            
            const listEl = document.getElementById('dynamicFieldsList');
            if (globalFormSettings.fields.length === 0) {
                listEl.innerHTML = '<div class="text-center text-black font-black text-sm py-6 bg-gray-100 brutal-border border-dashed">Belum ada field formulir.</div>';
            } else {
                listEl.innerHTML = globalFormSettings.fields.map((f, i) => `
                    <div class="flex justify-between items-center bg-gray-100 brutal-border px-5 py-4 hover:bg-[#FDE047] transition-colors shadow-[4px_4px_0px_#000]">
                        <div>
                            <span class="text-base font-black text-black block uppercase">${f.label}</span>
                            <span class="text-[10px] text-black font-bold font-mono bg-white px-2 border-2 border-black inline-block mt-1">ID: ${f.id}</span>
                        </div>
                        <button type="button" onclick="removeField(${i})" class="bg-white border-4 border-black hover:bg-red-500 hover:text-white p-2.5 transition-all shadow-[2px_2px_0px_#000] active:translate-y-1 active:shadow-none" title="Hapus Field"><i class="ph-bold ph-trash text-xl"></i></button>
                    </div>
                `).join('');
            }
        }

        function addField() {
            const input = document.getElementById('newFieldLabel');
            const label = input.value.trim();
            if(!label) return;
            
            const id = label.toLowerCase().replace(/[^a-z0-9]+/g, '_').replace(/^_|_$/g, '');
            globalFormSettings.fields.push({ id, label });
            input.value = '';
            renderFormSettingsUI();
            renderUserTableHeader();
        }

        function removeField(index) {
            globalFormSettings.fields.splice(index, 1);
            renderFormSettingsUI();
            renderUserTableHeader();
        }

        async function saveFormSettings() {
            const btn = document.getElementById('btnSaveSettings');
            const ori = btn.innerHTML;
            btn.innerHTML = '<i class="ph-bold ph-spinner-gap animate-spin text-2xl"></i> MENYIMPAN KONFIGURASI...';
            btn.disabled = true;

            try {
                const res = await fetch('/api/settings/form', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json', 'Authorization': token },
                    body: JSON.stringify({ requireForm: globalFormSettings })
                });
                if(!res.ok) throw new Error("Gagal terhubung ke API Settings.");
                alert('Konfigurasi Dynamic Form berhasil disimpan ke Cloud Storage!');
                fetchUsers(); 
            } catch (err) {
                alert("Gagal update konfigurasi: " + err.message);
            } finally {
                btn.innerHTML = ori;
                btn.disabled = false;
            }
        }

        function renderUserTableHeader() {
            let th = `<th class="px-6 py-5 border-r-2 border-black">Status</th>`;
            th += `<th class="px-6 py-5 border-r-2 border-black">Email Google</th>`;
            
            globalFormSettings.fields.forEach(f => {
                th += `<th class="px-6 py-5 border-r-2 border-black">${f.label}</th>`;
            });

            th += `<th class="px-6 py-5 border-r-2 border-black">Riwayat Download PDF</th>`;
            th += `<th class="px-6 py-5 border-r-2 border-black">Last Online (WITA)</th>`;
            th += `<th class="px-6 py-5 text-center">Aksi (Manajemen)</th>`;
            
            document.getElementById('userTableHead').innerHTML = `<tr>${th}</tr>`;
        }

        async function fetchUsers() {
            if(!globalFormSettings.fields || globalFormSettings.fields.length === 0) await fetchFormSetting();

            const listEl = document.getElementById('usersList');
            const colSpan = 5 + globalFormSettings.fields.length;
            listEl.innerHTML = `<tr><td colspan="${colSpan}" class="px-6 py-16 text-center"><i class="ph-bold ph-spinner-gap animate-spin text-4xl text-black"></i></td></tr>`;
            
            try {
                const res = await fetch('/api/users', { headers: { 'Authorization': token } });
                const dataRaw = await res.json();
                if(!res.ok) throw new Error(dataRaw.message);
                
                const users = dataRaw.data;
                if(users.length === 0) {
                    listEl.innerHTML = `<tr><td colspan="${colSpan}" class="px-6 py-16 text-center text-black font-black uppercase text-xl border-t border-black bg-gray-100">Belum ada user yang terdaftar.</td></tr>`;
                    return;
                }

                listEl.innerHTML = users.map(u => {
                    // Badge Status Sesi Neubrutalism
                    const statusBadge = u.status === 'Aktif' 
                        ? `<span class="bg-[#A3E635] text-black px-3 py-2 text-xs font-black border-2 border-black flex items-center gap-2 w-max shadow-[2px_2px_0px_#000] uppercase"><div class="w-2.5 h-2.5 bg-white border border-black rounded-full animate-pulse"></div> Aktif</span>` 
                        : `<span class="bg-gray-200 text-gray-500 px-3 py-2 text-xs font-black border-2 border-gray-400 flex items-center gap-2 w-max uppercase"><div class="w-2.5 h-2.5 bg-gray-400 rounded-full"></div> Logout</span>`;

                    let row = `<td class="px-6 py-5 border-r-2 border-black">${statusBadge}</td>`;
                    row += `<td class="px-6 py-5 text-blue-700 font-bold border-r-2 border-black">${u.email}</td>`;
                    
                    globalFormSettings.fields.forEach(f => {
                        const val = (u.raw_metadata && u.raw_metadata[f.id]) || (f.id === 'nama_lengkap' ? u.name : null) || (f.id === 'institusi_asal' ? u.institution : null) || '-';
                        row += `<td class="px-6 py-5 text-black font-bold border-r-2 border-black">${val}</td>`;
                    });

                    // Render Riwayat Download Neubrutalism
                    const downloads = u.downloaded_files && u.downloaded_files.length > 0 
                        ? u.downloaded_files.map(fileStr => `<span class="bg-[#22D3EE] text-black text-[10px] px-3 py-2 border-2 border-black whitespace-nowrap mb-2 mr-2 block w-max font-black shadow-[2px_2px_0px_#000] uppercase tracking-wide"><i class="ph-bold ph-file-pdf text-red-600"></i> ${fileStr}</span>`).join('') 
                        : '<span class="bg-gray-200 text-black px-3 py-1 border-2 border-black font-bold text-xs">Belum pernah unduh</span>';

                    row += `<td class="px-6 py-5 border-r-2 border-black"><div class="flex flex-col gap-1 w-max">${downloads}</div></td>`;
                    
                    // Render Last Online (WITA)
                    row += `<td class="px-6 py-5 border-r-2 border-black text-xs font-black font-mono text-black w-max whitespace-nowrap bg-[#FDE047]/20">${u.last_online}</td>`;

                    // Render Tombol Aksi (Force Logout) Neubrutalism
                    const actionBtn = u.status === 'Aktif' 
                        ? `<button onclick="forceLogoutUser('${u.id}')" class="bg-[#FF90E8] brutal-btn hover:bg-red-500 hover:text-white px-4 py-3 text-xs w-full flex justify-center items-center gap-2"><i class="ph-bold ph-power text-base"></i> PAKSA LOGOUT</button>`
                        : `<button disabled class="bg-gray-200 text-gray-500 border-4 border-gray-300 px-4 py-3 rounded-lg text-xs font-black w-full flex justify-center items-center gap-2 cursor-not-allowed uppercase"><i class="ph-bold ph-check text-base"></i> Aman</button>`;
                        
                    row += `<td class="px-6 py-5 bg-gray-50">${actionBtn}</td>`;

                    return `<tr class="hover:bg-[#FDE047]/30 transition-colors">${row}</tr>`;
                }).join('');
            } catch (err) {
                listEl.innerHTML = `<tr><td colspan="${colSpan}" class="px-6 py-12 text-center text-red-500 font-bold bg-red-50 border-y-4 border-red-500"><i class="ph-fill ph-warning-circle text-3xl mb-2"></i><br>${err.message}</td></tr>`;
            }
        }

        async function forceLogoutUser(userId) {
            if(!confirm("Anda yakin ingin memutuskan sesi Google pengguna ini secara paksa?")) return;
            try {
                const res = await fetch(`/api/users/${userId}/force-logout`, {
                    method: 'POST', headers: { 'Authorization': token }
                });
                if(!res.ok) throw new Error("Gagal melakukan aksi paksa logout ke Database Supabase.");
                fetchUsers(); 
            } catch (e) { alert(e.message); }
        }

        // ==========================================
        // UPLOAD & CRUD ARSIP LOGIC (EXISTING)
        // ==========================================

        let selectedFile = null;
        const dropzone = document.getElementById('dropzoneContainer');
        const fileInput = document.getElementById('fileInput');
        const dropText = document.getElementById('dropText');
        const dropIcon = document.getElementById('dropIcon');

        ['dragenter', 'dragover', 'dragleave', 'drop'].forEach(eventName => {
            dropzone.addEventListener(eventName, e => { e.preventDefault(); e.stopPropagation(); }, false);
        });
        dropzone.addEventListener('dragover', () => dropzone.classList.add('dragover'));
        dropzone.addEventListener('dragleave', () => dropzone.classList.remove('dragover'));
        dropzone.addEventListener('drop', e => { dropzone.classList.remove('dragover'); handleFiles(e.dataTransfer.files); });
        fileInput.addEventListener('change', e => { handleFiles(e.target.files); });

        function handleFiles(files) {
            if (files.length === 0) return;
            const file = files[0];
            if (file.type !== "application/pdf") return alert("Hanya file PDF yang diizinkan!");

            selectedFile = file;
            dropText.innerHTML = `<span class="text-black font-black uppercase">${file.name}</span><br><span class="text-gray-600 bg-white px-2 border-2 border-black inline-block mt-2 font-bold">${(file.size/1024/1024).toFixed(2)} MB Ready (Unlimited Storage)</span>`;
            dropIcon.className = "ph-bold ph-check-circle text-5xl text-green-500 mb-2";
            dropzone.classList.add('has-file');
        }

        async function fetchArsip() {
            const listEl = document.getElementById('arsipList');
            try {
                const res = await fetch('/api/arsip', { headers: { 'Authorization': token } });
                if (!res.ok) {
                    const errRes = await res.json();
                    throw new Error(errRes.message || "Gagal mengambil data dari server.");
                }

                const { data } = await res.json();
                globalArsipData = data; 
                populateCategoryDatalist(data);

                if(data.length === 0) { 
                    listEl.innerHTML = '<div class="brutal-panel p-10 text-center font-black uppercase text-xl">Database kosong. Mulai Upload!</div>'; 
                    return; 
                }

                const formatDateStr = (dateStr) => {
                    if(dateStr && dateStr.match(/^\d{4}-\d{2}-\d{2}$/)) {
                        const parts = dateStr.split('-'); return `${parts[2]}-${parts[1]}-${parts[0]}`;
                    }
                    return dateStr;
                };

                listEl.innerHTML = data.map(item => {
                    const displayDate = formatDateStr(item.date);
                    const accessColor = item.access_type === 'Open Access' ? 'bg-[#A3E635] text-black' : 'bg-[#FFC900] text-black';
                    return `
                    <div class="brutal-card p-5 md:p-6 flex flex-col md:flex-row justify-between items-start md:items-center gap-6 relative overflow-hidden group">
                        <div class="min-w-0 w-full z-10">
                            <div class="flex gap-2 mb-3 flex-wrap">
                                <span class="text-[10px] bg-[#22D3EE] text-black border-2 border-black px-3 py-1 font-black uppercase tracking-widest shadow-[2px_2px_0px_#000]">${item.category}</span>
                                <span class="text-[10px] ${accessColor} border-2 border-black px-3 py-1 font-black uppercase tracking-widest shadow-[2px_2px_0px_#000]">${item.access_type || 'Restricted'}</span>
                            </div>
                            <h3 class="text-xl md:text-2xl font-black font-display mt-2 break-words w-full text-black leading-tight uppercase">${item.title}</h3>
                            <p class="text-black text-[11px] md:text-xs break-words font-bold font-mono mt-3 w-full flex flex-wrap gap-3 items-center">
                                <span class="bg-gray-100 border-2 border-black px-2 py-1"><i class="ph-bold ph-link"></i> /${item.slug}</span> 
                                <span class="bg-gray-100 border-2 border-black px-2 py-1"><i class="ph-bold ph-calendar"></i> ${displayDate}</span>
                            </p>
                        </div>
                        <div class="flex gap-3 z-10 shrink-0 w-full md:w-auto mt-2 md:mt-0 justify-end border-t-2 border-dashed border-gray-300 md:border-none pt-4 md:pt-0">
                            <button onclick="bukaEdit('${item.id}')" class="bg-[#FDE047] text-black p-3 brutal-btn-small" title="Edit Metadata Terlengkap"><i class="ph-bold ph-pencil-simple text-xl"></i></button>
                            <a href="/arsip/${item.slug}" target="_blank" class="bg-[#22D3EE] text-black p-3 brutal-btn-small flex items-center justify-center" title="View Article Page"><i class="ph-bold ph-arrow-square-out text-xl"></i></a>
                            <button onclick="hapus('${item.id}')" class="bg-[#FF90E8] text-black p-3 brutal-btn-small" title="Hapus Permanen"><i class="ph-bold ph-trash text-xl"></i></button>
                        </div>
                    </div>
                `}).join('');
            } catch (error) {
                listEl.innerHTML = `<div class="brutal-panel p-8 text-center text-red-500 font-black uppercase text-xl border-red-500"><i class="ph-bold ph-warning-circle text-4xl mb-3"></i><br>${error.message}</div>`;
            }
        }

        function populateCategoryDatalist(data) {
            const defaultCats = ["Preklinik", "Profesi Dokter Muda", "Jurnal & Riset", "Kedokteran Gigi Umum"];
            const dbCats = data.map(item => item.category).filter(Boolean);
            const uniqueCategories = [...new Set([...defaultCats, ...dbCats])];
            document.getElementById('categoryList').innerHTML = uniqueCategories.map(cat => `<option value="${cat}">`).join('');
        }

        document.getElementById('formArsip').addEventListener('submit', async (e) => {
            e.preventDefault();
            if(!selectedFile) return alert("Harap pilih file PDF terlebih dahulu!");

            const btn = document.getElementById('btnSubmit');
            const ogText = btn.innerHTML;

            if (!supabaseClient) {
                alert("SISTEM TERKUNCI: Environment Variables (SUPABASE_URL & ANON_KEY) tidak ditemukan.");
                return;
            }

            btn.innerHTML = '<i class="ph-bold ph-spinner-gap animate-spin text-xl"></i> UPLOADING...';
            btn.disabled = true;

            try {
                const uniqueId = Date.now().toString();
                const cleanFileName = selectedFile.name.replace(/[^a-zA-Z0-9.-]/g, '_');
                const filePath = `${uniqueId}_${cleanFileName}`;

                const { error: storageError } = await supabaseClient.storage.from('arsip_files').upload(filePath, selectedFile, { cacheControl: '3600', upsert: false });
                if (storageError) throw new Error("Upload Storage Gagal: " + storageError.message);

                const payload = {
                    id: uniqueId, title: document.getElementById('title').value, category: document.getElementById('category').value,
                    desc: document.getElementById('desc').value, accessType: document.getElementById('accessType').value,
                    fileName: selectedFile.name, filePath: filePath
                };

                const res = await fetch('/api/arsip', { 
                    method: 'POST', headers: { 'Content-Type': 'application/json', 'Authorization': token }, body: JSON.stringify(payload) 
                });
                if (!res.ok) throw new Error("Database Gagal");

                document.getElementById('formArsip').reset();
                selectedFile = null;
                dropzone.classList.remove('has-file');
                dropIcon.className = "ph-bold ph-file-pdf text-4xl text-black mb-2 group-hover:scale-110 transition-transform group-hover:text-red-500";
                dropText.innerHTML = `DRAG & DROP PDF DI SINI<br><span class="text-[10px] font-bold mt-1 inline-block">Mendukung file besar langsung via Storage</span>`;
                fetchArsip(); 
            } catch (err) { alert(err.message); } finally { btn.innerHTML = ogText; btn.disabled = false; }
        });

        function bukaEdit(id) {
            const item = globalArsipData.find(x => x.id === id);
            if(!item) return;

            document.getElementById('editId').value = item.id;
            document.getElementById('editTitle').value = item.title;
            document.getElementById('editCategory').value = item.category;
            document.getElementById('editDesc').value = item.desc;
            document.getElementById('editAccessType').value = item.access_type || 'Restricted';
            document.getElementById('editSlug').value = item.slug;

            let editDisplayDate = item.date;
            if(editDisplayDate && editDisplayDate.match(/^\d{4}-\d{2}-\d{2}$/)) {
                const parts = editDisplayDate.split('-'); editDisplayDate = `${parts[2]}-${parts[1]}-${parts[0]}`;
            }
            document.getElementById('editDate').value = editDisplayDate;
            document.getElementById('editModal').classList.remove('hidden');
        }

        function tutupEdit() {
            document.getElementById('editModal').classList.add('hidden');
            document.getElementById('formEdit').reset();
        }

        document.getElementById('formEdit').addEventListener('submit', async (e) => {
            e.preventDefault();
            const btn = document.getElementById('btnEditSubmit');
            const ogText = btn.innerHTML;
            btn.innerHTML = '<i class="ph-bold ph-spinner-gap animate-spin text-xl"></i> MENYIMPAN...'; btn.disabled = true;

            const docId = document.getElementById('editId').value;
            let safeSlug = document.getElementById('editSlug').value.trim().toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/(^-|-$)+/g, '');

            const payload = {
                title: document.getElementById('editTitle').value, category: document.getElementById('editCategory').value,
                desc: document.getElementById('editDesc').value, accessType: document.getElementById('editAccessType').value,
                slug: safeSlug, date: document.getElementById('editDate').value.trim()
            };

            try {
                const res = await fetch(`/api/arsip/${docId}`, {
                    method: 'PUT', headers: { 'Content-Type': 'application/json', 'Authorization': token }, body: JSON.stringify(payload)
                });
                if(!res.ok) throw new Error("Gagal mengupdate data.");
                tutupEdit(); fetchArsip(); 
            } catch (err) { alert(err.message); } finally { btn.innerHTML = ogText; btn.disabled = false; }
        });

        async function hapus(id) {
            if(!confirm('Hapus permanen dokumen & file PDF ini dari Storage dan Database?')) return;
            try {
                const res = await fetch('/api/arsip/'+id, { method: 'DELETE', headers: { 'Authorization': token } });
                if(!res.ok) throw new Error("Gagal hapus");
                fetchArsip(); 
            } catch (e) { alert(e.message); }
        }

        function logout() {
            localStorage.removeItem('axa_arsip_token');
            window.location.href = '/admin/login';
        }

        // Initialize Data on Load
        fetchArsip();
        fetchFormSetting(); 
    </script>
</body>
</html>
