<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= meta.title %></title>
    <meta name="description" content="<%= meta.desc %>">
    <link rel="canonical" href="<%= meta.canonical %>">
    <script src="https://cdn.tailwindcss.com"></script>
    <script src="https://unpkg.com/@phosphor-icons/web"></script>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;700;800&family=Space+Grotesk:wght@700&display=swap" rel="stylesheet">
    <style>
        body { background-color: #030712; color: #fff; font-family: 'Plus Jakarta Sans', sans-serif; }
        .glass-header { background: rgba(3, 7, 18, 0.8); backdrop-filter: blur(20px); border-bottom: 1px solid rgba(255,255,255,0.1); }
        .card-neo { background: #0f172a; border: 1px solid rgba(255,255,255,0.05); transition: all 0.3s; }
        .card-neo:hover { transform: translateY(-5px); border-color: #00E5FF; box-shadow: 0 10px 30px rgba(0,229,255,0.15); }
    </style>
</head>
<body class="antialiased selection:bg-cyan-500 selection:text-black">
    
    <nav class="glass-header sticky top-0 z-50 w-full">
        <div class="container mx-auto px-4 py-4 flex justify-between items-center max-w-6xl">
            <a href="/" class="text-xl font-bold font-['Space_Grotesk'] text-cyan-400 flex items-center gap-2">
                <i class="ph-bold ph-arrow-left"></i> Axa System
            </a>
            <span class="text-xs font-mono text-gray-400 bg-white/5 px-3 py-1 rounded-full border border-white/10">KNOWLEDGE BASE</span>
        </div>
    </nav>

    <main class="container mx-auto px-4 py-12 max-w-5xl min-h-screen">
        <header class="text-center mb-16">
            <h1 class="text-4xl md:text-5xl font-black font-['Space_Grotesk'] mb-4">Arsip Materi <span class="text-transparent bg-clip-text bg-gradient-to-r from-cyan-400 to-purple-500">& Jurnal</span></h1>
            <p class="text-gray-400 max-w-2xl mx-auto">Akses direktori catatan pembelajaran, materi preklinik, jurnal profesi dokter muda, dan publikasi penelitian.</p>
        </header>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            <% if(arsipData && arsipData.length > 0) { %>
                <% arsipData.forEach(item => { %>
                    <a href="/arsip/<%= item.slug %>" class="card-neo p-6 rounded-2xl block group">
                        <div class="flex justify-between items-start mb-4">
                            <span class="text-[10px] font-mono font-bold uppercase tracking-widest text-cyan-400 bg-cyan-400/10 px-3 py-1 rounded border border-cyan-400/20"><%= item.category %></span>
                            <span class="text-xs text-gray-500 font-mono"><i class="ph-fill ph-calendar-blank"></i> <%= item.date %></span>
                        </div>
                        <h2 class="text-xl font-black mb-3 group-hover:text-cyan-400 transition-colors line-clamp-2"><%= item.title %></h2>
                        <p class="text-sm text-gray-400 line-clamp-3 mb-6 leading-relaxed"><%= item.desc %></p>
                        <div class="flex items-center text-xs font-bold text-white group-hover:text-cyan-400 gap-2">
                            Akses Dokumen <i class="ph-bold ph-arrow-right group-hover:translate-x-1 transition-transform"></i>
                        </div>
                    </a>
                <% }) %>
            <% } else { %>
                <div class="col-span-full text-center py-20 border border-dashed border-gray-800 rounded-3xl">
                    <i class="ph-fill ph-folder-open text-4xl text-gray-600 mb-4 block"></i>
                    <p class="text-gray-400 font-mono">Belum ada materi diarsipkan di sistem publik.</p>
                </div>
            <% } %>
        </div>
    </main>

    <footer class="border-t border-white/10 text-center py-8 text-gray-500 font-mono text-xs">
        &copy; 2026 drg. M. Aksa Arsyad, S.KG. | Knowledge Base System
    </footer>
</body>
</html>
