                                </div>
                            <% } else { %>
                                <div class="flex items-center gap-2">
                                    <i class="ph-bold ph-lock-key text-black text-xl"></i>
                                    <span class="text-xs font-black text-black uppercase tracking-wide">Restricted</span>
                                </div>
                                <div class="bg-white p-1.5 border-2 border-black shadow-[2px_2px_0px_#000] rounded transition-transform group-hover:translate-x-1">
                                    <i class="ph-bold ph-arrow-right text-black text-lg"></i>
                                </div>
                            <% } %>
