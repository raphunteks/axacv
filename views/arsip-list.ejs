                <div class="col-span-full text-center py-20 brutal-border bg-white shadow-[8px_8px_0px_#000] rounded-xl w-full px-4 animate__animated animate__fadeIn">
                    <i class="ph-bold ph-folder-open text-6xl md:text-7xl text-black mb-5 block"></i>
                    <h3 class="text-2xl md:text-4xl font-black font-display text-black mb-3 uppercase">Direktori Kosong</h3>
                    <p class="text-black font-bold text-sm md:text-base bg-[#FDE047] inline-block px-4 py-2 border-2 border-black shadow-[2px_2px_0px_#000]">Belum ada materi atau jurnal yang diarsipkan dalam kategori ini.</p>
