<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=5.0">
    <title><%= meta.title %></title>
    
    <meta name="description" content="<%= meta.desc %>">
    <link rel="canonical" href="<%= meta.canonical %>">
    
    <link rel="icon" type="image/png" href="/axalogo.png">
    <link rel="apple-touch-icon" href="/axalogo.png">

    <meta property="og:title" content="<%= meta.title %>">
    <meta property="og:description" content="<%= meta.desc %>">
    <meta property="og:image" content="<%= baseUrl %><%= meta.ogImage %>">
    <meta property="og:url" content="<%= meta.canonical %>">
    <meta property="og:type" content="<%= meta.type %>">

    <% 
        // Helper Parser Date Khusus Google (ISO 8601 & YYYY/MM/DD)
        let isoDate = (typeof arsip !== 'undefined' && arsip.date) ? arsip.date : new Date().toISOString();
        let scholarDate = isoDate;
        let displayDate = isoDate; 
        
        if(isoDate && isoDate.match(/^\d{2}-\d{2}-\d{4}$/)) {
            const parts = isoDate.split('-');
            isoDate = `${parts[2]}-${parts[1]}-${parts[0]}`; 
            scholarDate = `${parts[2]}/${parts[1]}/${parts[0]}`; 
            displayDate = parts.join('-'); 
        } else if (isoDate && isoDate.match(/^\d{4}-\d{2}-\d{2}$/)) {
            const parts = isoDate.split('-');
            displayDate = `${parts[2]}-${parts[1]}-${parts[0]}`; 
            scholarDate = isoDate.replace(/-/g, '/');
        }
        
        // 🌟 GSC JSON PROTECTOR
        const safeTitle = (typeof arsip !== 'undefined' && arsip.title ? arsip.title : meta.title).replace(/"/g, '\\"').replace(/(\r\n|\n|\r)/gm, " ");
        const safeDesc = (typeof arsip !== 'undefined' && arsip.desc ? arsip.desc : meta.desc).replace(/"/g, '\\"').replace(/(\r\n|\n|\r)/gm, " ");
        const isFree = (typeof arsip !== 'undefined' && arsip.access_type === 'Open Access') ? 'true' : 'false';

        // 🌟 HELPER SITELINKS SEO: Mem-parsing Artikel untuk Google Sitelinks
        const jsonLdItems = typeof arsipData !== 'undefined' ? arsipData.slice(0, 15).map((item, index) => ({
            "@type": "ListItem",
            "position": index + 1,
            "url": `${baseUrl}/arsip/${item.slug}`,
            "name": item.title
        })) : [];

        // 🌟 HELPER SITELINKS SEO: Mem-parsing Kategori Dinamis untuk Navigasi Google Sitelinks
        const sitelinkCategories = typeof categories !== 'undefined' ? categories.map((kat, index) => ({
            "@type": "SiteNavigationElement",
            "position": index + 1,
            "name": kat,
            "url": `${baseUrl}/arsip/kategori/${createSlug(kat)}`
        })) : [];
    %>

    <!-- JSON-LD STRUCTURED DATA (WITH SITELINKS GENERATOR) -->
    <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@graph": [
        {
          "@type": "WebSite",
          "@id": "<%= baseUrl %>/#website",
          "url": "<%= baseUrl %>/",
          "name": "Knowledge Base drg. M. Aksa Arsyad",
          "potentialAction": {
            "@type": "SearchAction",
            "target": "<%= baseUrl %>/arsip?q={search_term_string}",
            "query-input": "required name=search_term_string"
          }
        },
        {
          "@type": "CollectionPage",
          "@id": "<%= meta.canonical %>#webpage",
          "url": "<%= meta.canonical %>",
          "name": "<%= meta.title %>",
          "description": "<%= meta.desc %>",
          "inLanguage": "id-ID",
          "publisher": {
            "@type": "Person",
            "name": "drg. M. Aksa Arsyad, S.KG",
            "logo": {
              "@type": "ImageObject",
              "url": "<%= baseUrl %>/axalogo.png"
            }
          }
        },
        {
          "@type": "BreadcrumbList",
          "@id": "<%= meta.canonical %>#breadcrumb",
          "itemListElement": [
            { "@type": "ListItem", "position": 1, "name": "Beranda", "item": "<%= baseUrl %>/" },
            { "@type": "ListItem", "position": 2, "name": "Arsip Materi", "item": "<%= baseUrl %>/arsip" }
            <% if (activeCategory !== 'semua') { %>
            ,{ "@type": "ListItem", "position": 3, "name": "<%= activeCategory.replace(/-/g, ' ').toUpperCase() %>", "item": "<%= meta.canonical %>" }
            <% } %>
          ]
        },
        {
          "@type": "ItemList",
          "name": "Daftar Kategori Navigasi (Sitelinks)",
          "itemListElement": <%- JSON.stringify(sitelinkCategories) %>
        },
        {
          "@type": "ItemList",
          "name": "Daftar Artikel Arsip",
          "itemListElement": <%- JSON.stringify(jsonLdItems) %>
        }
      ]
    }
    </script>

    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/animate.css/4.1.1/animate.min.css"/>
    <script src="https://cdn.tailwindcss.com"></script>
    <script src="https://unpkg.com/@phosphor-icons/web"></script>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;700;800;900&family=Space+Grotesk:wght@700;900&display=swap" rel="stylesheet">
    
    <style>
        /* NEUBRUTALISM BASE */
        body { 
            background-color: #f4f4f0; /* Off-white playful */
            color: #000; 
            font-family: 'Plus Jakarta Sans', sans-serif; 
            overflow-x: hidden; 
            min-height: 100vh;
            background-image: radial-gradient(#000 1px, transparent 1px);
            background-size: 24px 24px;
        }
        
        .font-display { font-family: 'Space Grotesk', sans-serif; }

        .brutal-border { border: 4px solid #000; }
        .brutal-shadow { box-shadow: 4px 4px 0px #000; transition: all 0.2s ease-in-out; }
        
        /* HEADER NAV */
        .glass-header { 
            background: #A3E635; /* Lime green */
            border-bottom: 4px solid #000; 
        }
        
        /* CARD UI NEUBRUTALISM */
        .card-neo { 
            background: #fff; 
            border: 4px solid #000; 
            box-shadow: 8px 8px 0px #000;
            transition: all 0.2s ease-in-out; 
            border-radius: 0.75rem;
            position: relative;
            overflow: hidden;
            display: flex;
            flex-direction: column;
            height: 100%;
        }
        .card-neo:hover { 
            transform: translate(-4px, -4px); 
            box-shadow: 12px 12px 0px #000; 
        }
        .card-neo:nth-child(3n+1):hover { background-color: #E0E7FF; }
        .card-neo:nth-child(3n+2):hover { background-color: #FEF9C3; }
        .card-neo:nth-child(3n+3):hover { background-color: #FFEDD5; }

        .brutal-badge { 
            background: #fff; 
            color: #000; 
            font-size: 10px; 
            font-weight: 900; 
            padding: 4px 8px; 
            border-radius: 4px; 
            display: inline-flex; 
            align-items: center; 
            border: 2px solid #000; 
            box-shadow: 2px 2px 0px #000;
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }

        /* WATERMARK BESAR 'PDF' */
        .watermark-pdf {
            position: absolute; top: -15px; right: -15px;
            font-size: 7rem; font-weight: 900; color: rgba(0, 0, 0, 0.03);
            font-family: 'Space Grotesk', sans-serif; pointer-events: none;
            z-index: 0; transform: rotate(-10deg);
            transition: color 0.3s ease;
        }
        .card-neo:hover .watermark-pdf { color: rgba(0, 0, 0, 0.08); }

        /* FILTER BUTTONS DINAMIS */
        .no-scrollbar::-webkit-scrollbar { display: none; }
        .no-scrollbar { -ms-overflow-style: none; scrollbar-width: none; }
        
        .filter-btn {
            background: #fff; 
            border: 3px solid #000; 
            box-shadow: 4px 4px 0px #000;
            color: #000;
            padding: 0.6rem 1.5rem; 
            border-radius: 0.5rem; 
            font-weight: 900; 
            font-size: 0.8rem; 
            text-transform: uppercase;
            transition: all 0.15s ease; 
            white-space: nowrap; 
            flex-shrink: 0;
            display: inline-flex; 
            align-items: center; 
            justify-content: center;
        }
        .filter-btn:hover { 
            background: #FF90E8; /* Pink Hover */
            transform: translate(-2px, -2px); 
            box-shadow: 6px 6px 0px #000; 
        }
        .filter-btn.active { 
            background: #00E5FF; /* Cyan Active */
            transform: translate(2px, 2px); 
            box-shadow: 1px 1px 0px #000; 
        }

        .highlight-text {
            background: #FFC900; /* Yellow highlight */
            padding: 0 0.25rem;
            border: 3px solid #000;
            display: inline-block;
            transform: rotate(-1deg);
            box-shadow: 4px 4px 0px #000;
        }

        /* ==========================================
           HUD CURSOR CORE STYLES (ENTERPRISE UI/UX)
           ========================================== */
        @media (hover: hover) and (pointer: fine) {
            body, a, button, input, textarea, select, label, svg, img, 
            .card-neo, .filter-btn { 
                cursor: none !important; 
            }
            body * { cursor: none !important; }
        }
        
        #hud-wrapper, #hud-dot {
            position: fixed; 
            top: 0; 
            left: 0; 
            pointer-events: none; 
            z-index: 2147483647; 
            opacity: 0; 
            transition: opacity 0.3s ease;
            will-change: transform, width, height, opacity;
        }

        #hud-dot {
            width: 8px; 
            height: 8px;
            background-color: #10B981; 
            border-radius: 50%;
            margin: -4px 0 0 -4px;
            box-shadow: 0 0 10px #10B981, 0 0 20px #10B981;
        }

        #hud-wrapper {
            width: 0; 
            height: 0;
        }

        #hud-brackets {
            position: absolute; 
            top: 0; 
            left: 0;
            will-change: transform, width, height;
        }

        .hud-bracket {
            position: absolute; 
            width: 20px; 
            height: 20px;
            border-color: #10B981;
            border-style: solid; 
            opacity: 0.85;
            transition: border-width 0.25s ease, border-color 0.25s ease, opacity 0.25s ease;
        }
        
        .magnetic-active .hud-bracket {
            border-color: #059669;
            opacity: 1;
        }

        .hud-tl { top: 0; left: 0; border-width: 2px 0 0 2px; border-top-left-radius: 2px; }
        .hud-tr { top: 0; right: 0; border-width: 2px 2px 0 0; border-top-right-radius: 2px; }
        .hud-bl { bottom: 0; left: 0; border-width: 0 0 2px 2px; border-bottom-left-radius: 2px; }
        .hud-br { bottom: 0; right: 0; border-width: 0 2px 2px 0; border-bottom-right-radius: 2px; }
        
        .magnetic-active .hud-tl { border-width: 4px 0 0 4px; }
        .magnetic-active .hud-tr { border-width: 4px 4px 0 0; }
        .magnetic-active .hud-bl { border-width: 0 0 4px 4px; }
        .magnetic-active .hud-br { border-width: 0 4px 4px 0; }
    </style>
</head>
<body class="antialiased selection:bg-[#FF90E8] selection:text-black relative">
    
    <!-- NAVBAR -->
    <nav class="glass-header sticky top-0 z-50 w-full animate__animated animate__fadeInDown">
        <div class="container mx-auto px-4 sm:px-6 py-3 md:py-4 flex justify-between items-center max-w-6xl">
            <a href="/" class="text-sm md:text-base font-black font-display text-black hover:bg-black hover:text-white px-3 py-1.5 rounded transition-colors uppercase tracking-widest flex items-center gap-2 border-2 border-black bg-white shadow-[3px_3px_0px_#000] active:translate-y-1 active:shadow-none">
                <i class="ph-bold ph-arrow-left text-lg"></i> Website
            </a>
            <span class="text-[10px] md:text-xs font-black font-mono text-black bg-white px-3 py-1.5 rounded border-2 border-black hidden sm:inline-block shadow-[3px_3px_0px_#000] tracking-widest uppercase">KNOWLEDGE BASE CORE</span>
