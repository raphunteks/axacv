    <!-- HUD CURSOR CONTAINER (CHIEF MASTER UI/UX) -->
    <div id="hud-wrapper">
        <div id="hud-brackets">
            <div class="hud-bracket hud-tl"></div>
            <div class="hud-bracket hud-tr"></div>
