<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= meta.title %></title>
    <meta name="description" content="<%= meta.desc %>">
    <link rel="canonical" href="<%= meta.canonical %>">
    
    <!-- FIX GBR 1: Open Graph SEO & Favicon -->
    <link rel="icon" type="image/png" href="/axalogo.png">
    <link rel="apple-touch-icon" href="/axalogo.png">

    <meta property="og:title" content="<%= meta.title %>">
    <meta property="og:description" content="<%= meta.desc %>">
    <meta property="og:image" content="<%= baseUrl %><%= meta.ogImage %>">
    <meta property="og:url" content="<%= meta.canonical %>">
    <meta property="og:type" content="<%= meta.type %>">

    <script src="https://cdn.tailwindcss.com"></script>
    <script src="https://unpkg.com/@phosphor-icons/web"></script>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;700;800&family=Space+Grotesk:wght@700&display=swap" rel="stylesheet">
    <style>
        body { background-color: #030712; color: #fff; font-family: 'Plus Jakarta Sans', sans-serif; overflow-x: hidden; }
        .glass-header { background: rgba(3, 7, 18, 0.8); backdrop-filter: blur(20px); border-bottom: 1px solid rgba(255,255,255,0.1); }
        .card-neo { background: #0b0f19; border: 1px solid rgba(0, 229, 255, 0.15); transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1); box-shadow: 4px 4px 0px rgba(0, 229, 255, 0.2); }
        .card-neo:hover { transform: translateY(-6px) scale(1.02); border-color: #00E5FF; box-shadow: 8px 8px 0px rgba(0,229,255,0.6); }
    </style>
</head>
<body class="antialiased selection:bg-cyan-500 selection:text-black">
    
    <nav class="glass-header sticky top-0 z-50 w-full">
        <div class="container mx-auto px-4 sm:px-6 py-4 flex justify-between items-center max-w-6xl">
            <a href="/" class="text-lg md:text-xl font-bold font-['Space_Grotesk'] text-cyan-400 flex items-center gap-2 hover:scale-105 transition-transform active:scale-95">
                <i class="ph-bold ph-arrow-left"></i> Axa System
            </a>
            <span class="text-[10px] md:text-xs font-mono text-cyan-400 bg-cyan-400/10 px-3 py-1.5 rounded-full border border-cyan-400/30 hidden sm:inline-block shadow-[0_0_10px_rgba(0,229,255,0.2)]">POSTGRES KNOWLEDGE BASE</span>
        </div>
    </nav>

    <main class="container mx-auto px-4 sm:px-6 py-10 md:py-16 max-w-5xl min-h-[80vh]">
        <header class="text-center mb-12 md:mb-20 px-2">
            <h1 class="text-3xl sm:text-4xl md:text-5xl lg:text-6xl font-black font-['Space_Grotesk'] mb-4 md:mb-6 leading-tight">
                Arsip Materi <span class="text-transparent bg-clip-text bg-gradient-to-r from-cyan-400 to-purple-500">& Jurnal</span>
            </h1>
            <p class="text-gray-400 max-w-2xl mx-auto text-sm md:text-base leading-relaxed px-4">Akses direktori catatan pembelajaran, materi preklinik, jurnal profesi dokter muda, dan publikasi penelitian berformat PDF langsung dari cloud.</p>
        </header>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-6 md:gap-8">
            <% if(arsipData && arsipData.length > 0) { %>
                <% arsipData.forEach(item => { %>
                    <a href="/arsip/<%= item.slug %>" class="card-neo p-6 md:p-8 rounded-2xl block group w-full outline-none focus-visible:ring-2 focus-visible:ring-cyan-400 relative overflow-hidden">
                        <div class="absolute -right-4 -top-4 opacity-5 group-hover:opacity-20 transition-opacity pointer-events-none">
                            <i class="ph-fill ph-file-pdf text-9xl text-cyan-400"></i>
                        </div>
                        <div class="flex justify-between items-start mb-5 gap-3 relative z-10">
                            <span class="text-[9px] md:text-[10px] font-mono font-bold uppercase tracking-widest text-white bg-cyan-500 px-3 py-1.5 rounded-lg border border-cyan-400 shrink-0"><%= item.category %></span>
                            <span class="text-[10px] md:text-xs text-gray-500 font-mono flex items-center gap-1 shrink-0"><i class="ph-bold ph-calendar-blank text-sm"></i> <%= item.date %></span>
                        </div>
                        <h2 class="text-lg md:text-2xl font-black mb-3 group-hover:text-cyan-400 transition-colors line-clamp-2 leading-tight break-words relative z-10"><%= item.title %></h2>
                        <p class="text-xs md:text-sm text-gray-400 line-clamp-3 mb-8 leading-relaxed break-words relative z-10"><%= item.desc %></p>
                        <div class="flex items-center text-xs md:text-sm font-bold text-cyan-400 gap-2 mt-auto relative z-10 border-t border-gray-800 pt-4">
                            <i class="ph-bold ph-lock-key-open text-lg"></i> Buka Dokumen Interaktif <i class="ph-bold ph-arrow-right group-hover:translate-x-1.5 transition-transform ml-auto text-base"></i>
                        </div>
                    </a>
                <% }) %>
            <% } else { %>
                <div class="col-span-full text-center py-16 md:py-24 border-2 border-dashed border-gray-800 bg-gray-900/30 rounded-3xl w-full px-4">
                    <i class="ph-fill ph-database text-4xl md:text-6xl text-gray-600 mb-4 block"></i>
                    <p class="text-gray-400 font-mono text-sm md:text-base">Belum ada materi diarsipkan di sistem publik (Database Kosong).</p>
                </div>
            <% } %>
        </div>
    </main>

    <footer class="border-t border-white/10 text-center py-8 text-gray-500 font-mono text-[10px] md:text-xs w-full px-4">
        &copy; 2026 drg. M. Aksa Arsyad, S.KG. | Powered by AWS PostgreSQL
    </footer>
</body>
</html>
