<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= meta.title %></title>
    <meta name="description" content="<%= meta.desc %>">
    <link rel="canonical" href="<%= meta.canonical %>">
    
    <!-- Open Graph SEO -->
    <meta property="og:title" content="<%= meta.title %>">
    <meta property="og:description" content="<%= meta.desc %>">
    <meta property="og:image" content="<%= baseUrl %><%= meta.ogImage %>">
    <meta property="og:url" content="<%= meta.canonical %>">
    <meta property="og:type" content="<%= meta.type %>">

    <script src="https://cdn.tailwindcss.com"></script>
    <script src="https://unpkg.com/@phosphor-icons/web"></script>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;700;800&family=Space+Grotesk:wght@700&display=swap" rel="stylesheet">
    <style>
        body { background-color: #030712; color: #fff; font-family: 'Plus Jakarta Sans', sans-serif; overflow-x: hidden; }
        .glass-header { background: rgba(3, 7, 18, 0.8); backdrop-filter: blur(20px); border-bottom: 1px solid rgba(255,255,255,0.1); }
        .card-neo { background: #0f172a; border: 1px solid rgba(255,255,255,0.05); transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1); }
        .card-neo:hover { transform: translateY(-6px) scale(1.02); border-color: #00E5FF; box-shadow: 0 15px 35px rgba(0,229,255,0.15); }
    </style>
</head>
<body class="antialiased selection:bg-cyan-500 selection:text-black">
    
    <nav class="glass-header sticky top-0 z-50 w-full">
        <div class="container mx-auto px-4 sm:px-6 py-4 flex justify-between items-center max-w-6xl">
            <a href="/" class="text-lg md:text-xl font-bold font-['Space_Grotesk'] text-cyan-400 flex items-center gap-2 hover:scale-105 transition-transform active:scale-95">
                <i class="ph-bold ph-arrow-left"></i> Axa System
            </a>
            <span class="text-[10px] md:text-xs font-mono text-gray-400 bg-white/5 px-3 py-1.5 rounded-full border border-white/10 hidden sm:inline-block">KNOWLEDGE BASE</span>
        </div>
    </nav>

    <main class="container mx-auto px-4 sm:px-6 py-10 md:py-16 max-w-5xl min-h-[80vh]">
        <header class="text-center mb-12 md:mb-20 px-2">
            <h1 class="text-3xl sm:text-4xl md:text-5xl lg:text-6xl font-black font-['Space_Grotesk'] mb-4 md:mb-6 leading-tight">
                Arsip Materi <span class="text-transparent bg-clip-text bg-gradient-to-r from-cyan-400 to-purple-500">& Jurnal</span>
            </h1>
            <p class="text-gray-400 max-w-2xl mx-auto text-sm md:text-base leading-relaxed px-4">Akses direktori catatan pembelajaran, materi preklinik, jurnal profesi dokter muda, dan publikasi penelitian.</p>
        </header>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-5 md:gap-8">
            <% if(arsipData && arsipData.length > 0) { %>
                <% arsipData.forEach(item => { %>
                    <a href="/arsip/<%= item.slug %>" class="card-neo p-5 md:p-8 rounded-2xl block group w-full outline-none focus-visible:ring-2 focus-visible:ring-cyan-400">
                        <div class="flex justify-between items-start mb-4 md:mb-5 gap-3">
                            <span class="text-[9px] md:text-[11px] font-mono font-bold uppercase tracking-widest text-cyan-400 bg-cyan-400/10 px-3 py-1.5 rounded-lg border border-cyan-400/20 shrink-0"><%= item.category %></span>
                            <span class="text-[10px] md:text-xs text-gray-500 font-mono flex items-center gap-1 shrink-0"><i class="ph-fill ph-calendar-blank text-sm"></i> <%= item.date %></span>
                        </div>
                        <h2 class="text-lg md:text-xl lg:text-2xl font-black mb-3 md:mb-4 group-hover:text-cyan-400 transition-colors line-clamp-2 leading-tight break-words"><%= item.title %></h2>
                        <p class="text-xs md:text-sm text-gray-400 line-clamp-3 mb-6 md:mb-8 leading-relaxed break-words"><%= item.desc %></p>
                        <div class="flex items-center text-xs md:text-sm font-bold text-white group-hover:text-cyan-400 gap-2 mt-auto">
                            Akses Dokumen <i class="ph-bold ph-arrow-right group-hover:translate-x-1.5 transition-transform text-base md:text-lg"></i>
                        </div>
                    </a>
                <% }) %>
            <% } else { %>
                <div class="col-span-full text-center py-16 md:py-24 border border-dashed border-gray-800 rounded-3xl w-full px-4">
                    <i class="ph-fill ph-folder-open text-4xl md:text-5xl text-gray-600 mb-4 md:mb-5 block"></i>
                    <p class="text-gray-400 font-mono text-sm md:text-base">Belum ada materi diarsipkan di sistem publik.</p>
                </div>
            <% } %>
        </div>
    </main>

    <footer class="border-t border-white/10 text-center py-8 md:py-10 text-gray-500 font-mono text-[10px] md:text-xs w-full px-4 break-words">
        &copy; 2026 drg. M. Aksa Arsyad, S.KG. | Knowledge Base System
    </footer>
</body>
</html>
