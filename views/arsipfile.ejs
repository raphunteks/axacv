<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= meta.title %></title>
    
    <link rel="icon" type="image/png" href="/axalogo.png">
    <link rel="apple-touch-icon" href="/axalogo.png">

    <meta name="description" content="<%= meta.desc %>">
    <meta name="keywords" content="<%= meta.keywords %>">
    <link rel="canonical" href="<%= meta.canonical %>">
    
    <!-- OPEN GRAPH STANDARD -->
    <meta property="og:type" content="<%= meta.type %>">
    <meta property="og:url" content="<%= meta.canonical %>">
    <meta property="og:title" content="<%= meta.title %>">
    <meta property="og:description" content="<%= meta.desc %>">
    <meta property="og:image" content="<%= baseUrl %><%= meta.ogImage %>">

    <% 
        // Helper Parser Date Khusus Google (ISO 8601 & YYYY/MM/DD)
        let isoDate = arsip.date;
        let scholarDate = arsip.date;
        let displayDate = arsip.date; 
        
        if(isoDate && isoDate.match(/^\d{2}-\d{2}-\d{4}$/)) {
            const parts = isoDate.split('-');
            isoDate = `${parts[2]}-${parts[1]}-${parts[0]}`; 
            scholarDate = `${parts[2]}/${parts[1]}/${parts[0]}`; 
            displayDate = arsip.date; 
        } else if (isoDate && isoDate.match(/^\d{4}-\d{2}-\d{2}$/)) {
            const parts = isoDate.split('-');
            displayDate = `${parts[2]}-${parts[1]}-${parts[0]}`; 
            scholarDate = isoDate.replace(/-/g, '/');
        }
        
        // GSC JSON PROTECTOR: Menghapus karakter enter (\n) yang bisa memicu Googlebot Invalid Data JSON-LD
        const safeTitle = (arsip.title || '').replace(/"/g, '\\"').replace(/(\r\n|\n|\r)/gm, " ");
        const safeDesc = (arsip.desc || '').replace(/"/g, '\\"').replace(/(\r\n|\n|\r)/gm, " ");
        const isFree = arsip.access_type === 'Open Access' ? 'true' : 'false';

        // 🌟 HELPER SITELINKS SEO: Mem-parsing Kategori Dinamis & Artikel Lain
        const slugify = (text) => text.toString().toLowerCase().trim().replace(/[^a-z0-9]+/g, '-').replace(/^-+|-+$/g, '');

        const jsonLdItems = typeof arsipData !== 'undefined' ? arsipData.slice(0, 15).map((item, index) => ({
            "@type": "ListItem",
            "position": index + 1,
            "url": `${baseUrl}/arsip/${item.slug}`,
            "name": item.title
        })) : [];

        const sitelinkCategories = typeof categories !== 'undefined' ? categories.map((kat, index) => ({
            "@type": "SiteNavigationElement",
            "position": index + 1,
            "name": kat,
            "url": `${baseUrl}/arsip/kategori/${slugify(kat)}`
        })) : [];
    %>

    <!-- GOOGLE SCHOLAR & ACADEMIC SEO TAGS -->
    <meta name="citation_title" content="<%- safeTitle %>">
    <meta name="citation_author" content="drg. M. Aksa Arsyad, S.KG">
    <% if (scholarDate) { %><meta name="citation_publication_date" content="<%= scholarDate %>"><% } %>
    <meta name="citation_journal_title" content="Axa System Knowledge Base">
    <meta name="citation_language" content="id">
    <% if(arsip.access_type === 'Open Access') { %>
    <meta name="citation_pdf_url" content="<%= baseUrl %>/arsip/file/<%= arsip.slug %>.pdf">
    <% } %>

    <!-- JSON-LD STRUCTURED DATA (WITH SITELINKS GENERATOR) -->
    <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@graph": [
        {
          "@type": "WebSite",
          "@id": "<%= baseUrl %>/#website",
          "url": "<%= baseUrl %>/",
          "name": "Knowledge Base drg. M. Aksa Arsyad",
          "potentialAction": {
            "@type": "SearchAction",
            "target": "<%= baseUrl %>/arsip?q={search_term_string}",
            "query-input": "required name=search_term_string"
          }
        },
        {
          "@type": "ScholarlyArticle",
          "@id": "<%= meta.canonical %>#article",
          "headline": "<%- safeTitle %>",
          "description": "<%- safeDesc %>",
          "url": "<%= meta.canonical %>",
          "datePublished": "<%= isoDate %>",
          "author": { "@type": "Person", "name": "drg. M. Aksa Arsyad, S.KG" },
          "publisher": { "@type": "Organization", "name": "Axa System Knowledge Base", "logo": { "@type": "ImageObject", "url": "<%= baseUrl %>/axalogo.png" } },
          "isAccessibleForFree": <%= isFree %>
        },
        {
          "@type": "BreadcrumbList",
          "@id": "<%= meta.canonical %>#breadcrumb",
          "itemListElement": [
            { "@type": "ListItem", "position": 1, "name": "Beranda", "item": "<%= baseUrl %>/" },
            { "@type": "ListItem", "position": 2, "name": "Arsip Materi", "item": "<%= baseUrl %>/arsip" },
            { "@type": "ListItem", "position": 3, "name": "<%- safeTitle %>", "item": "<%= meta.canonical %>" }
          ]
        }
        <% if(sitelinkCategories.length > 0) { %>,
        {
          "@type": "ItemList",
          "name": "Daftar Kategori Navigasi (Sitelinks)",
          "itemListElement": <%- JSON.stringify(sitelinkCategories) %>
        }
        <% } %>
        <% if(jsonLdItems.length > 0) { %>,
        {
          "@type": "ItemList",
          "name": "Daftar Artikel Arsip Lainnya",
          "itemListElement": <%- JSON.stringify(jsonLdItems) %>
        }
        <% } %>
      ]
    }
    </script>

    <script src="https://cdn.tailwindcss.com"></script>
    <script src="https://unpkg.com/@phosphor-icons/web"></script>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;700;800;900&family=Space+Grotesk:wght@700;900&display=swap" rel="stylesheet">
    
    <style>
        /* NEUBRUTALISM BASE */
        body { 
            background-color: #f4f4f0; 
            color: #000; 
            font-family: 'Plus Jakarta Sans', sans-serif; 
            overflow-x: hidden; 
            min-height: 100vh;
            background-image: radial-gradient(#000 1px, transparent 1px);
            background-size: 24px 24px;
        }
        
        .font-display { font-family: 'Space Grotesk', sans-serif; }

        /* CORE COMPONENTS */
        .brutal-border { border: 4px solid #000; }
        .brutal-shadow { box-shadow: 4px 4px 0px #000; transition: all 0.2s ease-in-out; }
        .brutal-shadow-lg { box-shadow: 8px 8px 0px #000; transition: all 0.2s ease-in-out; }
        
        .brutal-btn {
            border: 4px solid #000;
            box-shadow: 6px 6px 0px #000;
            transition: all 0.15s ease-in-out;
            font-family: 'Space Grotesk', sans-serif;
            text-transform: uppercase;
        }
        .brutal-btn:hover { transform: translate(-2px, -2px); box-shadow: 8px 8px 0px #000; }
        .brutal-btn:active { transform: translate(4px, 4px); box-shadow: 2px 2px 0px #000; }

        .brutal-input {
            border: 4px solid #000;
            box-shadow: 4px 4px 0px #000;
            transition: all 0.2s;
        }
        .brutal-input:focus {
            transform: translate(-2px, -2px);
            box-shadow: 6px 6px 0px #000;
            outline: none;
            background-color: #E0E7FF;
        }

        /* DOC WRAPPER (PDF VIEWER) */
        .doc-wrapper { 
            position: relative; width: 100%; height: 80vh; min-height: 600px; max-height: 950px; 
            overflow: hidden; border-radius: 1rem; background: #fff; 
        }
        .doc-object { width: 100%; height: 100%; border: none; background: transparent; transition: filter 0.3s; }
        .blur-full { filter: blur(12px) grayscale(20%); pointer-events: none; user-select: none; }
        
        .overlay-center {
            position: absolute; inset: 0;
            display: flex; flex-direction: column; justify-content: center; align-items: center;
            background: rgba(244, 244, 240, 0.6); backdrop-filter: blur(5px);
            z-index: 20; padding: 1.5rem;
        }

        /* CUSTOM SCROLLBAR UNTUK MODAL */
        .custom-scrollbar::-webkit-scrollbar { width: 8px; height: 8px; }
        .custom-scrollbar::-webkit-scrollbar-track { background: #fff; border-left: 2px solid #000; }
        .custom-scrollbar::-webkit-scrollbar-thumb { background: #000; border: 2px solid #fff; }

        /* Animasi PopIn */
        .modal-enter { animation: popIn 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275) forwards; }
        @keyframes popIn { 
            0% { opacity: 0; transform: scale(0.8) translateY(20px); } 
            100% { opacity: 1; transform: scale(1) translateY(0); } 
        }

        /* ==========================================
           HUD CURSOR CORE STYLES (ENTERPRISE UI/UX)
           ========================================== */
        @media (hover: hover) and (pointer: fine) {
            body, a, button, input, textarea, select, label, svg, img, 
            .brutal-btn, .doc-wrapper, .brutal-input { 
                cursor: none !important; 
            }
            body * { cursor: none !important; }
        }
        
        #hud-wrapper, #hud-dot {
            position: fixed; 
            top: 0; 
            left: 0; 
            pointer-events: none; 
            z-index: 2147483647; 
            opacity: 0; 
            transition: opacity 0.3s ease;
            will-change: transform, width, height, opacity;
        }

        #hud-dot {
            width: 8px; 
            height: 8px;
            background-color: #10B981; /* Emerald Green */
            border-radius: 50%;
            margin: -4px 0 0 -4px;
            box-shadow: 0 0 10px #10B981, 0 0 20px #10B981;
        }

        #hud-wrapper {
            width: 0; 
            height: 0;
        }

        #hud-brackets {
            position: absolute; 
            top: 0; 
            left: 0;
            will-change: transform, width, height;
        }

        .hud-bracket {
            position: absolute; 
            width: 20px; 
            height: 20px;
            border-color: #10B981;
            border-style: solid; 
            opacity: 0.85;
            transition: border-width 0.25s ease, border-color 0.25s ease, opacity 0.25s ease;
        }
        
        .magnetic-active .hud-bracket {
            border-color: #059669; /* Darker Emerald for active snap */
            opacity: 1;
        }

        /* 4 Siku (Corner Brackets) - Normal Idle */
        .hud-tl { top: 0; left: 0; border-width: 2px 0 0 2px; }
        .hud-tr { top: 0; right: 0; border-width: 2px 2px 0 0; }
        .hud-bl { bottom: 0; left: 0; border-width: 0 0 2px 2px; }
        .hud-br { bottom: 0; right: 0; border-width: 0 2px 2px 0; }
        
        /* 4 Siku (Corner Brackets) - Magnetic Locked (Penebalan Garis Siku) */
        .magnetic-active .hud-tl { border-width: 4px 0 0 4px; }
        .magnetic-active .hud-tr { border-width: 4px 4px 0 0; }
        .magnetic-active .hud-bl { border-width: 0 0 4px 4px; }
        .magnetic-active .hud-br { border-width: 0 4px 4px 0; }
    </style>
</head>
<body class="antialiased selection:bg-[#FF90E8] selection:text-black relative">

    <!-- NAVBAR NEUBRUTALISM -->
    <nav class="bg-[#A3E635] brutal-border border-l-0 border-r-0 border-t-0 sticky top-0 z-50 w-full shadow-lg">
        <div class="container mx-auto px-4 py-3 md:py-4 flex justify-between items-center max-w-5xl">
            <a href="/arsip" class="text-sm md:text-base font-black text-black hover:bg-black hover:text-white px-4 py-2 rounded transition-colors uppercase tracking-widest font-mono flex items-center gap-2 brutal-border bg-white shadow-[3px_3px_0px_#000] active:translate-y-1 active:shadow-none">
                <i class="ph-bold ph-arrow-left text-lg"></i> Direktori
            </a>
            
            <div class="flex items-center gap-4">
                <!-- Tampilan Default (Belum Login) -->
                <div id="defaultNavRight" class="text-[10px] md:text-xs text-black font-black font-mono hidden sm:flex items-center gap-2 bg-white px-3 py-2 rounded brutal-border shadow-[3px_3px_0px_#000] uppercase">
                    <i class="ph-fill ph-shield-check text-green-500 text-lg"></i> Secure Stream
                </div>
                
                <!-- Tampilan User Profile & Tombol Logout (MUNCUL JIKA SUDAH LOGIN) -->
                <div id="userProfileNav" class="hidden items-center gap-3">
                    <span id="navUserName" class="text-[10px] md:text-xs font-black text-black font-mono tracking-widest bg-white px-3 py-2 rounded brutal-border shadow-[3px_3px_0px_#000] hidden sm:inline-block uppercase"></span>
                    
                    <button onclick="userLogout()" class="bg-[#FF90E8] text-black brutal-border hover:bg-red-500 hover:text-white px-3 py-2 rounded text-[10px] md:text-xs font-black uppercase tracking-widest transition-all flex items-center gap-1.5 shadow-[3px_3px_0px_#000] active:translate-y-1 active:shadow-none">
                        <i class="ph-bold ph-power text-sm md:text-base"></i> Logout
                    </button>
                </div>
            </div>
        </div>
    </nav>

    <main class="container mx-auto px-4 py-10 md:py-16 max-w-4xl min-h-screen">
        
        <article itemscope itemtype="http://schema.org/ScholarlyArticle">
            <header class="mb-12 text-center">
                <!-- Kategori Tag Neubrutalism -->
                <div class="inline-block transform -rotate-2 mb-6">
                    <span class="inline-flex items-center bg-[#22D3EE] px-4 py-1.5 text-xs md:text-sm font-black uppercase tracking-widest text-black brutal-border shadow-[4px_4px_0px_#000]">
                        <i class="ph-bold ph-folder mr-2"></i> <span itemprop="articleSection"><%= arsip.category %></span>
                    </span>
                </div>
                
                <h1 itemprop="headline" class="text-3xl md:text-5xl lg:text-6xl font-black font-display mb-6 leading-[1.1] text-black uppercase drop-shadow-[2px_2px_0px_#fff]"><%= arsip.title %></h1>
                
                <p itemprop="description" class="text-gray-800 text-sm md:text-base font-bold max-w-2xl mx-auto leading-relaxed border-b-4 border-black pb-8"><%= arsip.desc %></p>
                
                <!-- Metadata Pills Neubrutalism -->
                <div class="mt-8 flex justify-center items-center gap-3 md:gap-4 text-xs font-bold font-mono text-black flex-wrap">
                    <span class="bg-white px-3 py-2 brutal-border shadow-[3px_3px_0px_#000] flex items-center gap-2 uppercase"><i class="ph-bold ph-file-pdf text-red-500 text-lg"></i> <%= arsip.file_name %></span>
                    <span class="bg-white px-3 py-2 brutal-border shadow-[3px_3px_0px_#000] flex items-center gap-2 uppercase"><i class="ph-bold ph-calendar-blank text-lg"></i> <time itemprop="datePublished" datetime="<%= isoDate %>"><%= displayDate %></time></span>
                    
                    <% if(arsip.access_type === 'Open Access') { %>
                        <span class="bg-[#4ADE80] px-3 py-2 brutal-border shadow-[3px_3px_0px_#000] flex items-center gap-2 uppercase"><i class="ph-bold ph-check-circle text-lg"></i> Open Access</span>
                    <% } else { %>
                        <span class="bg-[#FDE047] px-3 py-2 brutal-border shadow-[3px_3px_0px_#000] flex items-center gap-2 uppercase"><i class="ph-bold ph-lock-key text-lg"></i> Restricted</span>
                    <% } %>
                </div>
            </header>

            <!-- KOTAK PDF VIEWER NEUBRUTALISM -->
            <div class="doc-wrapper brutal-border brutal-shadow-lg">
                <% if(arsip.access_type === 'Restricted') { %>
                    <!-- MODE 1: RESTRICTED (DIBLUR PENUH) -->
                    <object data="/arsip/file/<%= arsip.slug %>.pdf#toolbar=0&navpanes=0&scrollbar=0" type="application/pdf" class="doc-object blur-full">
                        <div class="flex flex-col items-center justify-center h-full bg-gray-100 text-black p-8 text-center"><i class="ph-fill ph-file-pdf text-6xl text-gray-400 mb-4"></i></div>
                    </object>
                    
                    <!-- Overlay Gembok Tengah -->
                    <div class="overlay-center">
                        <div class="bg-[#FFC900] brutal-border p-6 md:p-10 text-center max-w-lg brutal-shadow-lg">
                            <i class="ph-bold ph-lock-key text-5xl md:text-6xl text-black mb-4 block"></i>
                            <h3 class="text-2xl md:text-3xl font-black font-display mb-3 text-black uppercase">Dokumen Terkunci</h3>
                            <p class="text-sm md:text-base text-black font-bold mb-8 leading-relaxed">Keamanan aktif. Silakan verifikasi identitas Google Anda untuk membuka kunci dan mengunduh PDF secara utuh.</p>
                            
                            <!-- TOMBOL LOGIN GOOGLE & DOWNLOAD DINAMIS -->
                            <button id="btnDownloadGated" onclick="handleSecureDownload()" class="brutal-btn bg-white w-full py-4 text-sm md:text-base flex justify-center items-center gap-3 font-black">
                                <i id="downloadIcon" class="ph-bold ph-google-logo text-xl"></i> 
                                <span id="downloadText">SIGN IN GOOGLE & DOWNLOAD</span>
                            </button>
                        </div>
                    </div>

                <% } else { %>
                    <!-- MODE 2: OPEN ACCESS -->
                    <object data="/arsip/file/<%= arsip.slug %>.pdf" type="application/pdf" class="doc-object">
                        <div class="flex flex-col items-center justify-center h-full bg-white text-black p-8 text-center">
                            <i class="ph-bold ph-file-pdf text-6xl text-red-500 mb-4"></i>
                            <p class="font-bold mb-4">Pratinjau PDF Native tidak didukung browser Anda.</p>
                            <a href="/arsip/file/<%= arsip.slug %>.pdf" class="bg-[#22D3EE] text-black brutal-border shadow-[4px_4px_0px_#000] px-6 py-2 font-black uppercase">Unduh Langsung</a>
                        </div>
                    </object>

                    <!-- Floating Buka Native Endpoint (.pdf) -->
                    <a href="/arsip/file/<%= arsip.slug %>.pdf" target="_blank" rel="noopener noreferrer" itemprop="url" class="absolute bottom-6 right-6 brutal-btn bg-[#A3E635] px-6 py-3.5 text-xs md:text-sm flex items-center gap-2 z-30 font-black">
                        <i class="ph-bold ph-arrow-square-out text-lg"></i> BUKA FULL PDF
                    </a>
                <% } %>
            </div>
        </article>
    </main>

    <!-- MODAL FORM IDENTITAS DINAMIS NEUBRUTALISM -->
    <div id="userDataModal" class="fixed inset-0 z-[9999] hidden bg-black/60 backdrop-blur-sm flex items-center justify-center p-4">
        <div class="bg-[#22D3EE] brutal-border p-6 md:p-8 max-w-md w-full brutal-shadow-lg modal-enter max-h-[90vh] overflow-y-auto custom-scrollbar">
            
            <div class="flex justify-between items-start mb-2 border-b-4 border-black pb-3">
                <h3 class="text-3xl font-black font-display text-black uppercase">Profil Akses</h3>
                <i class="ph-fill ph-identification-card text-4xl text-black"></i>
            </div>
            
            <p class="text-black text-sm font-bold mb-6 mt-4 leading-relaxed bg-white p-2 brutal-border shadow-[2px_2px_0px_#000]">Sistem mewajibkan kelengkapan data. Isi form ini <b>satu kali saja</b> untuk bebas akses seluruh dokumen.</p>

            <form id="formUserData" onsubmit="submitUserData(event)" class="space-y-4">
                <!-- Form Inputs yang Diinject secara Dinamis oleh JS -->
                <div id="dynamicFormContainer" class="space-y-4"></div>

                <button type="submit" id="btnSaveData" class="brutal-btn bg-[#FF90E8] w-full py-4 text-sm md:text-base flex justify-center items-center gap-2 mt-6 font-black">
                    <i class="ph-bold ph-floppy-disk text-xl"></i> SIMPAN & UNDUH PDF
                </button>
            </form>
        </div>
    </div>

    <!-- HUD CURSOR CONTAINER -->
    <div id="hud-wrapper">
        <div id="hud-brackets">
            <div class="hud-bracket hud-tl"></div>
            <div class="hud-bracket hud-tr"></div>
            <div class="hud-bracket hud-bl"></div>
            <div class="hud-bracket hud-br"></div>
        </div>
    </div>
    <div id="hud-dot"></div>

    <!-- SCRIPT SUPABASE UNTUK GOOGLE AUTH, TRACKING DOWNLOAD & DYNAMIC FORM -->
    <script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>
    <script>
        // Menerima Object Setting Form Dinamis dari Backend SERVER.JS
        window.FORM_SETTINGS = <%- JSON.stringify(typeof requireForm !== 'undefined' ? requireForm : { requireForm: true, fields: [{id:'nama_lengkap', label:'Nama Lengkap'}, {id:'institusi_asal', label:'Asal Institusi'}] }) %>;

        const SUPABASE_URL = "<%= typeof supabaseUrl !== 'undefined' ? supabaseUrl : '' %>"; 
        const SUPABASE_ANON_KEY = "<%= typeof supabaseAnonKey !== 'undefined' ? supabaseAnonKey : '' %>"; 
        
        let supabaseClient = null;
        if (SUPABASE_URL && SUPABASE_ANON_KEY) {
            supabaseClient = window.supabase.createClient(SUPABASE_URL, SUPABASE_ANON_KEY);
        }

        // FUNGSI LOGOUT USER
        async function userLogout() {
            if(supabaseClient) await supabaseClient.auth.signOut();
            window.location.reload();
        }

        // FUNGSI TRACKING UNDUHAN KE BACKEND 
        async function trackDownloadToBackend() {
            try {
                const { data: { session } } = await supabaseClient.auth.getSession();
                if(!session) return;
                
                await fetch('/api/track-download', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'Authorization': `Bearer ${session.access_token}`
                    },
                    body: JSON.stringify({ fileTitle: "<%= arsip.title %>" })
                });
            } catch (error) {
                console.error("Gagal melacak unduhan ke backend:", error);
            }
        }

        // FUNGSI UTAMA TOMBOL KLIK
        async function handleSecureDownload() {
            if (!supabaseClient) return alert("Sistem Autentikasi tidak terhubung ke server.");

            const btn = document.getElementById('btnDownloadGated');
            const dIcon = document.getElementById('downloadIcon');
            const dText = document.getElementById('downloadText');

            dIcon.className = "ph-bold ph-spinner-gap animate-spin text-xl";
            dText.innerText = "MEMERIKSA AKSES...";

            const { data: { session } } = await supabaseClient.auth.getSession();

            if (!session) {
                // BELUM LOGIN -> Buka Google Sign In
                const redirectUrl = "<%= baseUrl %>/arsip/<%= arsip.slug %>";
                const { error } = await supabaseClient.auth.signInWithOAuth({
                    provider: 'google',
                    options: { redirectTo: redirectUrl }
                });
                
                if (error) {
                    alert("Gagal memanggil Google Login: " + error.message);
                    dIcon.className = "ph-bold ph-google-logo text-xl";
                    dText.innerText = "SIGN IN GOOGLE & DOWNLOAD";
                }
            } else {
                // SUDAH LOGIN -> Cek Form kelengkapan data (Dinamis)
                checkUserMetadataAndProceed(session.user);
            }
        }

        // FUNGSI RENDER FORM DINAMIS (Berdasarkan Dashboard Admin)
        function renderDynamicForm(userMeta) {
            const container = document.getElementById('dynamicFormContainer');
            const fields = window.FORM_SETTINGS.fields || [];
            
            if (fields.length === 0) {
                container.innerHTML = `<p class="text-xs text-black font-mono font-bold bg-white p-2 brutal-border">Tidak ada data tambahan yang diminta oleh admin.</p>`;
                return;
            }

            container.innerHTML = fields.map(f => {
                let val = userMeta[f.id] || '';
                // Helper pintar: Jika field "nama_lengkap", otomatis sedot dari Google Akun jika val masih kosong
                if (f.id === 'nama_lengkap' && !val && userMeta.full_name) val = userMeta.full_name;
                
                return `
                <div>
                    <label class="text-xs text-black font-black uppercase tracking-widest mb-1 block">${f.label}</label>
                    <input type="text" id="field_${f.id}" value="${val}" required class="w-full brutal-input bg-white px-4 py-3 text-sm font-bold text-black placeholder-gray-500">
                </div>
                `;
            }).join('');
        }

        // FUNGSI CEK DATA LENGKAP SECARA DINAMIS
        function isProfileComplete(meta) {
            if (!window.FORM_SETTINGS.requireForm) return true; // Form dinonaktifkan Admin
            const fields = window.FORM_SETTINGS.fields || [];
            for (let f of fields) {
                if (!meta[f.id]) return false; // Ada satu saja field yang kosong, return false
            }
            return true;
        }

        async function checkUserMetadataAndProceed(user) {
            const btn = document.getElementById('btnDownloadGated');
            const dIcon = document.getElementById('downloadIcon');
            const dText = document.getElementById('downloadText');
            const meta = user.user_metadata || {};
            
            if (!isProfileComplete(meta)) {
                // Data belum lengkap: Render Form & Munculkan Modal
                renderDynamicForm(meta);
                document.getElementById('userDataModal').classList.remove('hidden');
                
                // Kembalikan status tombol
                dIcon.className = "ph-bold ph-user-circle-plus text-xl";
                dText.innerText = "LENGKAPI DATA PROFIL";
            } else {
                // Data sudah lengkap -> Eksekusi Download
                executeDownloadFile(btn, dIcon, dText);
            }
        }

        // FUNGSI SUBMIT FORM IDENTITAS DINAMIS
        async function submitUserData(event) {
            event.preventDefault();
            const btnSave = document.getElementById('btnSaveData');
            const oriText = btnSave.innerHTML;
            btnSave.innerHTML = '<i class="ph-bold ph-spinner-gap animate-spin text-xl"></i> MENYIMPAN...';
            btnSave.disabled = true;

            const updateData = {};
            const fields = window.FORM_SETTINGS.fields || [];
            
            // Collect semua value dari input dinamis
            fields.forEach(f => {
                const inputEl = document.getElementById(`field_${f.id}`);
                if (inputEl) updateData[f.id] = inputEl.value.trim();
            });

            try {
                // Menyimpan data tambahan ke dalam Metadata Profil user di Supabase
                const { data, error } = await supabaseClient.auth.updateUser({
                    data: updateData
                });

                if (error) throw error;

                // Sembunyikan Modal
                document.getElementById('userDataModal').classList.add('hidden');
                
                // Langsung Trigger Download
                const btn = document.getElementById('btnDownloadGated');
                const dIcon = document.getElementById('downloadIcon');
                const dText = document.getElementById('downloadText');
                executeDownloadFile(btn, dIcon, dText);

            } catch (err) {
                alert("Gagal menyimpan data: " + err.message);
            } finally {
                btnSave.innerHTML = oriText;
                btnSave.disabled = false;
            }
        }

        // FUNGSI INTI DOWNLOAD PDF NATIVE & TRACKING
        async function executeDownloadFile(btn, dIcon, dText) {
            dIcon.className = "ph-bold ph-download-simple text-xl";
            dText.innerText = "DOWNLOADING...";
            
            // Catat Ke Server (Background Process)
            await trackDownloadToBackend();
            
            // Eksekusi Download Programmatic
            const link = document.createElement('a');
            link.href = "/arsip/file/<%= arsip.slug %>.pdf";
            link.download = "<%= arsip.file_name %>";
            document.body.appendChild(link);
            link.click();
            document.body.removeChild(link);

            setTimeout(() => {
                dText.innerText = "UNDUHAN SELESAI (VERIFIED)";
                btn.classList.remove('bg-white');
                btn.classList.add('bg-[#A3E635]'); // Green Success Neubrutalism
            }, 1000);
        }

        // AUTO-CHECK SAAT HALAMAN SELESAI DIMUAT
        window.addEventListener('DOMContentLoaded', async () => {
            if (!supabaseClient) return;
            
            // Cek hash token di URL (menandakan baru saja redirect dari Google/Supabase)
            if (window.location.hash.includes('access_token')) {
                history.replaceState(null, null, window.location.pathname);
            }

            const { data: { session } } = await supabaseClient.auth.getSession();
            const btn = document.getElementById('btnDownloadGated');
            
            if (session) {
                const meta = session.user.user_metadata || {};

                // --- LOGIC FORCE LOGOUT DARI ADMIN ---
                if (meta.is_logged_out === true) {
                    await supabaseClient.auth.signOut();
                    alert("Sesi akses Anda telah diputuskan oleh Sistem Administrator. Silakan login kembali jika diperlukan.");
                    window.location.reload();
                    return; // Hentikan eksekusi script selanjutnya
                }
                
                // 1. SETUP NAVBAR (Tampilkan Nama User & Logout Button)
                const displayName = meta.nama_lengkap || meta.full_name || session.user.email;
                document.getElementById('defaultNavRight').classList.add('hidden');
                document.getElementById('defaultNavRight').classList.remove('sm:flex');
                
                document.getElementById('navUserName').innerText = `👋 HAI, ${displayName.split(' ')[0].toUpperCase()}`;
                document.getElementById('userProfileNav').classList.remove('hidden');
                document.getElementById('userProfileNav').classList.add('flex');

                // 2. SETUP TOMBOL DOWNLOAD JIKA ADA
                if (btn) {
                    const formComplete = isProfileComplete(meta);

                    document.getElementById('downloadIcon').className = formComplete ? "ph-bold ph-check-circle text-xl" : "ph-bold ph-warning-circle text-xl";
                    document.getElementById('downloadText').innerText = formComplete ? "DOWNLOAD PDF (AKSES VALID)" : "LENGKAPI PROFIL & DOWNLOAD";
                    
                    if(formComplete) {
                        btn.classList.remove('bg-white');
                        btn.classList.add('bg-[#A3E635]');
                    }
                }
            }
        });
    </script>

    <!-- UI/UX LOGIC: SPLIT MAGNETIC HUD CURSOR -->
    <script>
        if (window.matchMedia("(hover: hover) and (pointer: fine)").matches) {
            const hudWrapper = document.getElementById('hud-wrapper');
            const hudBrackets = document.getElementById('hud-brackets');
            const hudDot = document.getElementById('hud-dot');

            // Elemen target untuk dikunci (sesuai gaya Neubrutalism)
            const magneticSelector = '.doc-wrapper, .brutal-btn, .brutal-input, .overlay-center > div, .bg-white.p-2, a, button';

            let mouseX = window.innerWidth / 2;
            let mouseY = window.innerHeight / 2;
            let dotX = mouseX, dotY = mouseY;
            let bx = mouseX, by = mouseY;
            let bw = 40, bh = 40; 
            let rot = 0;
            let scale = 1;
            
            let isHovering = false;
            let hoveredEl = null;
            let hasMoved = false;

            // Tracking pergerakan mouse
            window.addEventListener('mousemove', (e) => {
                mouseX = e.clientX;
                mouseY = e.clientY;
                if (!hasMoved) {
                    hasMoved = true;
                    hudWrapper.style.opacity = '1';
                    hudDot.style.opacity = '1';
                    dotX = mouseX; dotY = mouseY;
                    bx = mouseX; by = mouseY;
                }
            }, { passive: true });

            // Efek mekanikal saat diklik
            window.addEventListener('mousedown', () => { if(hasMoved) scale = 0.85; }, { passive: true });
            window.addEventListener('mouseup', () => { if(hasMoved) scale = 1; }, { passive: true });

            // Sembunyikan cursor bila keluar dari jendela browser
            document.addEventListener('mouseleave', () => {
                hudWrapper.style.opacity = '0';
                hudDot.style.opacity = '0';
            });
            document.addEventListener('mouseenter', () => {
                if (hasMoved) {
                    hudWrapper.style.opacity = '1';
                    hudDot.style.opacity = '1';
                }
            });

            // Event Delegation untuk mendeteksi elemen
            document.addEventListener('mouseover', (e) => {
                const target = e.target.closest(magneticSelector);
                if (target) {
                    isHovering = true;
                    hoveredEl = target;
                }
            }, { passive: true });

            document.addEventListener('mouseout', (e) => {
                const target = e.target.closest(magneticSelector);
                if (target) {
                    const relatedTarget = e.relatedTarget ? e.relatedTarget.closest(magneticSelector) : null;
                    if (relatedTarget) {
                        hoveredEl = relatedTarget;
                        isHovering = true;
                    } else {
                        isHovering = false;
                        hoveredEl = null;
                    }
                }
            }, { passive: true });

            // Engine Animasi Berbasis GPU (requestAnimationFrame)
            const renderHUD = () => {
                if (hasMoved) {
                    // 1. FREE TRACKING INNER DOT
                    dotX += (mouseX - dotX) * 0.35;
                    dotY += (mouseY - dotY) * 0.35;
                    hudDot.style.transform = `translate3d(${dotX}px, ${dotY}px, 0)`;

                    let targetBx = mouseX;
                    let targetBy = mouseY;
                    let targetBw = 40;
                    let targetBh = 40;
                    let isMagnetic = false;

                    if (isHovering && hoveredEl && hoveredEl.isConnected) {
                        // 2. MAGNETIC BOUNDING BOX LOCK
                        const rect = hoveredEl.getBoundingClientRect();
                        targetBx = rect.left + rect.width / 2;
                        targetBy = rect.top + rect.height / 2;
                        targetBw = rect.width + 12; // Padding Bracket mengunci box
                        targetBh = rect.height + 12;
                        
                        // 3. LOCK ROTASI KE 0 DERAJAT (Rotasi Smooth)
                        rot = rot % 360;
                        if (rot > 180) rot -= 360;
                        if (rot < -180) rot += 360;
                        rot += (0 - rot) * 0.2; 
                        
                        hudWrapper.classList.add('magnetic-active');
                        isMagnetic = true;
                    } else {
                        // 4. ROTATING IDLE STATE (Berputar ketika tidak memegang elemen)
                        rot += 1.5; 
                        hudWrapper.classList.remove('magnetic-active');
                    }

                    if (isMagnetic) {
                        scale += (1 - scale) * 0.2; 
                    }

                    // 5. ANIMASI INTERPOLASI (LERP) HALUS
                    const lerpFactor = isMagnetic ? 0.3 : 0.15;
                    bx += (targetBx - bx) * lerpFactor;
                    by += (targetBy - by) * lerpFactor;
                    bw += (targetBw - bw) * lerpFactor;
                    bh += (targetBh - bh) * lerpFactor;

                    hudWrapper.style.transform = `translate3d(${bx}px, ${by}px, 0)`;
                    hudBrackets.style.width = `${bw}px`;
                    hudBrackets.style.height = `${bh}px`;
                    hudBrackets.style.transform = `translate(-50%, -50%) rotate(${rot}deg) scale(${scale})`;
                }
                requestAnimationFrame(renderHUD);
            };
            requestAnimationFrame(renderHUD);
        }
    </script>

    <!-- UI/UX LOGIC: NATIVE PROTECT DEVTOOLS & NEUBRUTALISM NOTIFICATION -->
    <script>
        (function() {
            'use strict';

            // Fungsi Memunculkan Toast Notifikasi ala Neubrutalism
            function showSecurityToast(title, message) {
                const existingToast = document.getElementById('axa-security-toast');
                if (existingToast) {
                    existingToast.remove();
                }

                const toast = document.createElement('div');
                toast.id = 'axa-security-toast';
                
                toast.style.cssText = `
                    position: fixed;
                    bottom: 24px;
                    right: 24px;
                    background-color: #FFC900; 
                    color: #000;
                    padding: 16px 20px;
                    border: 4px solid #000;
                    box-shadow: 6px 6px 0px #000;
                    font-family: 'Space Grotesk', 'Plus Jakarta Sans', system-ui, sans-serif;
                    z-index: 2147483647;
                    display: flex;
                    align-items: center;
                    gap: 16px;
                    opacity: 0;
                    transform: translateY(50px);
                    transition: opacity 0.3s ease, transform 0.3s cubic-bezier(0.175, 0.885, 0.32, 1.275);
                    pointer-events: none;
                    max-width: 380px;
                `;

                toast.innerHTML = `
                    <div style="background: #fff; padding: 8px; border: 3px solid #000; box-shadow: 3px 3px 0px #000; flex-shrink: 0; display: flex; align-items: center; justify-content: center;">
                        <svg style="width: 24px; height: 24px; color: #000;" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"></path>
                        </svg>
                    </div>
                    <div>
                        <span style="display: block; font-size: 14px; font-weight: 900; text-transform: uppercase; letter-spacing: 0.5px; border-bottom: 2px solid #000; padding-bottom: 4px; margin-bottom: 4px;">
                            ${title}
                        </span>
                        <span style="display: block; font-size: 12px; font-weight: 700; font-family: 'Plus Jakarta Sans', sans-serif; line-height: 1.4;">
                            ${message}
                        </span>
                    </div>
                `;

                document.body.appendChild(toast);

                requestAnimationFrame(() => {
                    toast.style.opacity = '1';
                    toast.style.transform = 'translateY(0)';
                });

                setTimeout(() => {
                    toast.style.opacity = '0';
                    toast.style.transform = 'translateY(50px)';
                    setTimeout(() => {
                        if (toast.parentNode) toast.remove();
                    }, 300);
                }, 3500);
            }

            // ================= SECURITY ENGINE (PROTECT DEVTOOLS) =================
            // Pasang event listener pada level WINDOW agar menimpa event di dalam object PDF
            
            // 1. Blokir klik kanan (context menu)
            window.addEventListener('contextmenu', function (e) {
                e.preventDefault();
                showSecurityToast("Aksi Diblokir", "Menu konteks (Klik Kanan) dinonaktifkan pada halaman ini.");
            }, { capture: true, passive: false });

            // 2. Cegah penyalinan (Copy Event)
            window.addEventListener('copy', function(e) {
                e.preventDefault();
                showSecurityToast("Akses Papan Klip Ditolak", "Menyalin konten tidak diizinkan untuk melindungi kekayaan intelektual.");
                return false;
            }, { capture: true, passive: false });

            // 3. Cegah berbagai shortcut DevTools, View Source, Save, Copy, & Select All
            window.addEventListener('keydown', function (e) {
                
                // Blokir F12
                if (e.key === 'F12' || e.keyCode === 123) {
                    e.preventDefault();
                    e.stopPropagation();
                    showSecurityToast("Sistem Keamanan Aktif", "Akses ke fitur Developer Tools diblokir.");
                    return false;
                }

                // Blokir Ctrl+Shift+I / J / C (Windows/Linux) ATAU Cmd+Option+I / J / C (Mac OS)
                if ((e.ctrlKey && e.shiftKey) || (e.metaKey && e.altKey)) {
                    var k = e.key.toUpperCase();
                    var code = e.keyCode; 
                    if (k === 'I' || k === 'J' || k === 'C' || code === 73 || code === 74 || code === 67) {
                        e.preventDefault();
                        e.stopPropagation();
                        showSecurityToast("Sistem Keamanan Aktif", "Akses Inspeksi Elemen diblokir oleh administrator.");
                        return false;
                    }
                }

                // Blokir Ctrl+U ATAU Cmd+U (View Source)
                if ((e.ctrlKey || e.metaKey) && (e.key.toUpperCase() === 'U' || e.keyCode === 85)) {
                    e.preventDefault();
                    e.stopPropagation();
                    showSecurityToast("Sistem Keamanan Aktif", "Melihat kode sumber (View Source) tidak diizinkan.");
                    return false;
                }

                // Blokir Ctrl+S ATAU Cmd+S (Save Page)
                if ((e.ctrlKey || e.metaKey) && (e.key.toUpperCase() === 'S' || e.keyCode === 83)) {
                    e.preventDefault();
                    e.stopPropagation();
                    showSecurityToast("Tindakan Dibatalkan", "Menyimpan halaman web ini (Save) dinonaktifkan.");
                    return false;
                }

                // Blokir Ctrl+P ATAU Cmd+P (Print Page / Save as PDF)
                if ((e.ctrlKey || e.metaKey) && (e.key.toUpperCase() === 'P' || e.keyCode === 80)) {
                    e.preventDefault();
                    e.stopPropagation();
                    showSecurityToast("Tindakan Dibatalkan", "Fungsi pencetakan (Print) dokumen ini tidak diizinkan.");
                    return false;
                }

                // Blokir Ctrl+A ATAU Cmd+A (Select All)
                if ((e.ctrlKey || e.metaKey) && (e.key.toUpperCase() === 'A' || e.keyCode === 65)) {
                    e.preventDefault();
                    e.stopPropagation();
                    showSecurityToast("Aksi Terlarang", "Fitur memilih semua teks (Select All) telah dinonaktifkan.");
                    return false;
                }

                // Blokir Ctrl+C ATAU Cmd+C (Copy)
                if ((e.ctrlKey || e.metaKey) && (e.key.toUpperCase() === 'C' || e.keyCode === 67)) {
                    if (!e.shiftKey) {
                        e.preventDefault();
                        e.stopPropagation();
                        showSecurityToast("Akses Papan Klip Ditolak", "Menyalin teks (Copy) tidak diizinkan pada dokumen ini.");
                        return false;
                    }
                }

            }, { capture: true, passive: false });

        })();
    </script>
