<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= meta.title %></title>
    
    <link rel="icon" type="image/png" href="/axalogo.png">
    <link rel="apple-touch-icon" href="/axalogo.png">

    <meta name="description" content="<%= meta.desc %>">
    <meta name="keywords" content="<%= meta.keywords %>">
    <link rel="canonical" href="<%= meta.canonical %>">
    
    <meta property="og:type" content="<%= meta.type %>">
    <meta property="og:url" content="<%= meta.canonical %>">
    <meta property="og:title" content="<%= meta.title %>">
    <meta property="og:description" content="<%= meta.desc %>">
    <meta property="og:image" content="<%= baseUrl %><%= meta.ogImage %>">

    <% 
        // Helper Parser Date Khusus Google (ISO 8601 & YYYY/MM/DD)
        let isoDate = arsip.date;
        let scholarDate = arsip.date;
        let displayDate = arsip.date; 
        
        if(isoDate && isoDate.match(/^\d{2}-\d{2}-\d{4}$/)) {
            const parts = isoDate.split('-');
            isoDate = `${parts[2]}-${parts[1]}-${parts[0]}`; 
            scholarDate = `${parts[2]}/${parts[1]}/${parts[0]}`; 
            displayDate = arsip.date; 
        } else if (isoDate && isoDate.match(/^\d{4}-\d{2}-\d{2}$/)) {
            const parts = isoDate.split('-');
            displayDate = `${parts[2]}-${parts[1]}-${parts[0]}`; 
            scholarDate = isoDate.replace(/-/g, '/');
        }
        
        // GSC JSON PROTECTOR
        const safeTitle = (arsip.title || '').replace(/"/g, '\\"').replace(/(\r\n|\n|\r)/gm, " ");
        const safeDesc = (arsip.desc || '').replace(/"/g, '\\"').replace(/(\r\n|\n|\r)/gm, " ");
        const isFree = arsip.access_type === 'Open Access' ? 'true' : 'false';
    %>

    <meta name="citation_title" content="<%- safeTitle %>">
    <meta name="citation_author" content="drg. M. Aksa Arsyad, S.KG">
    <% if (scholarDate) { %><meta name="citation_publication_date" content="<%= scholarDate %>"><% } %>
    <meta name="citation_journal_title" content="Axa System Knowledge Base">
    <meta name="citation_language" content="id">
    
    <% if(arsip.access_type === 'Open Access') { %>
    <meta name="citation_pdf_url" content="<%= baseUrl %>/arsip/file/<%= arsip.slug %>.pdf">
    <% } %>

    <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@graph": [
        {
          "@type": "ScholarlyArticle",
          "@id": "<%= meta.canonical %>#article",
          "headline": "<%- safeTitle %>",
          "description": "<%- safeDesc %>",
          "url": "<%= meta.canonical %>",
          "datePublished": "<%= isoDate %>",
          "author": {
            "@type": "Person",
            "name": "drg. M. Aksa Arsyad, S.KG"
          },
          "publisher": {
            "@type": "Organization",
            "name": "Axa System Knowledge Base",
            "logo": {
              "@type": "ImageObject",
              "url": "<%= baseUrl %>/axalogo.png"
            }
          },
          "isAccessibleForFree": <%= isFree %>
        },
        {
          "@type": "BreadcrumbList",
          "@id": "<%= meta.canonical %>#breadcrumb",
          "itemListElement": [
            { "@type": "ListItem", "position": 1, "name": "Beranda", "item": "<%= baseUrl %>/" },
            { "@type": "ListItem", "position": 2, "name": "Arsip Materi", "item": "<%= baseUrl %>/arsip" },
            { "@type": "ListItem", "position": 3, "name": "<%- safeTitle %>", "item": "<%= meta.canonical %>" }
          ]
        }
      ]
    }
    </script>

    <script src="https://cdn.tailwindcss.com"></script>
    <script src="https://unpkg.com/@phosphor-icons/web"></script>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;700;800&family=Space+Grotesk:wght@700;900&display=swap" rel="stylesheet">
    <style>
        body { background-color: #030712; color: #fff; font-family: 'Plus Jakarta Sans', sans-serif; overflow-x: hidden; }
        .glass-header { background: rgba(3, 7, 18, 0.8); backdrop-filter: blur(20px); border-bottom: 1px solid rgba(255,255,255,0.1); }
        
        .doc-wrapper { position: relative; width: 100%; height: 80vh; min-height: 600px; max-height: 950px; overflow: hidden; border-radius: 1.5rem; background: #1a1a1a; border: 1px solid rgba(0,229,255,0.3); box-shadow: 0 20px 50px rgba(0,0,0,0.8), 0 0 30px rgba(0,229,255,0.1);}
        
        .doc-object { width: 100%; height: 100%; border: none; background: transparent; transition: filter 0.3s; }
        
        /* Efek blur 100% (Khusus Restricted) */
        .blur-full { filter: blur(12px) grayscale(50%); pointer-events: none; user-select: none; }
        
        .overlay-center {
            position: absolute; inset: 0;
            display: flex; flex-direction: column; justify-content: center; align-items: center;
            background: rgba(3, 7, 18, 0.5); 
            z-index: 20; padding: 2rem;
        }

        .brutal-btn {
            background: #00E5FF; color: #000; font-family: 'Space Grotesk', sans-serif; font-weight: 900;
            border: 2px solid #fff; box-shadow: 6px 6px 0px rgba(255,255,255,0.9); transition: all 0.2s;
            text-transform: uppercase; letter-spacing: 0.1em;
        }
        .brutal-btn:hover { transform: translate(-2px, -2px); box-shadow: 8px 8px 0px #fff; }
        .brutal-btn:active { transform: translate(3px, 3px); box-shadow: 0px 0px 0px #fff; }

        .brutal-btn-green {
            background: #4ade80; color: #000; border-color: #fff; box-shadow: 6px 6px 0px rgba(255,255,255,0.9);
        }

        /* Animasi Modal Neo-Brutalism */
        .modal-enter { animation: popIn 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275) forwards; }
        @keyframes popIn { 
            0% { opacity: 0; transform: scale(0.8) translateY(20px); } 
            100% { opacity: 1; transform: scale(1) translateY(0); } 
        }
    </style>
</head>
<body class="antialiased selection:bg-cyan-500 selection:text-black">

    <nav class="glass-header sticky top-0 z-50 w-full shadow-lg">
        <div class="container mx-auto px-4 py-4 flex justify-between items-center max-w-5xl">
            <a href="/arsip" class="text-sm font-bold text-gray-300 hover:text-cyan-400 flex items-center gap-2 transition-colors uppercase tracking-widest font-mono">
                <i class="ph-bold ph-arrow-left text-lg"></i> Direktori Utama
            </a>
            <div class="text-[10px] text-gray-500 font-mono hidden sm:flex items-center gap-2">
                <i class="ph-fill ph-shield-check text-green-400"></i> Secure Stream Server
            </div>
        </div>
    </nav>

    <main class="container mx-auto px-4 py-10 max-w-4xl min-h-screen">
        
        <article itemscope itemtype="http://schema.org/ScholarlyArticle">
            <header class="mb-12 text-center">
                <span class="inline-block text-[10px] font-mono font-black uppercase tracking-widest text-cyan-400 bg-cyan-400/10 px-4 py-2 rounded-full border border-cyan-400/30 mb-5 shadow-[0_0_15px_rgba(0,229,255,0.2)]">
                    <i class="ph-fill ph-folder mr-1"></i> <span itemprop="articleSection"><%= arsip.category %></span>
                </span>
                
                <h1 itemprop="headline" class="text-3xl md:text-5xl font-black font-['Space_Grotesk'] mb-5 leading-tight"><%= arsip.title %></h1>
                
                <p itemprop="description" class="text-gray-400 text-sm max-w-2xl mx-auto leading-relaxed break-words whitespace-normal"><%= arsip.desc %></p>
                
                <div class="mt-8 flex justify-center items-center gap-4 text-xs font-mono text-gray-500 bg-gray-900/50 w-max mx-auto px-5 py-2.5 rounded-xl border border-gray-800 flex-wrap">
                    <span class="text-white break-all"><i class="ph-bold ph-file-pdf text-red-400"></i> <%= arsip.file_name %></span>
                    <span class="hidden sm:inline">•</span>
                    <span><i class="ph-bold ph-calendar-blank"></i> <time itemprop="datePublished" datetime="<%= isoDate %>"><%= displayDate %></time></span>
                    <span class="hidden sm:inline">•</span>
                    
                    <% if(arsip.access_type === 'Open Access') { %>
                        <span class="text-green-400"><i class="ph-fill ph-check-circle"></i> Open Access</span>
                    <% } else { %>
                        <span class="text-yellow-400"><i class="ph-fill ph-lock-key"></i> Restricted</span>
                    <% } %>
                </div>
            </header>

            <div class="doc-wrapper">
                <% if(arsip.access_type === 'Restricted') { %>
                    <object data="/arsip/file/<%= arsip.slug %>.pdf#toolbar=0&navpanes=0&scrollbar=0" type="application/pdf" class="doc-object blur-full">
                        <div class="flex flex-col items-center justify-center h-full bg-gray-900 text-gray-400 p-8 text-center"><i class="ph-fill ph-file-pdf text-6xl text-gray-600 mb-4"></i></div>
                    </object>
                    
                    <div class="overlay-center">
                        <div class="bg-[#0b0f19]/95 backdrop-blur-3xl border-2 border-cyan-500/50 p-8 rounded-3xl text-center max-w-lg shadow-[0_30px_60px_rgba(0,0,0,0.9),inset_0_0_20px_rgba(0,229,255,0.15)]">
                            <div class="w-20 h-20 bg-cyan-500/10 rounded-full flex items-center justify-center mx-auto mb-5 border border-cyan-400/30">
                                <i class="ph-fill ph-lock-key text-4xl text-cyan-400 drop-shadow-[0_0_10px_rgba(0,229,255,0.8)] animate-pulse"></i>
                            </div>
                            <h3 class="text-2xl md:text-3xl font-black font-['Space_Grotesk'] mb-3 text-white">Pratinjau Terkunci</h3>
                            <p class="text-xs md:text-sm text-gray-400 mb-8 font-medium leading-relaxed">Halaman ini mengunci tampilan penuh dokumen PDF untuk mencegah penyalinan otomatis (Scraping). Silakan verifikasi identitas Anda untuk mengunduh dokumen secara utuh.</p>
                            
                            <button id="btnDownloadGated" onclick="handleSecureDownload()" class="brutal-btn inline-flex items-center justify-center gap-3 px-8 py-4 w-full rounded-xl text-sm md:text-base cursor-pointer">
                                <i id="downloadIcon" class="ph-bold ph-google-logo text-xl"></i> 
                                <span id="downloadText">Sign in Google & Download</span>
                            </button>
                        </div>
                    </div>

                <% } else { %>
                    <object data="/arsip/file/<%= arsip.slug %>.pdf" type="application/pdf" class="doc-object">
                        <div class="flex flex-col items-center justify-center h-full bg-gray-900 text-gray-400 p-8 text-center">
                            <i class="ph-fill ph-file-pdf text-6xl text-gray-600 mb-4"></i>
                            <p>Pratinjau PDF Native tidak didukung oleh browser Anda.</p>
                            <a href="/arsip/file/<%= arsip.slug %>.pdf" class="mt-4 text-cyan-400 underline font-bold">Unduh File PDF Langsung</a>
                        </div>
                    </object>

                    <a href="/arsip/file/<%= arsip.slug %>.pdf" target="_blank" rel="noopener noreferrer" itemprop="url" class="absolute bottom-6 right-6 brutal-btn brutal-btn-green px-6 py-3.5 rounded-2xl text-xs md:text-sm flex items-center gap-2 z-30 opacity-90 hover:opacity-100 hover:-translate-y-1 transition-all shadow-[6px_6px_0px_rgba(255,255,255,0.9)]">
                        <i class="ph-bold ph-arrow-square-out text-lg"></i> Buka Full PDF Native
                    </a>
                <% } %>
            </div>
        </article>
    </main>

    <div id="userDataModal" class="fixed inset-0 z-[9999] hidden bg-[#030712]/90 backdrop-blur-md flex items-center justify-center p-4">
        <div class="bg-[#0b0f19] border-2 border-[#00E5FF] p-6 md:p-8 rounded-2xl max-w-md w-full shadow-[8px_8px_0px_rgba(0,229,255,0.6)] modal-enter relative">
            <div class="w-16 h-16 bg-cyan-500/10 rounded-full flex items-center justify-center mb-5 border border-cyan-400/30">
                <i class="ph-fill ph-identification-card text-3xl text-cyan-400"></i>
            </div>
            <h3 class="text-2xl font-black font-['Space_Grotesk'] mb-2 text-white">Lengkapi Profil Akses</h3>
            <p class="text-gray-400 text-xs md:text-sm font-medium mb-6">Sebelum melanjutkan unduhan, harap isi data akademis/institusi Anda (hanya perlu diisi 1x).</p>

            <form id="formUserData" onsubmit="submitUserData(event)" class="space-y-5">
                <div>
                    <label class="text-[10px] text-gray-400 font-mono mb-1 block uppercase font-bold tracking-widest">Nama Lengkap (Sesuai KTP/Gelar)</label>
                    <input type="text" id="inputFullName" required class="w-full bg-[#030712] border border-gray-800 rounded-xl px-4 py-3 focus:outline-none focus:border-cyan-400 text-sm font-bold shadow-inner transition-colors" placeholder="Masukkan nama...">
                </div>
                <div>
                    <label class="text-[10px] text-gray-400 font-mono mb-1 block uppercase font-bold tracking-widest">Asal Universitas / Instansi</label>
                    <input type="text" id="inputInstitution" required class="w-full bg-[#030712] border border-gray-800 rounded-xl px-4 py-3 focus:outline-none focus:border-cyan-400 text-sm font-bold shadow-inner transition-colors" placeholder="Contoh: Univ. Hasanuddin - FKG">
                </div>
                <button type="submit" id="btnSaveData" class="brutal-btn w-full py-3.5 rounded-xl text-sm flex justify-center items-center gap-2 mt-4 cursor-pointer">
                    <i class="ph-bold ph-floppy-disk text-lg"></i> Simpan & Lanjutkan Download
                </button>
            </form>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>
    <script>
        // Placeholder Settings untuk Integrasi Admin Dashboard di Masa Depan
        window.FORM_REQUIREMENTS = {
            requireForm: true
        };

        const SUPABASE_URL = "<%= typeof supabaseUrl !== 'undefined' ? supabaseUrl : '' %>"; 
        const SUPABASE_ANON_KEY = "<%= typeof supabaseAnonKey !== 'undefined' ? supabaseAnonKey : '' %>"; 
        
        // PERBAIKAN BUG: Nama variabel diganti menjadi supabaseClient agar tidak bentrok dengan fungsi internal CDN Supabase.
        let supabaseClient = null;
        if (SUPABASE_URL && SUPABASE_ANON_KEY) {
            supabaseClient = window.supabase.createClient(SUPABASE_URL, SUPABASE_ANON_KEY);
        }

        // FUNGSI UTAMA TOMBOL KLIK
        async function handleSecureDownload() {
            if (!supabaseClient) return alert("Sistem Autentikasi tidak terhubung ke server.");

            const btn = document.getElementById('btnDownloadGated');
            const dIcon = document.getElementById('downloadIcon');
            const dText = document.getElementById('downloadText');

            dIcon.className = "ph-bold ph-spinner-gap animate-spin text-xl";
            dText.innerText = "Checking Authorization...";

            const { data: { session } } = await supabaseClient.auth.getSession();

            if (!session) {
                // BELUM LOGIN -> Buka Google Sign In
                const { error } = await supabaseClient.auth.signInWithOAuth({
                    provider: 'google',
                    options: { redirectTo: window.location.href }
                });
                
                if (error) {
                    alert("Gagal memanggil Google Login: " + error.message);
                    dIcon.className = "ph-bold ph-google-logo text-xl";
                    dText.innerText = "Sign in Google & Download";
                }
            } else {
                // SUDAH LOGIN -> Cek Metadata Form User
                checkUserMetadataAndProceed(session.user);
            }
        }

        // FUNGSI CEK DATA LENGKAP
        async function checkUserMetadataAndProceed(user) {
            const btn = document.getElementById('btnDownloadGated');
            const dIcon = document.getElementById('downloadIcon');
            const dText = document.getElementById('downloadText');

            const meta = user.user_metadata || {};
            
            // Cek apakah institusi sudah diisi (Syarat Admin Setting)
            if (window.FORM_REQUIREMENTS.requireForm && (!meta.institusi_asal || !meta.nama_lengkap)) {
                // Buka Form Input Profil
                document.getElementById('userDataModal').classList.remove('hidden');
                
                // Prefill nama dari Google jika ada
                if(meta.full_name && !meta.nama_lengkap) {
                    document.getElementById('inputFullName').value = meta.full_name;
                }
                
                // Kembalikan status tombol seperti semula
                dIcon.className = "ph-bold ph-google-logo text-xl";
                dText.innerText = "Lengkapi Data Profil";
            } else {
                // Data sudah lengkap -> Eksekusi Download
                executeDownloadFile(btn, dIcon, dText);
            }
        }

        // FUNGSI SUBMIT FORM IDENTITAS (Update Profile ke Supabase Database internal)
        async function submitUserData(event) {
            event.preventDefault();
            const btnSave = document.getElementById('btnSaveData');
            const oriText = btnSave.innerHTML;
            btnSave.innerHTML = '<i class="ph-bold ph-spinner-gap animate-spin text-lg"></i> Menyimpan...';
            btnSave.disabled = true;

            const fullName = document.getElementById('inputFullName').value.trim();
            const institution = document.getElementById('inputInstitution').value.trim();

            try {
                // Menyimpan data tambahan (Nama Lengkap, Institusi) ke dalam Metadata Profil user di Supabase
                const { data, error } = await supabaseClient.auth.updateUser({
                    data: { 
                        nama_lengkap: fullName,
                        institusi_asal: institution
                    }
                });

                if (error) throw error;

                // Sembunyikan Modal
                document.getElementById('userDataModal').classList.add('hidden');
                
                // Langsung Trigger Download
                const btn = document.getElementById('btnDownloadGated');
                const dIcon = document.getElementById('downloadIcon');
                const dText = document.getElementById('downloadText');
                executeDownloadFile(btn, dIcon, dText);

            } catch (err) {
                alert("Gagal menyimpan data: " + err.message);
            } finally {
                btnSave.innerHTML = oriText;
                btnSave.disabled = false;
            }
        }

        // FUNGSI INTI DOWNLOAD PDF NATIVE
        function executeDownloadFile(btn, dIcon, dText) {
            dIcon.className = "ph-bold ph-download-simple text-xl";
            dText.innerText = "Downloading...";
            
            const link = document.createElement('a');
            link.href = "/arsip/file/<%= arsip.slug %>.pdf";
            link.download = "<%= arsip.file_name %>";
            document.body.appendChild(link);
            link.click();
            document.body.removeChild(link);

            setTimeout(() => {
                dText.innerText = "Download PDF Full (Verified)";
                btn.style.backgroundColor = "#4ade80"; // Hijau Success
                btn.style.color = "#000";
                btn.style.borderColor = "#fff";
                btn.style.boxShadow = "6px 6px 0px rgba(255,255,255,0.9)";
            }, 1000);
        }

        // AUTO-CHECK SAAT HALAMAN SELESAI DIMUAT (Kembali dari halaman login Google)
        window.addEventListener('DOMContentLoaded', async () => {
            if (!supabaseClient) return;
            const { data: { session } } = await supabaseClient.auth.getSession();
            const btn = document.getElementById('btnDownloadGated');
            
            if (session && btn) {
                // Ubah tampilan awal tombol menjadi Verified jika profil lengkap
                const meta = session.user.user_metadata || {};
                const isFormComplete = meta.institusi_asal && meta.nama_lengkap;

                document.getElementById('downloadIcon').className = isFormComplete ? "ph-bold ph-download-simple text-xl" : "ph-bold ph-warning-circle text-xl";
                document.getElementById('downloadText').innerText = isFormComplete ? "Download PDF Full (Verified)" : "Lengkapi Profil & Download";
                
                if(isFormComplete) {
                    btn.style.backgroundColor = "#4ade80"; 
                    btn.style.color = "#000";
                    btn.style.borderColor = "#fff";
                    btn.style.boxShadow = "6px 6px 0px rgba(255,255,255,0.9)";
                }
            }
        });
    </script>
</body>
</html>
