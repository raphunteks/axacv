                newItem.Tanggal = document.getElementById('adm-tanggal').value.trim();
            }

            if(!newItem.Judul || !newItem.Gambar) {
                alert("Judul dan Gambar wajib diisi!");
                return;
            }

            if(currentEditIndex === -1) {
                dataArray.push(newItem);
            } else {
                dataArray[currentEditIndex] = newItem;
            }

            if(currentAdminTab === 'proyek') globalSheetData.proyek = dataArray;
            if(currentAdminTab === 'hobi') globalSheetData.sertifHobi = dataArray;
            if(currentAdminTab === 'pdgi') globalSheetData.sertifPDGI = dataArray;

            tutupFormItem();
            renderAdminGUIList();
            
            // AUTO PUSH KE SPREADSHEET (REALTIME)
            simpanDatabaseMain();
        }

        function hapusItem(index) {
            if(!confirm("Yakin ingin menghapus data ini? Data di Google Sheets akan langsung terhapus.")) return;
            
            let dataArray = [];
            if(currentAdminTab === 'proyek') dataArray = globalSheetData.proyek;
            if(currentAdminTab === 'hobi') dataArray = globalSheetData.sertifHobi;
            if(currentAdminTab === 'pdgi') dataArray = globalSheetData.sertifPDGI;

            dataArray.splice(index, 1);
            renderAdminGUIList();
            
            // AUTO PUSH KE SPREADSHEET (REALTIME)
            simpanDatabaseMain();
        }
        
        function simpanDatabaseMain() {
            let payload = { user: 'axaaxyz_01', pass: 'axaxyz999' };
            
            if (currentAdminTab === 'cv') {
                const btn = document.getElementById('btnSimpanCV'); 
                const notif = document.getElementById('adminNotif');
                try { 
                    payload.newData = JSON.parse(document.getElementById('jsonEditor').value); 
                } catch(e) { 
                    alert("Format JSON Data CV tidak valid! Pastikan koma dan tanda kutip benar."); return; 
                }
                payload.action = 'updateCV';
                
                btn.disabled = true; btn.innerHTML = '<i class="ph-bold ph-spinner-gap animate-spin mr-1" aria-hidden="true"></i> Processing...'; notif.classList.add('hidden');

                fetch(GAS_URL, { method: 'POST', headers: { "Content-Type": "text/plain;charset=utf-8" }, body: JSON.stringify(payload) })
                .then(res => res.json())
                .then(res => {
                    if(res.status === 'success') {
                        notif.innerHTML = "<i class='ph-fill ph-check-circle' aria-hidden='true'></i> Data CV Tersimpan!";
                        notif.classList.remove('hidden', 'bg-red-500/20', 'text-red-500'); 
                        notif.classList.add('bg-green-500/20', 'text-green-500');
                        globalCVData = payload.newData; 
                        renderSeluruhUI(globalCVData, globalSheetData); 
                    } else {
                        notif.textContent = "Error: " + res.message;
                        notif.classList.remove('hidden', 'bg-green-500/20', 'text-green-500'); 
                        notif.classList.add('bg-red-500/20', 'text-red-500');
                    }
                })
                .catch(err => {
                    notif.textContent = "Connection Timeout.";
                    notif.classList.remove('hidden', 'bg-green-500/20', 'text-green-500'); 
                    notif.classList.add('bg-red-500/20', 'text-red-500');
                }).finally(() => { 
                    btn.disabled = false; 
                    btn.innerHTML = '<i class="ph-fill ph-cloud-arrow-up text-base md:text-lg" aria-hidden="true"></i> Push Data CV ke Database'; 
                });
                
            } else {
                // LOGIC AUTO-PUSH UNTUK TAB PROYEK & SERTIFIKASI
                let toast = document.createElement('div');
                toast.className = "fixed top-4 right-4 bg-yellow-500 text-black px-4 py-2 rounded-lg font-bold shadow-lg z-[10000] flex items-center gap-2 transition-all";
                toast.innerHTML = '<i class="ph-bold ph-spinner-gap animate-spin"></i> Menyinkronkan ke Spreadsheet...';
                document.body.appendChild(toast);

                payload.action = 'updateSheet';
                if(currentAdminTab === 'proyek') { payload.sheetName = 'Proyek_Web'; payload.data = globalSheetData.proyek; }
                if(currentAdminTab === 'hobi') { payload.sheetName = 'Sertifikasi_Hobi'; payload.data = globalSheetData.sertifHobi; }
                if(currentAdminTab === 'pdgi') { payload.sheetName = 'Sertifikasi_PDGI'; payload.data = globalSheetData.sertifPDGI; }
                
                fetch(GAS_URL, { method: 'POST', headers: { "Content-Type": "text/plain;charset=utf-8" }, body: JSON.stringify(payload) })
                .then(res => res.json())
                .then(res => {
                    if(res.status === 'success') {
                        toast.className = "fixed top-4 right-4 bg-green-500 text-white px-4 py-2 rounded-lg font-bold shadow-lg z-[10000] flex items-center gap-2 transition-all";
                        toast.innerHTML = "<i class='ph-bold ph-check-circle'></i> Tersimpan ke Google Sheets!";
                        renderSeluruhUI(globalCVData, globalSheetData);
                    } else {
                        toast.className = "fixed top-4 right-4 bg-red-500 text-white px-4 py-2 rounded-lg font-bold shadow-lg z-[10000] flex items-center gap-2 transition-all";
                        toast.innerHTML = "<i class='ph-bold ph-warning-circle'></i> Gagal: " + res.message;
                    }
                    setTimeout(() => toast.remove(), 3000);
                })
                .catch(err => {
                    toast.className = "fixed top-4 right-4 bg-red-500 text-white px-4 py-2 rounded-lg font-bold shadow-lg z-[10000] flex items-center gap-2 transition-all";
                    toast.innerHTML = "<i class='ph-bold ph-warning-circle'></i> Koneksi Terputus!";
                    setTimeout(() => toast.remove(), 3000);
                });
            }
        }
    </script>
    <script src="protect-devtools.js" defer></script>
</body>
</html>
