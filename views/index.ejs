            <input type="password" id="adminPass" placeholder="Passcode" aria-label="Password" class="w-full mb-6 md:mb-8 bg-[var(--bg-main)] border-2 border-[var(--border-heavy)] rounded-xl px-5 py-3.5 text-sm md:text-base text-[var(--text-main)] font-mono focus:border-[var(--color-primary)] outline-none transition-all shadow-inner focus:shadow-[0_0_15px_rgba(var(--color-primary-rgb),0.3)]">
            <button onclick="cekLogin()" class="w-full bg-[var(--color-primary)] hover:brightness-125 text-[var(--bg-main)] font-black uppercase tracking-widest py-3.5 md:py-4 rounded-xl transition-all text-sm md:text-base shadow-[0_0_20px_rgba(var(--color-primary-rgb),0.6)] outline-none hover:-translate-y-1 active:scale-95">Initialize Override</button>
            <button onclick="tutupAdmin()" class="w-full mt-4 md:mt-5 text-[var(--text-muted)] hover:text-white text-xs md:text-sm transition-colors font-bold py-2 outline-none uppercase tracking-widest active:scale-95">Abort</button>
            <p id="loginErr" class="text-red-500 text-xs md:text-sm mt-4 md:mt-5 hidden font-mono bg-red-500/10 border border-red-500/30 py-3 rounded-lg break-words w-full" aria-live="assertive">ACCESS DENIED.</p>
        </div>
        
        <div id="admin-dashboard" class="premium-card p-4 sm:p-8 max-w-6xl w-full h-[95vh] md:h-[90vh] flex flex-col hidden mx-auto relative overflow-hidden border-[var(--color-primary)] shadow-[0_0_50px_rgba(var(--color-primary-rgb),0.2)]">
            <div class="flex justify-between items-center mb-4 md:mb-6 border-b-2 border-[var(--border-heavy)] pb-4 md:pb-5 gap-2 w-full min-w-0">
                <h2 class="text-lg md:text-2xl font-black text-[var(--text-main)] flex items-center gap-2 md:gap-3 truncate tracking-tight min-w-0"><i class="ph-fill ph-database text-[var(--color-primary)] shrink-0 animate-pulse" aria-hidden="true"></i> <span class="truncate">Master Core Editor</span></h2>
                <button onclick="tutupAdmin()" aria-label="Tutup Editor" class="text-[var(--text-muted)] hover:text-red-500 transition-colors bg-[var(--bg-main)] hover:bg-red-500/20 p-2 rounded-xl shrink-0 border border-[var(--border-color)] hover:border-red-500/50 outline-none active:scale-95"><i class="ph-bold ph-power text-xl" aria-hidden="true"></i></button>
            </div>
            
            <div class="flex gap-2 md:gap-3 mb-4 md:mb-5 overflow-x-auto custom-scrollbar pb-3 shrink-0 w-full">
                <button onclick="switchAdminTab('cv')" id="tab-cv" class="admin-tab active bg-[var(--color-primary)] text-[var(--bg-main)] px-4 md:px-5 py-2 md:py-2.5 rounded-xl font-black text-[11px] md:text-sm transition-all shrink-0 shadow-[0_5px_15px_rgba(var(--color-primary-rgb),0.4)] tracking-wide active:scale-95">Data Core (CV)</button>
                <button onclick="switchAdminTab('proyek')" id="tab-proyek" class="admin-tab bg-[var(--bg-overlay)] text-[var(--text-main)] hover:bg-[rgba(var(--color-primary-rgb),0.2)] px-4 md:px-5 py-2 md:py-2.5 rounded-xl font-bold text-[11px] md:text-sm transition-all shrink-0 border border-[var(--border-heavy)] hover:border-[var(--color-primary)] tracking-wide active:scale-95">Proyek Web</button>
                <button onclick="switchAdminTab('hobi')" id="tab-hobi" class="admin-tab bg-[var(--bg-overlay)] text-[var(--text-main)] hover:bg-[rgba(var(--color-primary-rgb),0.2)] px-4 md:px-5 py-2 md:py-2.5 rounded-xl font-bold text-[11px] md:text-sm transition-all shrink-0 border border-[var(--border-heavy)] hover:border-[var(--color-primary)] tracking-wide active:scale-95">Sertif Hobi</button>
                <button onclick="switchAdminTab('pdgi')" id="tab-pdgi" class="admin-tab bg-[var(--bg-overlay)] text-[var(--text-main)] hover:bg-[rgba(var(--color-primary-rgb),0.2)] px-4 md:px-5 py-2 md:py-2.5 rounded-xl font-bold text-[11px] md:text-sm transition-all shrink-0 border border-[var(--border-heavy)] hover:border-[var(--color-primary)] tracking-wide active:scale-95">Sertif PDGI</button>
            </div>

            <div id="admin-json-view" class="flex flex-col flex-grow min-h-0 w-full">
                <p class="text-[9px] md:text-xs text-[var(--color-secondary)] mb-2 md:mb-3 shrink-0 font-mono font-bold break-words w-full">* JSON Core Override. Format must remain structurally intact. Verify before pushing.</p>
                <textarea id="jsonEditor" class="flex-grow w-full bg-[#050505] border-2 border-[var(--border-heavy)] rounded-2xl p-3 md:p-6 text-[var(--color-primary)] font-mono text-[10px] md:text-sm focus:outline-none focus:border-[var(--color-primary)] resize-none custom-scrollbar leading-relaxed shadow-[inset_0_0_20px_rgba(0,0,0,0.8)]"></textarea>
            </div>

            <div id="admin-gui-view" class="hidden flex-col flex-grow min-h-0 relative w-full">
                <div id="admin-item-list" class="flex-grow overflow-y-auto space-y-4 pr-3 custom-scrollbar pb-20 w-full">
                </div>
                
                <div class="absolute bottom-0 left-0 right-0 pt-4 pb-2 bg-gradient-to-t from-[var(--bg-card-heavy)] via-[var(--bg-card-heavy)] to-transparent w-full">
                    <button onclick="bukaFormItem(-1)" class="w-full py-3 md:py-3.5 bg-[rgba(var(--color-primary-rgb),0.1)] border-2 border-dashed border-[var(--color-primary)] text-[var(--color-primary)] font-black text-xs md:text-sm uppercase tracking-widest rounded-xl hover:bg-[var(--color-primary)] hover:text-[var(--bg-main)] transition-all shadow-lg hover:shadow-[0_0_20px_rgba(var(--color-primary-rgb),0.5)] active:scale-95">
                        + Tambah Data Baru
                    </button>
                </div>

                <div id="admin-item-form" class="hidden absolute inset-0 bg-[var(--bg-card-heavy)] backdrop-blur-3xl p-4 sm:p-8 flex flex-col z-20 rounded-2xl border-2 border-[var(--color-primary)] overflow-y-auto shadow-[0_0_40px_rgba(var(--color-primary-rgb),0.3)] w-full">
                    <h3 id="form-item-title" class="font-black text-lg md:text-2xl mb-4 md:mb-5 text-[var(--text-main)] border-b-2 border-[var(--border-heavy)] pb-3 w-full truncate">Tambah Data</h3>
                    
                    <div class="space-y-4 flex-grow w-full">
                        <div class="w-full">
                            <label class="block text-[10px] md:text-[11px] text-[var(--text-muted)] font-bold mb-1.5 uppercase tracking-wide">Judul *</label>
                            <input type="text" id="adm-judul" placeholder="Masukkan Judul..." class="w-full bg-[var(--bg-main)] border border-[var(--border-heavy)] rounded-xl px-3 md:px-4 py-2.5 md:py-3 text-sm text-[var(--text-main)] focus:border-[var(--color-primary)] outline-none font-medium">
                        </div>
                        
                        <div class="w-full">
                            <label class="block text-[10px] md:text-[11px] text-[var(--text-muted)] font-bold mb-1.5 uppercase tracking-wide">Gambar (Upload File / Paste URL) *</label>
                            <div class="flex flex-col md:flex-row gap-3 md:items-center w-full">
                                <input type="text" id="adm-gambar" placeholder="Menunggu URL gambar..." class="w-full flex-grow bg-[var(--bg-main)] border border-[var(--border-heavy)] rounded-xl px-3 md:px-4 py-2.5 md:py-3 text-sm text-[var(--text-main)] focus:border-[var(--color-primary)] outline-none font-medium">
                                <label class="bg-[var(--color-secondary)] hover:brightness-125 text-white px-4 md:px-5 py-2.5 md:py-3 rounded-xl cursor-pointer text-xs md:text-sm font-black shrink-0 transition-all flex justify-center items-center gap-2 shadow-lg whitespace-nowrap hover:-translate-y-0.5 w-full md:w-auto active:scale-95">
                                    <i class="ph-bold ph-upload-simple"></i> Upload File
                                    <input type="file" id="adm-file-upload" accept="image/*" class="hidden" onchange="handleImageUpload(this)">
                                </label>
                            </div>
                            <p id="upload-status" class="text-[9px] md:text-[10px] text-[var(--color-primary)] mt-2 hidden font-bold break-words w-full"></p>
                        </div>
                        
                        <div id="field-deskripsi" class="w-full">
                            <label class="block text-[10px] md:text-[11px] text-[var(--text-muted)] font-bold mb-1.5 uppercase tracking-wide">Deskripsi Singkat (Proyek)</label>
                            <textarea id="adm-deskripsi" rows="4" placeholder="Deskripsi..." class="w-full bg-[var(--bg-main)] border border-[var(--border-heavy)] rounded-xl px-3 md:px-4 py-2.5 md:py-3 text-sm text-[var(--text-main)] focus:border-[var(--color-primary)] outline-none resize-none font-medium"></textarea>
                        </div>
                        <div id="field-link" class="w-full">
                            <label class="block text-[10px] md:text-[11px] text-[var(--text-muted)] font-bold mb-1.5 uppercase tracking-wide">Link URL Proyek (Opsional)</label>
                            <input type="text" id="adm-link" placeholder="https://..." class="w-full bg-[var(--bg-main)] border border-[var(--border-heavy)] rounded-xl px-3 md:px-4 py-2.5 md:py-3 text-sm text-[var(--text-main)] focus:border-[var(--color-primary)] outline-none font-medium">
                        </div>
                        
                        <div id="field-subjudul" class="hidden w-full">
                            <label class="block text-[10px] md:text-[11px] text-[var(--text-muted)] font-bold mb-1.5 uppercase tracking-wide">Penyelenggara Sertifikat</label>
                            <input type="text" id="adm-subjudul" placeholder="e.g. Kementerian Kominfo" class="w-full bg-[var(--bg-main)] border border-[var(--border-heavy)] rounded-xl px-3 md:px-4 py-2.5 md:py-3 text-sm text-[var(--text-main)] focus:border-[var(--color-primary)] outline-none font-medium">
                        </div>
                        <div id="field-tanggal" class="hidden w-full">
                            <label class="block text-[10px] md:text-[11px] text-[var(--text-muted)] font-bold mb-1.5 uppercase tracking-wide">Tanggal Sertifikasi</label>
                            <input type="text" id="adm-tanggal" placeholder="e.g. 20 Agustus 2026" class="w-full bg-[var(--bg-main)] border border-[var(--border-heavy)] rounded-xl px-3 md:px-4 py-2.5 md:py-3 text-sm text-[var(--text-main)] focus:border-[var(--color-primary)] outline-none font-medium">
                        </div>
                    </div>
                    
                    <div class="flex flex-col md:flex-row gap-3 md:gap-4 mt-6 md:mt-8 pt-4 md:pt-5 border-t border-[var(--border-heavy)] shrink-0 w-full">
                        <button onclick="simpanFormItem()" class="flex-1 bg-[var(--color-primary)] hover:brightness-125 text-[var(--bg-main)] font-black py-3 md:py-3.5 rounded-xl transition-all text-xs md:text-sm uppercase tracking-wider shadow-[0_5px_20px_rgba(var(--color-primary-rgb),0.4)] hover:-translate-y-1 active:scale-95 w-full">
                            <i class="ph-bold ph-floppy-disk mr-1"></i> Simpan & Update
                        </button>
                        <button onclick="tutupFormItem()" class="flex-1 bg-transparent border-2 border-[var(--text-muted)] text-[var(--text-muted)] hover:text-[var(--text-main)] hover:border-[var(--text-main)] font-bold py-3 md:py-3.5 rounded-xl transition-colors text-xs md:text-sm uppercase tracking-wider active:scale-95 w-full">Batal</button>
                    </div>
                </div>
            </div>
            
            <div id="master-save-container" class="mt-4 md:mt-6 flex flex-col sm:flex-row items-center justify-between gap-3 md:gap-4 shrink-0 border-t border-[var(--border-color)] pt-4 md:pt-5 w-full">
                <span id="adminNotif" class="text-[10px] md:text-sm font-mono font-bold hidden px-4 md:px-5 py-2 md:py-2.5 rounded-xl text-center w-full sm:w-auto break-words shadow-inner min-w-0 flex-grow" aria-live="polite"></span>
                <button onclick="simpanDatabaseMain()" id="btnSimpanCV" class="w-full sm:w-auto bg-[var(--color-primary)] hover:brightness-125 text-[var(--bg-main)] font-black px-6 md:px-8 py-3 md:py-3.5 rounded-xl shadow-[0_0_25px_rgba(var(--color-primary-rgb),0.5)] transition-all flex items-center justify-center gap-2 md:gap-3 text-[11px] md:text-base uppercase tracking-widest outline-none hover:-translate-y-1 active:scale-95 shrink-0">
                    <i class="ph-bold ph-cloud-arrow-up text-lg md:text-xl" aria-hidden="true"></i> Push Override
                </button>
            </div>
        </div>
    </div>

    <script>
        function toggleMode() {
            const isLight = document.documentElement.getAttribute('data-theme') === 'light';
            const modeIconEl = document.getElementById('mode-icon');
            
            if(isLight) {
                document.documentElement.removeAttribute('data-theme');
                localStorage.setItem('axa-bg-theme', 'dark');
                if (modeIconEl) modeIconEl.className = 'ph-fill ph-sun';
            } else {
                document.documentElement.setAttribute('data-theme', 'light');
                localStorage.setItem('axa-bg-theme', 'light');
                if (modeIconEl) modeIconEl.className = 'ph-fill ph-moon';
            }
            updateActiveBgSwatch(localStorage.getItem('axa-bg-theme'));
        }

        function setBgTheme(bgClass, el) {
            if(bgClass === 'dark') {
                document.documentElement.removeAttribute('data-theme');
            } else {
                document.documentElement.setAttribute('data-theme', bgClass);
            }
            localStorage.setItem('axa-bg-theme', bgClass);
            updateActiveBgSwatch(bgClass);
        }

        function setColorTheme(themeClass, el) {
            const currentBg = localStorage.getItem('axa-bg-theme') || 'dark';
            document.documentElement.className = `scroll-smooth ${themeClass}`;
            localStorage.setItem('axa-theme-color', themeClass);
            
            document.querySelectorAll('.color-swatch').forEach(sw => sw.classList.remove('active', 'ring-2', 'ring-[var(--text-main)]', 'scale-110'));
            if(el) el.classList.add('active', 'ring-2', 'ring-[var(--text-main)]', 'scale-110');
        }
        
        function updateActiveBgSwatch(bgClass) {
            document.querySelectorAll('.bg-swatch').forEach(sw => sw.classList.remove('ring-2', 'ring-[var(--color-primary)]', 'scale-110'));
            const map = {'dark':0, 'light':1, 'obsidian':2, 'cosmic':3, 'abyssal':4, 'matrix':5, 'sepia':6};
            const btnIndex = map[bgClass] || 0;
            const buttons = document.querySelectorAll('.bg-swatch');
            if(buttons[btnIndex]) buttons[btnIndex].classList.add('ring-2', 'ring-[var(--color-primary)]', 'scale-110');
        }

        const initialModeIcon = document.getElementById('mode-icon');
        if (initialModeIcon) {
            if(localStorage.getItem('axa-bg-theme') === 'light') initialModeIcon.className = 'ph-fill ph-moon';
            else initialModeIcon.className = 'ph-fill ph-sun';
        }
        
        const savedColor = localStorage.getItem('axa-theme-color') || 'theme-cyan';
        document.querySelectorAll('.color-swatch').forEach(sw => {
            if(sw.getAttribute('onclick').includes(savedColor)) sw.classList.add('active', 'ring-2', 'ring-[var(--text-main)]', 'scale-110');
        });
        updateActiveBgSwatch(localStorage.getItem('axa-bg-theme') || 'dark');

        window.addEventListener('scroll', () => {
            const btn = document.getElementById('scrollToTopBtn');
            const winScroll = document.body.scrollTop || document.documentElement.scrollTop;
            const height = document.documentElement.scrollHeight - document.documentElement.clientHeight;
            const scrolled = (winScroll / height) * 100;
            document.getElementById('scroll-progress').style.width = scrolled + '%';

            if(window.scrollY > 300) {
                btn.classList.add('show');
            } else {
                btn.classList.remove('show');
            }
        });

        const GAS_URL = "https://script.google.com/macros/s/AKfycbxv7LpGFB37qXUvpPYapXUIaaMv0nV06AnGbwQ_CRBSj4zIoxo7N3NwAn9WSsphDrtR/exec";
        let globalCVData = {}; 
        let globalSheetData = {}; 
        
        document.addEventListener("DOMContentLoaded", () => {
            const urlWithCacheBuster = GAS_URL + "?endpoint=cv&t=" + new Date().getTime();

            fetch(urlWithCacheBuster, { redirect: "follow" })
            .then(res => { if (!res.ok) throw new Error("Network Issue."); return res.text(); })
            .then(text => {
                if(text.trim().startsWith('<')) {
                    throw new Error("Akses GAS Ditolak. Pastikan Deployment 'Who has access' diset ke 'Anyone'!");
                }
                try {
                    const res = JSON.parse(text); 
                    if(res.status === 'success') {
                        globalCVData = res.data;
                        globalSheetData = res.sheets || { proyek: [], sertifHobi: [], sertifPDGI: [] }; 
                        
                        renderSeluruhUI(globalCVData, globalSheetData);
                        
                        setTimeout(() => {
                            document.getElementById('loader-screen').style.opacity = '0';
                            document.getElementById('loader-screen').style.visibility = 'hidden';
                            document.getElementById('main-content').classList.remove('opacity-0');
                            initObserver();
                        }, 500); 
                        
                        catatViewPengunjungDenganIP();
                    } else { throw new Error(res.message || "Unknown Backend Error"); }
                } catch (e) {
                    console.error("Axa Xyz Error:", e.message);
                    tampilkanLayarError(`Koneksi API Gagal / Format Tidak Valid.<br><span class='text-[var(--text-main)] font-normal text-xs md:text-sm block mt-2'><b>Error:</b> ${e.message}</span>`);
                }
            })
            .catch(err => {
                tampilkanLayarError(`Sistem Gagal Menghubungi Server Google.<br><span class='text-[var(--text-main)] font-normal text-xs md:text-sm block mt-2'><b>Error:</b> ${err.message}</span>`);
            });

            document.addEventListener('keydown', function(event) {
                if (event.key === "Escape" && !document.getElementById('admin-modal').classList.contains('hidden')) {
                    tutupAdmin();
                }
            });
        });

        function catatViewPengunjungDenganIP() {
            const fetchIP = fetch('https://api.ipify.org?format=json').then(res => res.json()).then(data => data.ip).catch(() => 'HIDDEN_IP_' + Math.random().toString(36).substr(2, 5));
            fetchIP.then(clientIP => {
                return fetch(GAS_URL, { method: 'POST', headers: { "Content-Type": "text/plain;charset=utf-8" }, body: JSON.stringify({ action: 'recordView', ip: clientIP }) });
            }).then(res => res.json()).then(res => {
                if(res.status === 'success') {
                    animasiCounter('view-today', res.data.today);
                    animasiCounter('view-week', res.data.week);
                    animasiCounter('view-total', res.data.total);
                }
            }).catch(e => console.log("Gagal hitung view / ambil IP:", e));
        }

        function animasiCounter(id, targetValue) {
            const el = document.getElementById(id);
            let start = 0; const duration = 1500; const increment = targetValue / (duration / 16); 
            if (targetValue === 0) { el.textContent = "0"; return; }
            const timer = setInterval(() => {
                start += increment;
                if (start >= targetValue) { clearInterval(timer); el.textContent = targetValue; } 
                else { el.textContent = Math.floor(start); }
            }, 16);
        }

        function tampilkanLayarError(pesanError) {
            document.querySelector('.pulse-ring').style.display = 'none';
            const title = document.getElementById('loader-title');
            title.textContent = "SYSTEM ERROR"; title.classList.replace('text-[var(--color-primary)]', 'text-red-500');
            const text = document.getElementById('loader-text');
            text.innerHTML = pesanError; text.classList.add('text-red-400', 'mt-4', 'break-words');
        }

        function renderSeluruhUI(data, sheetData = {}) {
            document.getElementById('ui-namaDepan').textContent = data.profil.namaDepan;
            document.getElementById('ui-namaBelakang').textContent = data.profil.namaBelakang;
            document.getElementById('ui-gelar').textContent = data.profil.gelar;
            document.getElementById('ui-subGelar').textContent = data.profil.subGelar;
            
            document.getElementById('ui-foto').src = data.profil.foto === "axalogo.jpg" ? "/axalogo.png" : "/" + data.profil.foto;

            document.getElementById('ui-lahir').textContent = data.dataPribadi.lahir;
            document.getElementById('ui-gender').textContent = data.dataPribadi.gender;
            document.getElementById('ui-agama').textContent = data.dataPribadi.agama;
            document.getElementById('ui-warga').textContent = data.dataPribadi.kewarganegaraan;
            document.getElementById('ui-status').textContent = data.dataPribadi.status;
            
            const rawEmail = data.kontak.email;
            const rawHp = data.kontak.hp;
            const rawSosmed = data.kontak.sosmed; 
            let cleanHp = rawHp.replace(/\D/g, ''); if (cleanHp.startsWith('0')) cleanHp = '62' + cleanHp.substring(1);
            let cleanIg = rawSosmed.replace(/[@ ]/g, '').split('/')[0]; 

            document.getElementById('ui-email-container').innerHTML = `<a href="mailto:${rawEmail}" class="link-hover truncate block max-w-full" aria-label="Kirim email ke ${rawEmail}">${rawEmail}</a>`;
            document.getElementById('ui-hp-container').innerHTML = `<a href="https://wa.me/${cleanHp}" target="_blank" rel="noopener noreferrer" class="link-hover truncate block max-w-full" aria-label="Chat WhatsApp ke ${rawHp}">${rawHp}</a>`;
            document.getElementById('ui-sosmed-container').innerHTML = `<a href="https://www.instagram.com/${cleanIg}" target="_blank" rel="noopener noreferrer" class="link-hover truncate block max-w-full" aria-label="Kunjungi Instagram ${rawSosmed}">${rawSosmed}</a>`;
            document.getElementById('ui-alamat').textContent = data.kontak.alamat;
            document.getElementById('ui-scholar').href = data.kontak.scholar;
            document.getElementById('ui-orcid').href = data.kontak.orcid;
            
            if (document.getElementById('ui-sciprofiles') && data.kontak.sciprofiles) {
                document.getElementById('ui-sciprofiles').href = data.kontak.sciprofiles;
            }
            
            if (document.getElementById('ui-semanticscholar')) {
                document.getElementById('ui-semanticscholar').href = data.kontak.semanticscholar || "https://www.semanticscholar.org/author/M.-Aksa-Arsyad/2328471622";
            }

            const convertDriveLink = (url) => {
                if(!url) return 'https://ui-avatars.com/api/?name=No+Image&background=1e293b&color=fff';
                let fileId = '';
                const match = url.match(/\/d\/(.+?)\//);
                if(match && match[1]) fileId = match[1];
                const matchUc = url.match(/id=([^&]+)/);
                if(matchUc && matchUc[1]) fileId = matchUc[1];
                if (fileId) {
                    return `https://lh3.googleusercontent.com/d/${fileId}`;
                }
                return url; 
            };

            if(sheetData.proyek && document.getElementById('ui-proyek-container')) {
                const proyekHTML = sheetData.proyek.map((p, i) => `
                    <article class="premium-card overflow-hidden group hover:-translate-y-2 transition-all duration-300 animate-on-scroll flex flex-col bg-[var(--bg-card-heavy)] w-full max-w-full" style="transition-delay: ${i*100}ms">
                        <div class="h-48 md:h-56 w-full overflow-hidden bg-[var(--bg-overlay)] border-b border-[var(--border-color)] relative">
                            <img src="${convertDriveLink(p.Gambar)}" alt="${p.Judul}" loading="lazy" class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-700">
                        </div>
                        <div class="p-5 md:p-6 flex flex-col flex-grow relative z-10 w-full min-w-0">
