            if(index !== -1) {
                let dataArray = [];
                if(currentAdminTab === 'proyek') dataArray = globalSheetData.proyek;
                if(currentAdminTab === 'hobi') dataArray = globalSheetData.sertifHobi;
                if(currentAdminTab === 'pdgi') dataArray = globalSheetData.sertifPDGI;
                
                const item = dataArray[index];
                document.getElementById('adm-judul').value = item.Judul || '';
                document.getElementById('adm-gambar').value = item.Gambar || '';
                
                if(isProyek) {
                    document.getElementById('adm-deskripsi').value = item.Deskripsi || '';
                    document.getElementById('adm-link').value = item.Link || '';
                } else {
                    document.getElementById('adm-subjudul').value = item.Subjudul || '';
                    document.getElementById('adm-tanggal').value = item.Tanggal || '';
                }
            }
        }

        function handleImageUpload(input) {
            if(!input.files || input.files.length === 0) return;
            const file = input.files[0];
            const reader = new FileReader();
            
            const statusEl = document.getElementById('upload-status');
            const urlInput = document.getElementById('adm-gambar');
            
            statusEl.classList.remove('hidden');
            statusEl.classList.replace('text-green-400', 'text-[var(--color-primary)]');
            statusEl.classList.replace('text-red-400', 'text-[var(--color-primary)]');
            statusEl.innerHTML = '<i class="ph-bold ph-spinner-gap animate-spin inline-block"></i> Uploading to Secure Cloud...';
            urlInput.disabled = true;
            
            reader.onload = function(e) {
                const dataUrl = e.target.result;
                const base64 = dataUrl.split(',')[1];
                const mimeType = dataUrl.split(';')[0].split(':')[1];
                
                const payload = {
                    action: 'uploadImage',
                    user: 'axaaxyz_01',
                    pass: 'axaxyz999',
                    filename: file.name,
                    mimeType: mimeType,
                    base64: base64
                };
                
                fetch(GAS_URL, {
                    method: 'POST',
                    headers: { "Content-Type": "text/plain;charset=utf-8" },
                    body: JSON.stringify(payload)
                }).then(res => res.json())
                .then(res => {
                    if(res.status === 'success') {
                        urlInput.value = res.url; 
                        statusEl.innerHTML = '<i class="ph-bold ph-check-circle inline-block"></i> Upload Confirmed!';
                        statusEl.classList.replace('text-[var(--color-primary)]', 'text-green-400');
                    } else {
                        statusEl.innerHTML = '<i class="ph-bold ph-warning-circle inline-block"></i> Abort: ' + res.message;
                        statusEl.classList.replace('text-[var(--color-primary)]', 'text-red-400');
                    }
                }).catch(err => {
                    statusEl.innerHTML = '<i class="ph-bold ph-warning-circle inline-block"></i> Network Override Failed.';
                    statusEl.classList.replace('text-[var(--color-primary)]', 'text-red-400');
                }).finally(() => {
                    urlInput.disabled = false;
                });
            };
            reader.readAsDataURL(file);
        }

        function tutupFormItem() {
            document.getElementById('admin-item-form').classList.add('hidden');
        }

        function showUIModalMessage(message, isError = false) {
            let existingModal = document.getElementById('custom-alert-modal');
            if(existingModal) existingModal.remove();

            const modalHtml = `
                <div id="custom-alert-modal" class="fixed inset-0 z-[100000] flex items-center justify-center p-4 bg-black/60 backdrop-blur-sm animate__animated animate__fadeIn max-w-[100vw] overflow-hidden">
                    <div class="bg-[var(--bg-card-heavy)] border-2 ${isError ? 'border-red-500' : 'border-[var(--color-primary)]'} p-6 rounded-2xl shadow-[0_0_30px_rgba(0,0,0,0.8)] max-w-sm w-full text-center animate__animated animate__zoomIn animate__faster">
                        <i class="ph-fill ${isError ? 'ph-warning-circle text-red-500' : 'ph-info text-[var(--color-primary)]'} text-5xl mb-4"></i>
                        <p class="text-[var(--text-main)] text-sm md:text-base font-bold mb-6 break-words w-full">${message}</p>
                        <button onclick="document.getElementById('custom-alert-modal').remove()" class="bg-[var(--color-primary)] text-black px-6 py-2.5 rounded-xl font-bold uppercase tracking-widest hover:brightness-110 shadow-lg active:scale-95">OK</button>
                    </div>
                </div>
            `;
            document.body.insertAdjacentHTML('beforeend', modalHtml);
        }

        function simpanFormItem() {
            let dataArray = [];
            if(currentAdminTab === 'proyek') dataArray = globalSheetData.proyek || [];
            if(currentAdminTab === 'hobi') dataArray = globalSheetData.sertifHobi || [];
            if(currentAdminTab === 'pdgi') dataArray = globalSheetData.sertifPDGI || [];

            const newItem = {
                Judul: document.getElementById('adm-judul').value.trim(),
                Gambar: document.getElementById('adm-gambar').value.trim()
            };

            if(currentAdminTab === 'proyek') {
                newItem.Deskripsi = document.getElementById('adm-deskripsi').value.trim();
                newItem.Link = document.getElementById('adm-link').value.trim();
            } else {
                newItem.Subjudul = document.getElementById('adm-subjudul').value.trim();
                newItem.Tanggal = document.getElementById('adm-tanggal').value.trim();
            }

            if(!newItem.Judul || !newItem.Gambar) {
                showUIModalMessage("Judul dan URL Gambar wajib diisi!", true);
                return;
            }

            if(currentEditIndex === -1) {
                dataArray.push(newItem);
            } else {
                dataArray[currentEditIndex] = newItem;
            }

            if(currentAdminTab === 'proyek') globalSheetData.proyek = dataArray;
            if(currentAdminTab === 'hobi') globalSheetData.sertifHobi = dataArray;
            if(currentAdminTab === 'pdgi') globalSheetData.sertifPDGI = dataArray;

            tutupFormItem();
            renderAdminGUIList();
            
            simpanDatabaseMain();
        }

        function hapusItem(index) {
            let existingConfirm = document.getElementById('custom-confirm-modal');
            if(existingConfirm) existingConfirm.remove();

            const confirmHtml = `
                <div id="custom-confirm-modal" class="fixed inset-0 z-[100000] flex items-center justify-center p-4 bg-black/60 backdrop-blur-sm animate__animated animate__fadeIn max-w-[100vw] overflow-hidden">
                    <div class="bg-[var(--bg-card-heavy)] border-2 border-red-500 p-5 md:p-6 rounded-2xl shadow-[0_0_40px_rgba(239,68,68,0.4)] max-w-sm w-full text-center animate__animated animate__shakeX animate__faster">
                        <i class="ph-fill ph-warning text-red-500 text-4xl md:text-5xl mb-4"></i>
                        <p class="text-[var(--text-main)] text-sm md:text-base font-bold mb-6 break-words w-full">Penghapusan Data Permanen! Anda yakin?</p>
                        <div class="flex gap-3 md:gap-4 justify-center w-full">
                            <button id="btn-confirm-yes" class="bg-red-500 text-white px-4 md:px-6 py-2.5 rounded-xl font-bold uppercase tracking-wider hover:brightness-110 shadow-lg flex-1 active:scale-95 text-xs md:text-sm">HAPUS</button>
                            <button onclick="document.getElementById('custom-confirm-modal').remove()" class="bg-transparent border border-gray-500 text-gray-300 px-4 md:px-6 py-2.5 rounded-xl font-bold uppercase tracking-wider hover:bg-gray-800 flex-1 active:scale-95 text-xs md:text-sm">BATAL</button>
                        </div>
                    </div>
                </div>
            `;
            document.body.insertAdjacentHTML('beforeend', confirmHtml);

            document.getElementById('btn-confirm-yes').addEventListener('click', () => {
                document.getElementById('custom-confirm-modal').remove();
                let dataArray = [];
                if(currentAdminTab === 'proyek') dataArray = globalSheetData.proyek;
                if(currentAdminTab === 'hobi') dataArray = globalSheetData.sertifHobi;
                if(currentAdminTab === 'pdgi') dataArray = globalSheetData.sertifPDGI;

                dataArray.splice(index, 1);
                renderAdminGUIList();
                simpanDatabaseMain();
            });
        }
        
        function simpanDatabaseMain() {
            let payload = { user: 'axaaxyz_01', pass: 'axaxyz999' };
            
            if (currentAdminTab === 'cv') {
                const btn = document.getElementById('btnSimpanCV'); 
                const notif = document.getElementById('adminNotif');
                try { 
                    payload.newData = JSON.parse(document.getElementById('jsonEditor').value); 
                } catch(e) { 
                    showUIModalMessage("Format JSON Error! Cek Koma, Kurung Kurawal, atau Tanda Kutip.", true); 
                    return; 
                }
                payload.action = 'updateCV';
                
                btn.disabled = true; btn.innerHTML = '<i class="ph-bold ph-spinner-gap animate-spin mr-2" aria-hidden="true"></i> SYNCING...'; notif.classList.add('hidden');

                fetch(GAS_URL, { method: 'POST', headers: { "Content-Type": "text/plain;charset=utf-8" }, body: JSON.stringify(payload) })
                .then(res => res.json())
                .then(res => {
                    if(res.status === 'success') {
                        notif.innerHTML = "<i class='ph-bold ph-check-circle mr-1' aria-hidden='true'></i> CORE SYNC SUCCESS!";
                        notif.classList.remove('hidden', 'bg-red-500/20', 'text-red-500'); 
                        notif.classList.add('bg-green-500/20', 'text-green-500');
                        globalCVData = payload.newData; 
                        renderSeluruhUI(globalCVData, globalSheetData); 
                    } else {
                        notif.textContent = "ERR: " + res.message;
                        notif.classList.remove('hidden', 'bg-green-500/20', 'text-green-500'); 
                        notif.classList.add('bg-red-500/20', 'text-red-500');
                    }
                })
                .catch(err => {
                    notif.textContent = "TIMEOUT.";
                    notif.classList.remove('hidden', 'bg-green-500/20', 'text-green-500'); 
                    notif.classList.add('bg-red-500/20', 'text-red-500');
                }).finally(() => { 
                    btn.disabled = false; 
                    btn.innerHTML = '<i class="ph-bold ph-cloud-arrow-up text-lg md:text-xl" aria-hidden="true"></i> PUSH OVERRIDE'; 
                });
                
            } else {
                let toast = document.createElement('div');
                toast.className = "fixed bottom-6 right-6 left-6 md:left-auto bg-yellow-500 text-black px-5 py-3 rounded-xl font-bold shadow-[0_5px_20px_rgba(234,179,8,0.5)] z-[100000] flex items-center justify-center md:justify-start gap-3 animate__animated animate__fadeInUp break-words";
                toast.innerHTML = '<i class="ph-bold ph-spinner-gap animate-spin text-xl shrink-0"></i> <span>Syncing to Master Sheet...</span>';
                document.body.appendChild(toast);

                payload.action = 'updateSheet';
                if(currentAdminTab === 'proyek') { payload.sheetName = 'Proyek_Web'; payload.data = globalSheetData.proyek; }
                if(currentAdminTab === 'hobi') { payload.sheetName = 'Sertifikasi_Hobi'; payload.data = globalSheetData.sertifHobi; }
                if(currentAdminTab === 'pdgi') { payload.sheetName = 'Sertifikasi_PDGI'; payload.data = globalSheetData.sertifPDGI; }
                
                fetch(GAS_URL, { method: 'POST', headers: { "Content-Type": "text/plain;charset=utf-8" }, body: JSON.stringify(payload) })
                .then(res => res.json())
                .then(res => {
                    if(res.status === 'success') {
                        toast.className = "fixed bottom-6 right-6 left-6 md:left-auto bg-green-500 text-white px-5 py-3 rounded-xl font-bold shadow-[0_5px_20px_rgba(34,197,94,0.5)] z-[100000] flex items-center justify-center md:justify-start gap-3 animate__animated animate__fadeInUp break-words";
                        toast.innerHTML = "<i class='ph-bold ph-check-circle text-xl shrink-0'></i> <span>Override Confirmed!</span>";
                        renderSeluruhUI(globalCVData, globalSheetData);
                    } else {
                        toast.className = "fixed bottom-6 right-6 left-6 md:left-auto bg-red-500 text-white px-5 py-3 rounded-xl font-bold shadow-[0_5px_20px_rgba(239,68,68,0.5)] z-[100000] flex items-center justify-center md:justify-start gap-3 animate__animated animate__shakeX break-words";
                        toast.innerHTML = "<i class='ph-bold ph-warning-circle text-xl shrink-0'></i> <span>Override Failed: " + res.message + "</span>";
                    }
                    setTimeout(() => {
                        toast.classList.replace('animate__fadeInUp', 'animate__fadeOutDown');
                        setTimeout(() => toast.remove(), 500);
                    }, 3000);
                })
                .catch(err => {
                    toast.className = "fixed bottom-6 right-6 left-6 md:left-auto bg-red-500 text-white px-5 py-3 rounded-xl font-bold shadow-[0_5px_20px_rgba(239,68,68,0.5)] z-[100000] flex items-center justify-center md:justify-start gap-3 animate__animated animate__shakeX break-words";
                    toast.innerHTML = "<i class='ph-bold ph-warning-circle text-xl shrink-0'></i> <span>Network Severed!</span>";
                    setTimeout(() => {
                        toast.classList.replace('animate__shakeX', 'animate__fadeOutDown');
                        setTimeout(() => toast.remove(), 500);
                    }, 3000);
                });
            }
        }
    </script>
    
