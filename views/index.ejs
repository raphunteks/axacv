        .shimmer-text {
            background: linear-gradient(90deg, var(--color-primary) 0%, var(--text-main) 50%, var(--color-primary) 100%);
            background-size: 200% auto; -webkit-background-clip: text; -webkit-text-fill-color: transparent;
            animation: shimmer-slide 2s linear infinite; text-shadow: 0 0 20px rgba(var(--color-primary-rgb), 0.5);
        }
        @keyframes shimmer-slide { to { background-position: 200% center; } }

        /* UPGRADED PREMIUM CARD WITH HOLOGRAPHIC EFFECT & MAX-WIDTH PROTECTIONS */
        .premium-card {
            background: linear-gradient(145deg, var(--bg-card) 0%, rgba(0,0,0,0.2) 100%);
            border: 1px solid var(--border-color);
            border-radius: 1.25rem;
            backdrop-filter: blur(20px) saturate(180%);
            -webkit-backdrop-filter: blur(20px) saturate(180%);
            box-shadow: 0 15px 35px var(--shadow-glass), inset 0 1px 0 rgba(255,255,255,0.1); 
            transition: all 0.6s cubic-bezier(0.25, 0.8, 0.25, 1);
            position: relative; 
            overflow: hidden; /* Mencegah elemen anak offside */
            width: 100%;
            max-width: 100%;
            transform: perspective(1000px) translateZ(0);
        }
        .premium-card::before {
            content: ''; position: absolute; top: 0; left: -150%; width: 50%; height: 100%;
            background: linear-gradient(to right, rgba(255,255,255,0) 0%, rgba(255,255,255,0.08) 50%, rgba(255,255,255,0) 100%);
            transform: skewX(-25deg); transition: 0.8s cubic-bezier(0.4, 0, 0.2, 1); pointer-events: none; z-index: 10;
        }
        .premium-card:hover { 
            transform: perspective(1000px) translateY(-6px) rotateX(2deg) rotateY(-1deg) scale(1.01); 
            border-color: rgba(var(--color-primary-rgb), 0.5); 
            box-shadow: 0 25px 50px -12px rgba(var(--color-primary-rgb), 0.3), inset 0 0 20px rgba(var(--color-primary-rgb),0.1); 
            z-index: 5;
        }
        .premium-card:hover::before { left: 200%; }

        .scanner-container { position: relative; overflow: hidden; border-radius: 50%; background-color: var(--bg-card-heavy); box-shadow: inset 0 0 30px rgba(0,0,0,0.8);} 
        .scanner-line { 
            position: absolute; width: 100%; height: 4px; background: var(--color-primary); 
            box-shadow: 0 0 25px 8px var(--color-primary), 0 -20px 40px -10px var(--color-primary);
            z-index: 20; animation: scan-anim 2.5s infinite cubic-bezier(0.4, 0, 0.2, 1); opacity: 0.85;
            mix-blend-mode: overlay;
        }
        @keyframes scan-anim { 0% { top: -10%; opacity: 0; } 10% { opacity: 1; } 90% { opacity: 1; } 100% { top: 110%; opacity: 0; } }
        
        .avatar-ring {
            background: conic-gradient(from 0deg, var(--color-secondary) 0%, var(--color-primary) 50%, var(--color-secondary) 100%);
            animation: spin-ring 6s linear infinite, morph-blob-extreme 8s ease-in-out infinite alternate; 
            padding: 4px; filter: drop-shadow(0 0 20px rgba(var(--color-primary-rgb), 0.6));
        }

        .text-gradient { 
            background: linear-gradient(135deg, var(--text-main) 0%, var(--color-secondary) 50%, var(--color-primary) 100%); 
            -webkit-background-clip: text; -webkit-text-fill-color: transparent; 
            background-size: 200% auto; animation: shine 4s linear infinite;
        }
        
        .cyber-glitch:hover { animation: glitch-skew 0.3s cubic-bezier(0.25, 0.46, 0.45, 0.94) both infinite; text-shadow: 3px 3px var(--color-primary), -3px -3px var(--color-secondary); }
        
        .text-stroke-gradient {
            background: linear-gradient(to right, var(--color-primary), var(--color-secondary));
            -webkit-background-clip: text; -webkit-text-fill-color: transparent;
            drop-shadow: 0 0 12px rgba(var(--color-primary-rgb),0.6);
        }

        ::selection { background: rgba(var(--color-primary-rgb), 0.4); color: var(--color-inverse); text-shadow: 0 0 10px rgba(var(--color-primary-rgb), 0.8); }

        .circuit-line { position: relative; width: 100%; max-width: 100%; }
        .circuit-line::before { 
            content: ''; position: absolute; left: 21px; top: 0; bottom: 0; width: 3px; 
            background: linear-gradient(to bottom, var(--color-primary), var(--color-secondary), transparent); 
            background-size: 100% 200%; animation: cyber-flow 2.5s linear infinite; opacity: 0.8; 
            box-shadow: 0 0 10px var(--color-primary);
        }
        @media (min-width: 768px) { .circuit-line::before { left: 50%; transform: translateX(-50%); } }

        .barber-pole {
            background-image: repeating-linear-gradient(45deg, transparent, transparent 10px, rgba(255,255,255,0.2) 10px, rgba(255,255,255,0.2) 20px);
            background-size: 200% 100%; animation: move-stripes 1.5s linear infinite;
        }
        
        /* UPGRADED 3D SCROLL ANIMATION - Mencegah stretch lebar saat berotasi */
        .animate-on-scroll { 
            opacity: 0; 
            transform: translateY(40px) scale(0.95); 
            transition: all 0.8s cubic-bezier(0.22, 1, 0.36, 1); 
            will-change: transform, opacity; 
        }
        .animate-on-scroll.is-visible { 
            opacity: 1; 
            transform: translateY(0) scale(1); 
        }

        ::-webkit-scrollbar { width: 8px; }
        ::-webkit-scrollbar-track { background: var(--bg-main); border-left: 1px solid var(--border-color); }
        ::-webkit-scrollbar-thumb { background: linear-gradient(to bottom, var(--color-secondary), var(--color-primary)); border-radius: 10px; border: 2px solid var(--bg-main); transition: background 0.3s; box-shadow: inset 0 0 5px rgba(0,0,0,0.5);}
        ::-webkit-scrollbar-thumb:hover { background: linear-gradient(to bottom, var(--color-primary), #fff); }
        .no-scrollbar::-webkit-scrollbar { display: none; }
        .no-scrollbar { -ms-overflow-style: none; scrollbar-width: none; }

        .link-hover { position: relative; color: var(--text-main); transition: color 0.3s, text-shadow 0.3s; word-break: break-all; outline: none; }
        .link-hover::after { content: ''; position: absolute; width: 0; height: 2px; bottom: -4px; left: 50%; background-color: var(--color-primary); transition: width 0.4s cubic-bezier(0.25, 1, 0.5, 1), left 0.4s cubic-bezier(0.25, 1, 0.5, 1); box-shadow: 0 0 8px var(--color-primary);}
        .link-hover:hover, .link-hover:focus-visible { color: var(--color-primary); text-shadow: 0 0 12px rgba(var(--color-primary-rgb), 0.6); }
        .link-hover:hover::after, .link-hover:focus-visible::after { width: 100%; left: 0; }
        
        .icon-bounce-group:hover .icon-bounce { animation: bounce-micro 0.5s ease, icon-glitch 0.2s 0.2s; filter: drop-shadow(0 0 8px var(--color-primary));}

        .btn-pulse { position: relative; overflow: hidden; z-index: 1; transition: all 0.4s cubic-bezier(0.25, 0.8, 0.25, 1); }
        .btn-pulse::before {
            content: ''; position: absolute; top: 50%; left: 50%; width: 300%; height: 300%;
            background: linear-gradient(45deg, transparent, rgba(255,255,255,0.3), transparent);
            transform: translate(-50%, -50%) rotate(45deg) translateY(100%); transition: transform 0.6s cubic-bezier(0.25, 1, 0.5, 1); z-index: -1;
        }
        .btn-pulse:hover, .btn-pulse:active { transform: translateY(-3px) scale(1.02); box-shadow: 0 15px 30px rgba(var(--color-primary-rgb), 0.5); }
        .btn-pulse:active { transform: translateY(1px) scale(0.98); }
        .btn-pulse:hover::before { transform: translate(-50%, -50%) rotate(45deg) translateY(-100%); }
        .btn-pulse::after {
            content: ''; position: absolute; inset: -3px; border-radius: inherit; z-index: -2;
            background: linear-gradient(45deg, var(--color-primary), var(--color-secondary));
            opacity: 0; transition: opacity 0.4s; filter: blur(15px); animation: pulse-glow 1.5s infinite alternate;
        }
        .btn-pulse:hover::after { opacity: 1; }
        @keyframes pulse-glow { from { transform: scale(0.95); opacity: 0.6;} to { transform: scale(1.05); opacity: 1;} }
        
        .input-ripple { transition: all 0.4s cubic-bezier(0.25, 0.8, 0.25, 1); }
        .input-ripple:focus { box-shadow: 0 0 0 4px rgba(var(--color-primary-rgb), 0.2), inset 0 2px 10px rgba(0,0,0,0.2); border-color: var(--color-primary); border-radius: 12px; transform: scale(1.01); }

        .social-lift { transition: transform 0.4s cubic-bezier(0.34, 1.56, 0.64, 1), box-shadow 0.4s; }
        .social-lift:hover { transform: scale(1.15) rotate(-4deg) translateY(-5px); box-shadow: 0 15px 35px rgba(var(--color-primary-rgb),0.4); z-index: 10; border-color: transparent !important; background: rgba(var(--color-primary-rgb), 0.1); }

        .badge-lift { transition: all 0.4s cubic-bezier(0.34, 1.56, 0.64, 1); }
        .premium-card:hover .badge-lift { transform: translateY(-6px) scale(1.05); box-shadow: 0 12px 20px rgba(var(--color-primary-rgb), 0.3); }

        .stat-breathe { animation: subtle-breathe 3s ease-in-out infinite alternate; position: relative; overflow: hidden; }
        .stat-breathe::before { content: ''; position: absolute; bottom: 0; left: 0; height: 3px; width: 100%; background: linear-gradient(90deg, transparent, var(--color-primary), transparent); opacity: 0.5; animation: equalizer 2s infinite ease-in-out; }
        @keyframes subtle-breathe { from { box-shadow: 0 5px 20px var(--shadow-glass); } to { box-shadow: 0 5px 35px rgba(var(--color-primary-rgb), 0.25); } }
        @keyframes equalizer { 0%, 100% { transform: scaleX(0.5); opacity: 0.4; } 50% { transform: scaleX(1.2); opacity: 0.9; } }

        #theme-panel {
            position: fixed; bottom: 25px; right: 25px; z-index: 9999;
            display: flex; flex-direction: column; align-items: flex-end; gap: 12px;
        }
        .theme-btn {
            width: 50px; height: 50px; border-radius: 50%; background: var(--bg-card-heavy);
            border: 1px solid var(--border-color); color: var(--text-main);
            display: flex; justify-content: center; align-items: center; font-size: 1.4rem;
            cursor: pointer; box-shadow: 0 8px 25px var(--shadow-glass); backdrop-filter: blur(15px);
            transition: all 0.4s cubic-bezier(0.34, 1.56, 0.64, 1);
        }
        .theme-btn:hover { border-color: var(--color-primary); transform: scale(1.2) rotate(20deg); color: var(--color-primary); box-shadow: 0 10px 30px rgba(var(--color-primary-rgb), 0.5);}
        .theme-btn:active { transform: scale(0.95); }
        
        .theme-options {
            background: var(--bg-card-heavy); border: 1px solid var(--border-color);
            padding: 18px; border-radius: 20px; backdrop-filter: blur(30px) saturate(200%);
            display: none; opacity: 0; transform: perspective(800px) rotateX(10deg) translateY(20px) scale(0.9); transition: all 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275);
            box-shadow: 0 20px 50px rgba(0,0,0,0.6); width: 300px; transform-origin: bottom right; max-width: calc(100vw - 40px);
        }
        .theme-options.open { display: block; opacity: 1; transform: perspective(800px) rotateX(0deg) translateY(0) scale(1); }
        
        .color-swatch, .bg-swatch {
            width: 32px; height: 32px; border-radius: 50%; cursor: pointer; border: 2px solid transparent; 
            transition: all 0.4s cubic-bezier(0.34, 1.56, 0.64, 1); position: relative;
        }
        .color-swatch:hover, .bg-swatch:hover { transform: scale(1.3) translateY(-3px); border-color: var(--text-main); box-shadow: 0 8px 20px rgba(0,0,0,0.5); z-index: 10; }
        
        #admin-modal { transition: opacity 0.5s; }
        #admin-login, #admin-dashboard { transition: all 0.7s cubic-bezier(0.34, 1.56, 0.64, 1); transform: perspective(1000px) rotateX(15deg) scale(0.8) translateY(40px); opacity: 0; }
        #admin-modal:not(.hidden) #admin-login, #admin-modal:not(.hidden) #admin-dashboard:not(.hidden) { transform: perspective(1000px) rotateX(0deg) scale(1) translateY(0); opacity: 1; }
        
        #scrollToTopBtn {
            position: fixed; bottom: 90px; right: 25px; z-index: 9998;
            width: 50px; height: 50px; border-radius: 50%;
            background: var(--bg-card-heavy); border: 2px solid var(--color-primary);
            color: var(--color-primary); display: flex; justify-content: center; align-items: center;
            font-size: 1.4rem; cursor: pointer; backdrop-filter: blur(15px);
            box-shadow: 0 0 20px rgba(var(--color-primary-rgb), 0.4);
            opacity: 0; pointer-events: none; transform: translateY(30px) scale(0.7);
            transition: all 0.5s cubic-bezier(0.34, 1.56, 0.64, 1);
        }
        #scrollToTopBtn.show { opacity: 1; pointer-events: auto; transform: translateY(0) scale(1); }
        #scrollToTopBtn.show::before { content: ''; position: absolute; inset: -5px; border-radius: 50%; border: 2px solid var(--color-primary); animation: radar-pulse 1.5s cubic-bezier(0.2, 0.8, 0.2, 1) infinite; opacity: 0; z-index: -1; }
        #scrollToTopBtn:hover { background: var(--color-primary); color: #fff; transform: translateY(-8px) scale(1.2); box-shadow: 0 15px 30px rgba(var(--color-primary-rgb), 0.6); }
        #scrollToTopBtn:active { transform: scale(0.9); }

        .admin-item-card { background: var(--bg-overlay); border: 1px solid var(--border-color); padding: 12px; border-radius: 12px; display: flex; justify-content: space-between; align-items: center; transition: all 0.3s; }
        .admin-item-card:hover { border-color: var(--color-primary); }
    </style>
</head>
