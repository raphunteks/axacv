<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>404 Signal Lost | Axa System</title>
    
    <!-- Favicon -->
    <link rel="icon" type="image/png" href="/axalogo.png">
    <link rel="apple-touch-icon" href="/axalogo.png">
    
    <!-- Library & Fonts -->
    <script src="https://cdn.tailwindcss.com"></script>
    <script src="https://unpkg.com/@phosphor-icons/web"></script>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;700&family=Space+Grotesk:wght@400;700;900&display=swap" rel="stylesheet">
    
    <style>
        /* Base & Neumorphism */
        body { font-family: 'Plus Jakarta Sans', sans-serif; background-color: #030712; color: #fff; overflow: hidden; }
        
        /* Glassmorphism */
        .glass-panel {
            background: rgba(11, 15, 25, 0.6);
            backdrop-filter: blur(24px);
            border: 1px solid rgba(0, 229, 255, 0.2);
            box-shadow: 0 30px 60px rgba(0, 0, 0, 0.8), inset 0 0 30px rgba(0, 229, 255, 0.05);
        }
        
        /* Holographic Border */
        .holo-border { position: relative; }
        .holo-border::before {
            content: ''; position: absolute; inset: -3px; border-radius: inherit; z-index: -1;
            background: linear-gradient(45deg, #00E5FF, #FF10F0, #00E5FF, #FF10F0);
            background-size: 300% 300%; animation: holo-glow 4s linear infinite; filter: blur(10px); opacity: 0.8;
        }
        @keyframes holo-glow { 0% {background-position: 0% 50%} 50% {background-position: 100% 50%} 100% {background-position: 0% 50%} }
        
        /* Brutalism Button */
        .brutal-btn {
            background: #00E5FF; color: #000; font-family: 'Space Grotesk', sans-serif; font-weight: 900;
            border: 2px solid #fff; box-shadow: 6px 6px 0px rgba(255, 16, 240, 0.9); transition: all 0.2s;
            text-transform: uppercase; letter-spacing: 0.1em;
        }
        .brutal-btn:hover { transform: translate(-3px, -3px); box-shadow: 9px 9px 0px rgba(255, 16, 240, 1); }
        .brutal-btn:active { transform: translate(4px, 4px); box-shadow: 0px 0px 0px transparent; }

        /* Glitch 404 Text */
        .glitch-text {
            font-family: 'Space Grotesk', sans-serif;
            font-size: clamp(6rem, 15vw, 10rem);
            font-weight: 900; line-height: 1;
            text-shadow: 5px 5px 0px rgba(0, 229, 255, 0.6), -5px -5px 0px rgba(255, 16, 240, 0.6);
            animation: glitch-anim 3s infinite alternate;
        }

        .bg-grid {
            position: fixed; inset: 0; z-index: -10;
            background-image: radial-gradient(rgba(0, 229, 255, 0.15) 1px, transparent 1px); background-size: 40px 40px;
        }

        /* Floating Animation */
        .float-anim { animation: float 6s ease-in-out infinite; }
        @keyframes float { 0% { transform: translateY(0px); } 50% { transform: translateY(-20px); } 100% { transform: translateY(0px); } }
    </style>
</head>
<body class="flex items-center justify-center min-h-screen relative selection:bg-cyan-500 selection:text-black">
    <!-- Grid Background -->
    <div class="bg-grid"></div>

    <!-- Glowing Orbs (Holographic Ambient) -->
    <div class="absolute top-1/4 left-1/4 w-72 h-72 bg-cyan-500/20 rounded-full blur-[100px] pointer-events-none"></div>
    <div class="absolute bottom-1/4 right-1/4 w-72 h-72 bg-fuchsia-500/20 rounded-full blur-[100px] pointer-events-none"></div>

    <!-- Main Card -->
    <main class="glass-panel holo-border p-8 md:p-16 rounded-[2.5rem] w-full max-w-2xl relative z-10 flex flex-col items-center text-center mx-4 float-anim">
        
        <div class="w-20 h-20 bg-black/50 border border-red-500/30 text-red-500 rounded-2xl flex items-center justify-center mb-4 shadow-[0_0_30px_rgba(239,68,68,0.4)]">
            <i class="ph-fill ph-warning-octagon text-5xl animate-pulse"></i>
        </div>
        
        <!-- Brutalist 404 Heading -->
        <h1 class="glitch-text tracking-tighter text-white mb-2">404</h1>
        
        <h2 class="text-xl md:text-3xl font-black font-['Space_Grotesk'] text-cyan-400 tracking-wide uppercase mb-4">
            Anomaly Detected
        </h2>
        
        <p class="text-gray-400 text-sm md:text-base max-w-md leading-relaxed mb-10 font-medium">
            Sistem gagal melacak rute yang Anda minta. Koordinat URL tidak ditemukan di dalam <strong class="text-white">Knowledge Base Core</strong>. 
        </p>

        <div class="flex flex-col sm:flex-row gap-4 w-full justify-center">
            <button onclick="window.history.back()" class="px-6 py-4 rounded-xl font-black uppercase tracking-widest text-xs md:text-sm text-gray-300 hover:text-white border-2 border-gray-700 hover:border-gray-400 transition-all bg-gray-900/50 flex items-center justify-center gap-2 active:scale-95">
                <i class="ph-bold ph-arrow-left text-lg"></i> Mundur
            </button>
            <a href="/" class="brutal-btn px-8 py-4 rounded-xl text-xs md:text-sm flex items-center justify-center gap-2">
                <i class="ph-bold ph-rocket-launch text-lg"></i> Base Camp
            </a>
        </div>

        <div class="mt-10 pt-6 border-t border-gray-800 w-full text-[10px] md:text-xs font-mono text-gray-500 tracking-widest uppercase flex flex-wrap justify-center gap-4">
            <span class="flex items-center gap-1"><i class="ph-fill ph-shield-check text-green-400"></i> Secure Network</span>
            <span class="flex items-center gap-1"><i class="ph-fill ph-hard-drives text-cyan-400"></i> Axa System Server</span>
        </div>
    </main>
</body>
</html>
